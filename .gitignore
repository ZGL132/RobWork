# =========================================================
# Top-level .gitignore for RobWork workspace
# =========================================================
#
# vcpkg is a third-party dependency cloned from
# https://github.com/microsoft/vcpkg and is not part of this
# repository's own source. Re-clone it on a fresh machine.

# -------------------------------------------------------------
# vcpkg - exclude entirely (re-clone from upstream)
# -------------------------------------------------------------
vcpkg/

# -------------------------------------------------------------
# RobWork - exclude CMake / build artifacts
# -------------------------------------------------------------
RobWork/build/
RobWork/CMakeCache.txt
RobWork/CMakeCache.txt.prev
RobWork/CMakeFiles/
RobWork/cmake_install.cmake
RobWork/Makefile
RobWork/RobWork.cmake
RobWork/CPackConfig.cmake
RobWork/CPackSourceConfig.cmake
RobWork/CMakeSettings.json
RobWork/CMakeLists.txt.user
RobWork/.cmake/
RobWork/.qtc/
RobWork/.qtc_clangd/
RobWork/.qt/
RobWork/.ninja_deps
RobWork/.ninja_log
RobWork/build.ninja
RobWork/Testing/
RobWork/bin/
RobWork/lib/

# Generated Doxygen output
RobWork/doc/apidoc/html/
RobWork/doc/apidoc/xml/
RobWork/doc/apidoc/latex/
RobWork/doc/apidoc/man/
RobWork/doc/Doxyfile

# Debian build artifacts
RobWork/debian/.debhelper/
RobWork/debian/files
RobWork/debian/*.substvars
RobWork/debian/*.debhelper.log
RobWork/debian/autoreconf.*
RobWork/debian/debhelper-build-stamp
RobWork/debian/debian-binary
RobWork/debian/*.deb

# -------------------------------------------------------------
# IDE / Editor user-specific files
# -------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.user
*.userosscache
*.suo
*.sln.docstates
CMakeUserPresets.json

# Qt Creator
*.autosave
*.qmlproject.user
.qt_for_python

# Visual Studio
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
*.pdb
*.ilk
*.obj
*.pch
*.exp
*.lib
*.log
*.tlog

# -------------------------------------------------------------
# OS / misc
# -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.tmp
*.bak
*.old
*.orig
*.rej

# Python
__pycache__/
*.pyc
*.pyo
.venv/
pythonenv*/

# -------------------------------------------------------------
# Test / runtime artifacts
# -------------------------------------------------------------
*testfile.bin
*testfile.ini
*rwsettings.xml
.tpath.rwplay
.spath.rwplay
serialdev-out.txt
*.rwplay

# -------------------------------------------------------------
# Root-level build output (product build tree)
# -------------------------------------------------------------
build/

# Pipeline/acceptance smoke build trees (governance acceptance leftovers; PIPE v1.3 guard exemption expects these ignored)
build-acc-smoke/
*-smoke/

# Testkit RecordListener runtime artifact: the listener writes ird-test-report.json
# to its working directory by default; a tick running tests with CWD=repo root leaves
# it at the root (root-anchored ignore only — evidence copies under traceability/**/
# are explicitly tracked, see AGENTS §4.2 / PIPE §5 留痕纪律).
/ird-test-report.json

# -------------------------------------------------------------
# 留痕日志负向豁免（F-010/F-223 家族根治，治理提交 2026-09-22）
# -------------------------------------------------------------
# AGENTS §4.2 要求验证留痕（构建/门禁/测试运行日志）入库于 traceability/**，
# 而上方第 87 行全局 `*.log` 规则会把它们吞掉——实施侧未察觉即造成
# "提交正文声称有日志、实际未入库"（该根因已九连踩：F-010→F-081→…→F-287，
# 其中四次升级为验收 fail 阻断项，见 findings.json F-223 结构性冲突登记）。
# 本负向豁免＝F-223 处置选项①落地：留痕目录天然免疫全局规则，
# 实施侧不再依赖 git add -f 人工补证。规则置于 `*.log` 之后（git 后规则覆盖前规则）。
!RobWork/doc/industrial-robot-design/traceability/**/*.log

# -------------------------------------------------------------
# 冒烟模式临时构建树（补齐 `*-smoke/` 未盖住的形态）
# -------------------------------------------------------------
# 独立冒烟验证（AGENTS §4.1）按 build-smoke-wp<nn>-t<kk> 命名临时构建目录，
# 属可随时重建的纯构建产物（PIPE §3.1 构建产物豁免口径期待其被 .gitignore 覆盖）；
# 既有 `*-smoke/` 规则只匹配以 -smoke 结尾的目录，此处补齐 build-smoke- 前缀形态。
build-smoke-*/

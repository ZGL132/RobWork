      "input": "encodeHelloAck({accepted=true, heartbeatIntervalMs=5000, reason=\"\"})"
    },
    {
      "caseId": "helloack-reject-max",
      "input": "encodeHelloAck({accepted=false, heartbeatIntervalMs=0xFFFFFFFF, reason 非空})——u32 定宽上边界"

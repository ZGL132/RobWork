    {
      "caseId": "resultbatch-empty",
      "input": "encodeResultBatch({batchIndex=1, bytes=空})——空字节段"
    },
    {
      "caseId": "resultbatch-max",
      "input": "encodeResultBatch({batchIndex=2^64-1, bytes={00,FF}})"

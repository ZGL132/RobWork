    {
      "caseId": "progress-zero",
      "input": "encodeProgress(ProgressReport::make(0,\"compile\",0,0))——percent 下界＋计数 0"
    },
    {
      "caseId": "progress-max",
      "input": "encodeProgress(ProgressReport::make(100,\"optimize\",2^64-1,2^64-1))——percent 上界＋u64 计数上边界"

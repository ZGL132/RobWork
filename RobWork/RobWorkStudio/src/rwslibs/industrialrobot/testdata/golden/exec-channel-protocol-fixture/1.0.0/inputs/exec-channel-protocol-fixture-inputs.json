  "inputFileRole": "用例语义描述符——caseId 与 expected 输出逐条对应；输入构造细节（固定种子 id/摘要派生、字段值）见 parameters.captureHarness 与 traceability/reuse/REUSE-T58/README.md 的 harness 源码登记",
  "cases": [
    {
      "caseId": "id-block-normal",
      "input": "五元组固定种子派生（prj-A/brn-A/rev-1/run-1，attempt=1）——encodeIdentityBlock 168 字节定长域＋decodeIdentityBlock 往返"
    },
    {
      "caseId": "id-block-attempt-max",
      "input": "attempt=2^64-1（\"att-<20位十进制>\"恰 24 字节填满定宽域、无终止 NUL）——定宽域溢出边界：编码成功而 decodeIdentityBlock 按\"填满无终止 NUL\"编码纪律拒绝（decodeRoundtrip=false 为现网实现的既定边界行为，换核须逐位保持）"
    },
    {
      "caseId": "frame-hello-normal",
      "input": "encodeFrame：Hello 帧 seq=1 flags=0，载荷=encodeHello({1, manifestDigestHex(\"evaluator|1|1\\nworkers|1|1\\n\")})"
    },
    {
      "caseId": "frame-empty-payload",
      "input": "encodeFrame：Heartbeat 帧 seq=2 空载荷（阶段 A 无载荷编解码对的类型）——空载荷边界"
    },
    {
      "caseId": "frame-seq-max",
      "input": "encodeFrame：ResultBatch 帧 seq=2^64-1、批次号 2^64-1、载荷 {00 FF 7F 80}——u64 定宽上边界＋字节位模式"
    },
    {
      "caseId": "frame-flags-more",
      "input": "encodeFrame：DispatchRequest 帧 flags=kFlagFragmentMore(0x01) seq=3 载荷 {DE AD BE EF}"
    },
    {
      "caseId": "hello-normal",
      "input": "encodeHello({protoVersion=1, 64hex 摘要})"
    },
    {

<?xml version="1.0"?>
<robot name="golden arm">
  <material name="gray"/>
  <gazebo><plugin name="fake"/></gazebo>
  <transmission><joint name="j1"/><mechanicalReduction>1</mechanicalReduction></transmission>
  <disable_collisions link1="base" link2="l1"/>
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/ghost.dae"/></geometry>
    </visual>
  </link>
  <link name="l1">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.02" izz="0.03" ixy="0.002" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><mesh filename="meshes/l1.stl"/></geometry>
      <material name="steel_gray"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/l1.stl" scale="2 1 1"/></geometry>
    </collision>
  </link>
  <link name="l2">
    <visual>
      <geometry><mesh filename="package://pkg/meshes/l2.stl"/></geometry>
    </visual>
  </link>
  <link name="l3"/>
  <link name="l4"/>
  <link name="l5"/>
  <link name="l6"/>
  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="l1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 2 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="l1"/>
    <child link="l2"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="40" velocity="2.0"/>
  </joint>
  <joint name="j3" type="revolute">
    <parent link="l2"/>
    <child link="l3"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="j4" type="revolute">
    <parent link="l3"/>
    <child link="l4"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="30" velocity="1.5"/>
  </joint>
  <joint name="j5" type="revolute">
    <parent link="l4"/>
    <child link="l5"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.0" effort="20" velocity="1.5"/>
  </joint>
  <joint name="j6" type="revolute">
    <parent link="l5"/>
    <child link="l6"/>
    <origin xyz="0.05 0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="15" velocity="2.0"/>
  </joint>
</robot>

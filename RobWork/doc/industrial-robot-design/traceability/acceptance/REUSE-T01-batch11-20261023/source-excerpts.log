dynamics.PowerEnergy.PowerEnergyCalculator.compute
60: // compute（公共头契约的实现——单遍扫描＋逐关节分项积分）。
61: // =====================================================================
62: 
63: PowerEnergySummary PowerEnergyCalculator::compute(const DynamicsSeries& series) const
64: {
65:     // ---- 第 1 步：按关节分组 Ok 行并单遍推进累加链（NFR-COR-03：非
66:     //      Ok 行不进积分；关节集合升序——输出行序稳定）----
67:     std::vector<std::uint32_t> jointIds;        ///< 出现的关节集合（升序——输出序）
68:     std::vector<JointAccumulator> accs;         ///< 与 jointIds 平行的累加链
69:     for (std::size_t k = 0; k < series.samples.size(); ++k) {
70:         const DynamicsSample& r = series.samples[k];
71:         if (r.numericState != SampleNumericState::Ok) {
72:             // 非 Ok 行（NonFiniteInput/Output/Overflow）不进积分；但它是
73:             // 该关节的"缺口证据"——其所在关节若已有累加链，须标记"上一
74:             // Ok 行之后出现缺口"（缺口区间零贡献，公共头契约"缺口不插
75:             // 值、贡献 0"——audit F-589 修复；尚无累加链的关节无须标记：
76:             // 其首个 Ok 行只是积分下界，下界之前的区间本就不积分）。
77:             const auto it = std::lower_bound(jointIds.begin(), jointIds.end(), r.jointIndex);
78:             if (it != jointIds.end() && *it == r.jointIndex) {
79:                 accs[static_cast<std::size_t>(it - jointIds.begin())].gapSincePrevOk = true;
80:             }
81:             continue;
82:         }
83:         const std::uint32_t j = r.jointIndex;
84:         auto it = std::lower_bound(jointIds.begin(), jointIds.end(), j);
85:         if (it == jointIds.end() || *it != j) {
86:             it = jointIds.insert(it, j);
87:             accs.insert(accs.begin() + (it - jointIds.begin()), JointAccumulator{});
88:         }
89:         JointAccumulator& a = accs[static_cast<std::size_t>(it - jointIds.begin())];
90:         a.rows.push_back(k);
91: 
92:         // 功率（W）——评估器已按 P=τ_total·q̇ 产出（§7.5）；本计算器
93:         // 直读不重乘（重乘需要 τ_total×q̇ 两次舍入一致——行内值即权威）。
94:         const double p = r.mechanicalPower;
95: 
96:         // 时间加权分项积分（§7.5）：E⁺ 用 max(P,0)、E⁻ 用 min(P,0)
97:         // 分别梯形——正负功拆分的数学形态（ crest 因子：同一区间 P 换
98:         // 号时两侧各取其半段贡献）。缺口区间例外：上一 Ok 行与当前 Ok
99:         // 行之间存在本关节非 Ok 行时，该区间零贡献（无数据不插值——
100:         // 假设 P 线性过渡属高估；缺口时长仍保留在分母 T_cycle 中，
101:         // 保守低估，完整循环统计以 Complete 序列为准）。
102:         if (!a.havePrev) {
103:             a.firstT = r.t;      // 积分下界（首有效行）
104:             a.havePrev = true;
105:         } else if (a.gapSincePrevOk) {
106:             // 缺口区间——E⁺/E⁻ 均不加梯形项（零贡献），只推进梯形状态。
107:         } else {
108:             const double dt = r.t - a.lastT;  // s（相邻有效行时差——正常采样区间）
109:             a.positiveJ += 0.5 * (std::max(a.prevP, 0.0) + std::max(p, 0.0)) * dt;
110:             a.negativeJ += 0.5 * (std::min(a.prevP, 0.0) + std::min(p, 0.0)) * dt;
111:         }
112:         a.prevP = p;
113:         a.lastT = r.t;
114:         a.gapSincePrevOk = false;  // 缺口证据已消费（首个 Ok 行亦在此清除）
115: 
116:         // 功率幅值峰值（首个达到者保留——严格大于才替换，确定性口径；
117:         // 首行无条件捕获：NaN 位模式经此显性传播到峰值输出，不静默）。
118:         const double absP = std::abs(p);
119:         if (!a.havePeak || absP > a.peakAbsW) {
120:             a.havePeak = true;
121:             a.peakAbsW = absP;
122:             a.peakRow = k;
123:         }
124:     }
125: 
126:     // ---- 第 2 步：装配摘要（无效语义显式 NaN——不伪造 0，§4.6）----
127:     PowerEnergySummary out;
128:     out.joints.reserve(accs.size());
129:     bool topLevelSet = false;   ///< 顶层字段就绪位（首个可积分关节定标——见下）
130:     for (JointAccumulator& a : accs) {
131:         PowerEnergySummary::JointPowerEnergy row;
132:         row.jointIndex = jointIds[&a - accs.data()];
133: 
134:         // 时间参数可用性（逐关节判定——单序列单时间轴，正常路径各关
135:         // 节一致；行级 Ok 标记差异时以"首个可积分关节"定标顶层字段）。
136:         const bool timeOk = a.rows.size() >= 2 && a.firstT != a.lastT;
137:         row.positiveEnergyJ = timeOk ? a.positiveJ
138:                                      : std::numeric_limits<double>::quiet_NaN();
139:         row.negativeEnergyJ = timeOk ? a.negativeJ
140:                                      : std::numeric_limits<double>::quiet_NaN();
141:         row.netEnergyJ = timeOk ? (a.positiveJ + a.negativeJ)
142:                                 : std::numeric_limits<double>::quiet_NaN();
143:         const double cycleS = a.lastT - a.firstT;   // T_cycle（s；含驻留全程）
144:         row.meanPowerW = timeOk ? (row.netEnergyJ / cycleS)
145:                                 : std::numeric_limits<double>::quiet_NaN();
146: 
147:         // 功率峰值（含窗与段）：等值 run 在该关节时间序上扩展（同
148:         // Envelope 口径——位等值无阈值；幅值并列取时间轴首个）。
149:         const DynamicsSample& peakRow = series.samples[a.peakRow];
150:         const std::size_t pos = static_cast<std::size_t>(
151:             std::find(a.rows.begin(), a.rows.end(), a.peakRow) - a.rows.begin());
152:         std::size_t lo = pos;
153:         std::size_t hi = pos;
154:         auto equalAt = [&](std::size_t rowsPos) {
155:             return std::abs(series.samples[a.rows[rowsPos]].mechanicalPower)
156:                    == a.peakAbsW;  // 幅值位等值——无容差（D-DYN-8）
157:         };
158:         while (lo > 0 && equalAt(lo - 1)) { --lo; }
159:         while (hi + 1 < a.rows.size() && equalAt(hi + 1)) { ++hi; }
160:         row.powerPeak.value = a.peakAbsW;                       // W（幅值形态）
161:         row.powerPeak.tPeakS = peakRow.t;                       // s
162:         row.powerPeak.segmentIndex = peakRow.segmentIndex;      // 所在轨迹段
163:         row.powerPeak.windowStartS = series.samples[a.rows[lo]].t;  // 窗起点，s
164:         row.powerPeak.windowEndS = series.samples[a.rows[hi]].t;    // 窗终点，s
165:         row.powerPeak.conditionId = series.conditionId;         // 来源工况
166: 
167:         // 循环时长与驻留计入位（顶层字段＝序列级；由首个可积分关节
168:         // 定标——时间可用即积分已按 [t₀,t_N] 全程执行，上游含驻留段
169:         // 即自动计入；统计器无段类型信息、不做速度阈值判定）。
170:         if (!topLevelSet && timeOk) {
171:             out.timeParamAvailable = true;
172:             out.cycleDurationS = cycleS;
173:             out.includesDwell = true;
174:             topLevelSet = true;
175:         }
176:         out.joints.push_back(std::move(row));
177:     }
178:     if (!topLevelSet) {
179:         // 无任何可积分关节（空序列/单样本/零跨度）——顶层字段显式无效
180:         //（NotProvided 语义，不伪造 0；§4.6"无时间参数"行同口径）。
181:         out.timeParamAvailable = false;
182:         out.cycleDurationS = std::numeric_limits<double>::quiet_NaN();
183:         out.includesDwell = false;
184:     }
185:     return out;
186: }
187: 
188: }  // namespace sdurws::ird::dynamics

kinematics.Envelope.probeSeedFor
60: /// (seed, probeSerial) 经 streamSeedFor 完整 64 位混合（A06——probeSerial
61: /// 是全计算单调计数，天然覆盖方向/站点/二分三维序），输出直接作为该
62: /// 探针的 makeInitialValues 种子。
63: std::uint64_t probeSeedFor(std::uint64_t seed, std::uint64_t probeSerial)
64: {
65:     return streamSeedFor(seed, probeSerial);
66: }
67: 
68: /// 调用方契约违约 fail-fast（§9.1——std::invalid_argument，不进结果对象）。
69: [[noreturn]] void failCaller(const std::string& what)

kinematics.Envelope.failCaller
66: }

343: // 内部辅助——路径采样与 PathSequence 复核（§10.3 直连/候选共用通道）

trajectory.Planner.sampleStraightPath
357:     std::vector<double> pathParameters;       ///< 逐样本 s∈[0,1]（等长）
358: };
359: 
360: SampledPath sampleStraightPath(const rw::math::Q& fromQ, const rw::math::Q& toQ,
361:                                double resolution)
362: {
363:     // 欧氏长度（逐轴混合计量 rad|m——与规划器度量同源口径，§6.4）。
364:     double length = 0.0;
365:     for (std::size_t i = 0; i < fromQ.size(); ++i) {
366:         const double delta = toQ[i] - fromQ[i];
367:         length += delta * delta;
368:     }
369:     length = std::sqrt(length);
370:     // 分段数＝ceil(长度/分辨率)，下限 1（零长/极短段至少 1 段——样本数
371:     // ≥2，端点必含）；上限防病态小分辨率把样本数撑爆（分辨率来自显式
372:     // 配置，调用方对采样规模负责；此处仅防溢出级灾难）。
373:     const double segmentCountReal = std::ceil(length / resolution);
374:     const auto segmentCount = static_cast<std::size_t>(
375:         std::min(std::max(segmentCountReal, 1.0), 1.0e6));
376:     SampledPath sampled;
377:     sampled.configurations.reserve(segmentCount + 1);
378:     sampled.pathParameters.reserve(segmentCount + 1);
379:     for (std::size_t i = 0; i <= segmentCount; ++i) {
380:         const double s = static_cast<double>(i) / static_cast<double>(segmentCount);
381:         // 关节空间逐轴线性插值（§7.3 同一几何语义——复用 interpolateJoint-
382:         // Linear 保证"同语义同一实现点"；s∈[0,1] 由构造保证不越界）。
383:         sampled.configurations.push_back(interpolateJointLinear(fromQ, toQ, s));
384:         sampled.pathParameters.push_back(s);
385:     }
386:     return sampled;
387: }

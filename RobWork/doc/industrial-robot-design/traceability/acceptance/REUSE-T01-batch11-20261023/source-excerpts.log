464: // =====================================================================
465: // 内部辅助——稳定选择序四键（§10.4"延续性→裕量→路径长度→候选序号"）

trajectory.Planner.maxAdjacentStep
466: // =====================================================================
467: 
468: /// 相邻路点逐轴最大 |Δq|（延续性键——步进越平缓越好，升序；rad|m）。
469: double maxAdjacentStep(const std::vector<rw::math::Q>& configurations)
470: {
471:     double maxStep = 0.0;
472:     for (std::size_t i = 1; i < configurations.size(); ++i) {
473:         for (std::size_t j = 0; j < configurations[i].size(); ++j) {
474:             maxStep = std::max(maxStep, std::abs(configurations[i][j] - configurations[i - 1][j]));
475:         }
476:     }
477:     return maxStep;
478: }
479: 
480: /// 关节空间路径长度 Σ|Δq|（路径长度键——升序；rad|m 逐轴混合计量）。
481: double pathJointLength(const std::vector<rw::math::Q>& configurations)

trajectory.Planner.pathJointLength
478: }
479: 
480: /// 关节空间路径长度 Σ|Δq|（路径长度键——升序；rad|m 逐轴混合计量）。
481: double pathJointLength(const std::vector<rw::math::Q>& configurations)
482: {
483:     double length = 0.0;
484:     for (std::size_t i = 1; i < configurations.size(); ++i) {
485:         for (std::size_t j = 0; j < configurations[i].size(); ++j) {
486:             length += std::abs(configurations[i][j] - configurations[i - 1][j]);
487:         }
488:     }
489:     return length;
490: }
491: 
492: /// 候选最小归一化关节裕量（裕量键——降序；有界轴 margin=2·min(q−lo, hi−q)/
493: /// (hi−lo)∈[0,1]，无界轴跳过；全无界＝+∞ 取最大——D-KIN-6 同源口径）。

trajectory.Planner.minNormalizedMargin
491: 
492: /// 候选最小归一化关节裕量（裕量键——降序；有界轴 margin=2·min(q−lo, hi−q)/
493: /// (hi−lo)∈[0,1]，无界轴跳过；全无界＝+∞ 取最大——D-KIN-6 同源口径）。
494: double minNormalizedMargin(const std::vector<rw::math::Q>& configurations,
495:                            const rw::math::Q& lowerBoundQ, const rw::math::Q& upperBoundQ)
496: {
497:     double minimum = std::numeric_limits<double>::infinity();
498:     for (const rw::math::Q& q : configurations) {
499:         for (std::size_t j = 0; j < q.size(); ++j) {
500:             const double range = upperBoundQ[j] - lowerBoundQ[j];
501:             if (!(range > 0.0) || !std::isfinite(range)) {
502:                 continue;  // 无界/退化轴不参与（全无界时 minimum 保持 +∞）
503:             }
504:             const double margin =
505:                 2.0 * std::min(q[j] - lowerBoundQ[j], upperBoundQ[j] - q[j]) / range;
506:             minimum = std::min(minimum, margin);
507:         }
508:     }
509:     return minimum;
510: }
511: 
512: /**
513:  * @brief 候选选择序严格弱序（四键全序——见 makePathPlannerAdapter

trajectory.Planner.candidatePreferred
513:  * @brief 候选选择序严格弱序（四键全序——见 makePathPlannerAdapter
514:  *        实现注；NFR-COR-02 全序可复现）。
515:  */
516: bool candidatePreferred(const PathCandidate& lhs, const PathCandidate& rhs,
517:                         const rw::math::Q& lowerBoundQ, const rw::math::Q& upperBoundQ)
518: {
519:     // 键 1 延续性：maxAdjacentStep 升序。
520:     const double stepL = maxAdjacentStep(lhs.configurations);
521:     const double stepR = maxAdjacentStep(rhs.configurations);
522:     if (stepL != stepR) { return stepL < stepR; }
523:     // 键 2 裕量：minNormalizedMargin 降序（+∞ 优先）。
524:     const double marginL = minNormalizedMargin(lhs.configurations, lowerBoundQ, upperBoundQ);
525:     const double marginR = minNormalizedMargin(rhs.configurations, lowerBoundQ, upperBoundQ);
526:     if (marginL != marginR) { return marginL > marginR; }
527:     // 键 3 路径长度：升序。
528:     const double lengthL = pathJointLength(lhs.configurations);
529:     const double lengthR = pathJointLength(rhs.configurations);
530:     if (lengthL != lengthR) { return lengthL < lengthR; }
531:     // 键 4 候选序号：升序兜底（全序保证）。
532:     return lhs.candidateIndex < rhs.candidateIndex;
533: }

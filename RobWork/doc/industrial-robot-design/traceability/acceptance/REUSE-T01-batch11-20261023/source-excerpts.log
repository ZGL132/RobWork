74: // =====================================================================
75: // 位置存在性探针（§7.2 存在性口径的射线版——"存在 ≥1 有效解即达"）

kinematics.Envelope.probeReachability
124:  *
125:  * 纯函数（除两个计数器推进）；确定性（同序号同初值集——NFR-COR-01）。
126:  */
127: ProbeVerdict probeReachability(double t,
128:                                const rw::math::Vector3D<double>& direction,
129:                                const IKinRuntimeView& view,
130:                                const TcpRef& tcp,
131:                                const EnvelopeQuery& query,
132:                                const std::vector<JointInterval>& intervals,
133:                                std::uint64_t& probeSerial,
134:                                std::uint32_t& rayProbeCount,
135:                                IkFacilityFailure* facilityOut)
136: {
137:     // 探针级取消检查（响应粒度第一层——每探针至少一次，§8.3 落值；
138:     // 求解器内部的迭代级查询是第二层，经 cancellationProbe 透传生效）。
139:     // 命中即返回且**不计数**——零 IK 调用，预算素材不虚增。
140:     if (query.cancellationProbe && query.cancellationProbe()) {
141:         return ProbeVerdict::Cancelled;
142:     }
143: 
144:     // 初值集（确定性——本探针的序号派生种子；SeededRandom 下多初值
145:     // 提升边界附近〔雅可比趋奇异〕的收敛稳健性）。
146:     const std::vector<std::vector<double>> initialValues = makeInitialValues(
147:         query.initialStrategy, query.initialValuesCount,
148:         probeSeedFor(query.seed, probeSerial), intervals, query.referenceQ);
149:     ++probeSerial;    // 全局序号推进（与本次 IK 调用一一对应）
150:     ++rayProbeCount;  // 方向面计数同步（守恒式右端/左端同步推进）
151: 
152:     // IK 请求（位置存在性——KIN-P2/A02 起 taskSpace=PositionOnly：3 维
153:     // 任务子空间，姿态误差不进目标函数，收敛判据只查位置残差；姿态容差
154:     // 在该任务下不被消费，保持 IkRequest 默认合法值（1e-6 rad>0——请求
155:     // 合法域载体；EnvelopeQuery 投影面刻意不含姿态容差字段——"不预建无
156:     // 消费者条目"纪律，与旧 π 落值常量的裁剪同因）。旧"姿态无约束落值
157:     // π"机制废除——kEnvelopePoseFreeTolerance 已随本迁移移除，π 方案下
158:     // 姿态仍参与 6 维迭代会把位置可达探针点牵制出局〔审查 A02 同源〕。
159:     // 身份面回填调用方绑定）。
160:     IkRequest request;
161:     request.targetInBase = rw::math::Transform3D<double>(
162:         direction * t, rw::math::Rotation3D<double>(1, 0, 0, 0, 1, 0, 0, 0, 1));
163:     request.positionTolerance = query.positionTolerance;
164:     request.taskSpace = IkTaskSpace::PositionOnly;
165:     request.modelView = &view;
166:     request.tcp = tcp;
167:     request.initialValues = initialValues;
168:     request.iterationLimit = query.iterationLimit;
169:     request.intervals = intervals;
170:     request.dedupThresholdPerAxis = query.dedupThresholdPerAxis;
171:     request.collisionSession = nullptr;  // KIN-10 无碰撞要求（Query 注）——
172:                                          // 求解器按"未启用"跳过硬过滤③
173:     request.cancellationProbe = query.cancellationProbe;
174:     request.referenceQ = query.referenceQ;
175:     // 结果绑定（纯服务直调面——pointOid 保留值合法；身份 seed/referenceQ
176:     // 已由调用方经 query.identity 回填一致性由组装面保证）。
177:     request.requestIdentity = query.identity;
178:     request.requestIdentity.seed = query.seed;
179:     request.requestIdentity.referenceQ = query.referenceQ;
180: 
181:     const IkOutcome outcome = query.solver ? query.solver->solve(request)
182:                                            : IkSolver{}.solve(request);
183: 
184:     // 判读（按序——cancelled/设施失败优先，非终局形态上调）。
185:     if (outcome.cancelled) {
186:         return ProbeVerdict::Cancelled;
187:     }
188:     if (outcome.facilityFailure.has_value()) {
189:         // 素材转载（不加工——底层 stage/detail 逐字上交，诊断链溯源保留
190:         // 求解器侧定位；Sampling.cpp 设施失败 reason 转载 detail 同款）。
191:         if (facilityOut != nullptr) {
192:             *facilityOut = *outcome.facilityFailure;
193:         }
194:         return ProbeVerdict::Facility;
195:     }
196:     switch (outcome.outcomeKind) {
197:     case IkOutcomeKind::SolutionsFound:
198:     case IkOutcomeKind::PartialCollision:
199:         return ProbeVerdict::Reached;
200:     case IkOutcomeKind::MultiInitNoConvergence:
201:     case IkOutcomeKind::AllCandidatesFiltered:
202:     case IkOutcomeKind::AnalyticBoundExceeded:
203:         // 2/3＝搜索未果（近似根源 2——当"不可达侧"使用）；5＝解析界限
204:         // 超界，理论上仅在 ‖t·d‖>Rup 时出现，而本算法恒在 [0,Rup] 内
205:         // 探测——若出现（数值边界）同轨按"不可达侧"处置，注释如实。
206:         return ProbeVerdict::NotFound;
207:     }
208:     return ProbeVerdict::NotFound;  // 恒不可达（switch 全枚举兜底——编译器告警面）
209: }
210: 
211: }  // namespace
212: 

kinematics.Envelope.computeApproximateEnvelope
214: // computeApproximateEnvelope——主流程（头注算法四步的落值）
215: // =====================================================================
216: 
217: Expected<EnvelopeResult> computeApproximateEnvelope(const IKinRuntimeView& view,
218:                                                     const TcpRef& tcp,
219:                                                     const EnvelopeQuery& query)
220: {
221:     // ---- 第 0 步：装配校验（fail-fast 轨——调用方错误，不进结果对象；
222:     // 逐项独立可辨——消息定位字段，NFR-COR-03 拒绝不钳制）。----
223:     // 设备自由度（可动关节链序——validateRegionCoverageQuery 同口径）。
224:     std::size_t dof = 0;
225:     for (const auto& j : view.model().chain().joints) {
226:         if (j.type != runtime::JointType::Fixed) {
227:             ++dof;
228:         }
229:     }
230:     if (query.directionCount == 0U) {
231:         failCaller("query.directionCount=0（方向数须 ≥1——KIN-10 默认 "
232:                    "180）");
233:     }
234:     if (query.anchorProbesMax == 0U) {
235:         failCaller("query.anchorProbesMax=0（内锚点探测步数须 ≥1）");
236:     }
237:     if (query.bisectIterationsMax == 0U) {
238:         failCaller("query.bisectIterationsMax=0（二分迭代上限须 ≥1）");
239:     }
240:     if (query.seed == 0U) {
241:         failCaller("query.seed=0（I-KIN-4：拒绝，不做 0→1 静默替换——"
242:                    "NFR-COR-03；探针初值序列的唯一来源）");
243:     }
244:     if (query.initialValuesCount == 0U) {
245:         failCaller("query.initialValuesCount=0（初值数量须 ≥1）");
246:     }
247:     if (query.iterationLimit == 0U) {
248:         failCaller("query.iterationLimit=0（迭代上限须 ≥1）");
249:     }
250:     if (!std::isfinite(query.positionTolerance) || query.positionTolerance <= 0.0) {
251:         failCaller("query.positionTolerance 非法（须有限且>0，单位 m）");
252:     }
253:     if (!std::isfinite(query.dedupThresholdPerAxis)
254:         || query.dedupThresholdPerAxis <= 0.0) {
255:         failCaller("query.dedupThresholdPerAxis 非法（须有限且>0，rad|m "
256:                    "逐轴）");
257:     }
258:     if (query.referenceQ.size() != dof) {
259:         failCaller("query.referenceQ 维度 " + std::to_string(query.referenceQ.size())
260:                    + " != 设备自由度 " + std::to_string(dof)
261:                    + "（D-KIN-4 显式输入契约）");
262:     }
263:     for (std::size_t k = 0; k < query.referenceQ.size(); ++k) {
264:         if (!std::isfinite(query.referenceQ[k])) {
265:             failCaller("query.referenceQ[" + std::to_string(k)
266:                        + "] 非有限（NFR-COR-03：不置零）");
267:         }
268:     }
269: 
270:     // ---- 第 1 步：解析外括号（确定性上界——三角形不等式覆盖全部关节
271:     // 角；NoDevice/NoTcp/FrameUnresolved 走 Expected 值面，环境/快照
272:     // 事实不属调用方违约）。----
273:     const Expected<AnalyticReachBound> bound =
274:         computeAnalyticReachBound(view, tcp);
275:     if (!bound.ok()) {
276:         return Expected<EnvelopeResult>::err(bound.error());
277:     }
278:     const double reachUpper = bound.get().totalRadius;  // m（Rup——外括号）
279: 
280:     // ---- 结果骨架（恒近似标注——KIN-10/AT-26 的类型化落点；身份回填
281:     // 中 seed/referenceQ 由实现从 query 覆写——防调用方两处不一致）。----
282:     EnvelopeResult result;
283:     result.precision = EnvelopePrecision::Approximate;
284:     result.contractVersion = kEnvelopeContractVersion;
285:     result.directionCount = query.directionCount;
286:     result.reachUpperBound = reachUpper;
287:     result.identity = query.identity;
288:     result.identity.seed = query.seed;
289:     result.identity.referenceQ = query.referenceQ;
290: 
291:     // 方向集（§7.2 黄金设施复用——斐波那契螺旋，黄金锁定；与 seed 无关
292:     // ——方向离散是配置参数不是随机量）。
293:     const std::vector<rw::math::Vector3D<double>> directions =
294:         generateDirections(query.directionCount);
295: 
296:     // 逐自由度评价区间（evaluationIntervals 唯一实现点——初值生成与
297:     // 限位评价同源，防两套真值；每计算一次，逐探针复用）。
298:     const std::vector<JointInterval> intervals = evaluationIntervals(view);
299: 
300:     // 射线记录预置（方向生成序；NotRun 初值——取消/设施失败路径的
301:     // 未开始方向即此初值的自然保留，RegionCoverage 槽位预置同款）。
302:     result.rays.resize(query.directionCount);
303:     for (std::uint32_t j = 0; j < query.directionCount; ++j) {
304:         result.rays[j].directionIndex = j;
305:         result.rays[j].direction = directions[j];
306:     }
307: 
308:     // ---- 第 2 步：入口取消检查（取消已请求→零探测返回；全部方向
309:     // NotRun——D-KIN-9 取消不是结局，partial 如实标记）。----
310:     if (query.cancellationProbe && query.cancellationProbe()) {
311:         result.cancelled = true;
312:         for (EnvelopeRayRecord& ray : result.rays) {
313:             ray.reason = "协作取消（入口检查——零探测返回；重跑同 seed 可复算）";
314:         }
315:         return Expected<EnvelopeResult>::ok(std::move(result));
316:     }
317: 
318:     // ---- 第 3 步：逐方向射线边界（等差径向站点扫描＋外端区间二分
319:     // 收敛——头注算法 2/3/4 步，KIN-P5/审查 A04 重构版；单线程顺序执行，
320:     // 方向序＝生成序）。----
321:     //
322:     // 旧算法（内锚点几何序列 Rup·2⁻ᵏ＋hi=Rup 免探测）的两处缺陷（审查
323:     // A04 反例驱动）：
324:     //   ①上界点被当作"已证不可达"免探测——错误表述：三角形不等式取等
325:     //     时（共线串联）上界点恰可达（六轴同轴链 TCP 距轴 1 m 的零位
326:     //     构型精确到达 (1,0,0)），旧算法对这类方向系统性漏检整条射线；
327:     //   ②几何序列在原点邻域过密、在 (Rup/2, Rup] 只有一个探测点——
328:     //     窄环带（如 [0.4,0.5]·Rup）落在探测缝隙里即全灭，且全灭被并入
329:     //     Computed 态输出 rMax=0 的"确定结论"，掩盖"没有找到"的事实。
330:     // 新算法把预算改为 M＝anchorProbesMax 个等差站点 t_j＝Rup·j/M
331:     // （分辨率 Rup/M 显式承载窄带检测能力），由外向内扫描——首个可达
332:     // 站即外边界区间的内端（外端＝其外一站点，已探明不可达），二分只
333:     // 收敛这一个区间；站点全灭→NoSampleFound 低置信态（诚实"未找到"）。
334:     std::uint64_t probeSerial = 0;   // 全局探针单调计数（种子派生输入）
335:     bool stopAll = false;            // 取消/设施失败后的全局停止旗标
336:     IkFacilityFailure facility;      // 设施失败素材（转载自底层求解 outcome）
337: 
338:     for (std::uint32_t j = 0; j < query.directionCount && !stopAll; ++j) {
339:         EnvelopeRayRecord& ray = result.rays[j];
340: 
341:         // ---- 3a. 等差站点扫描（由外向内；多锚点——上界点先行试探）。
342:         // 扫描至首个可达站即止：其外站点已探明不可达（外端 hi 来源）、
343:         // 其内站点不影响外边界下估计（内岛/空腔属近似根源 3 的登记边界
344:         // ——本算法只承诺外边界）。----
345:         bool anchored = false;       // 是否找到可达站
346:         double lo = 0.0;             // 已证实可达的最远距离（m——外端区间内端）
347:         double hi = 0.0;             // 外端区间外端（m——首个可达站外一站点；可达站为上界点时无语义）
348:         for (std::uint32_t jj = query.anchorProbesMax; jj >= 1U; --jj) {
349:             // 站点距离（m）：t＝Rup·jj/M——jj=M 即上界点 Rup（先行试探：
350:             // 上界可可达——审查 A04 措辞修正的落点），jj=1 即最近原点站。
351:             const double t = reachUpper * (static_cast<double>(jj)
352:                 / static_cast<double>(query.anchorProbesMax));
353:             if (t < kAnchorMinDistance) {
354:                 // 浮点下限防护：更内侧站点只会更小——直接终止内扫。
355:                 break;
356:             }
357:             const ProbeVerdict verdict =
358:                 probeReachability(t, directions[j], view, tcp, query,
359:                                   intervals, probeSerial, ray.probeCount,
360:                                   &facility);
361:             if (verdict == ProbeVerdict::Reached) {
362:                 lo = t;
363:                 anchored = true;
364:                 break;  // 首个（最外侧）可达站——内扫即止
365:             }
366:             if (verdict == ProbeVerdict::Cancelled) {
367:                 // 取消传播（D-KIN-9）：本方向标记后停止全部后续方向。
368:                 ray.state = EnvelopeRayState::NotRun;
369:                 ray.reason = "协作取消（径向站点扫描中断）";
370:                 result.cancelled = true;
371:                 stopAll = true;
372:                 break;
373:             }
374:             if (verdict == ProbeVerdict::Facility) {
375:                 // 设施失败（F-746③ 同族非终局）：停止全部，剩余方向
376:                 // NotRun 如实标记；facility 已由探针转载底层 outcome
377:                 // 素材（stage/detail 原值——不加工）。
378:                 ray.state = EnvelopeRayState::NotRun;
379:                 ray.reason = "求解设施失败（径向站点扫描中断——该方向证据缺失）";
380:                 result.facilityFailure = facility;
381:                 stopAll = true;
382:                 break;
383:             }
384:             // NotFound：本站点探明不可达——记录为当前外端（后续可达站
385:             // 的外边界区间即 [下一可达站, 本站]），继续内扫。
386:             hi = t;
387:         }
388: 
389:         if (stopAll) {
390:             break;
391:         }
392: 
393:         if (!anchored) {
394:             // ---- 站点全灭：未找到可达样本（KIN-P5/审查 A04 诚实性
395:             // 修复）。低置信观测而非确定结论：可能是真不可达，也可能
396:             // 可达集窄于站点分辨率（Rup/M）或数值搜索未果（近似根源
397:             // 2）。旧行为（Computed＋rMax=0 的"近似空确定结论"）废除
398:             // ——"找到半径为零"与"没有找到"自此在状态词表分立。----
399:             ray.state = EnvelopeRayState::NoSampleFound;
400:             ray.rMax = 0.0;  // 占位——本态下 rMax 无语义（EnvelopeRayRecord 注）
401:             ray.reason =
402:                 "未找到可达样本（低置信——探测分辨率 Rup/"
403:                 + std::to_string(query.anchorProbesMax)
404:                 + " 内无命中；不构成该方向确定性不可达结论——搜索未果不作"
405:                 "不可行证明，窄于分辨率的可达带亦可能被漏检）";
406:             continue;
407:         }
408: 
409:         // ---- 3b. 外端区间二分收敛（(lo, hi] 上对分——mid 可达则外推
410:         // lo、不可达则内缩 hi；lo=hi（可达站＝上界点）时区间已空、循环
411:         // 自然不进入。终止＝区间宽 ≤ positionTolerance（物理分辨率早停）
412:         // 或迭代数耗尽（精度兜底）。rMax＝lo——"已证实可达的最远距离"
413:         // 下估计。----
414:         for (std::uint32_t it = 0;
415:              it < query.bisectIterationsMax && (hi - lo) > query.positionTolerance;
416:              ++it) {
417:             const double mid = lo + (hi - lo) / 2.0;  // 中点（不越界形态）
418:             const ProbeVerdict verdict =
419:                 probeReachability(mid, directions[j], view, tcp, query,
420:                                   intervals, probeSerial, ray.probeCount,
421:                                   &facility);
422:             if (verdict == ProbeVerdict::Reached) {
423:                 lo = mid;  // 可达侧外推
424:                 continue;
425:             }
426:             if (verdict == ProbeVerdict::Cancelled) {
427:                 ray.state = EnvelopeRayState::NotRun;
428:                 ray.reason = "协作取消（二分中断）";
429:                 result.cancelled = true;
430:                 stopAll = true;
431:                 break;
432:             }
433:             if (verdict == ProbeVerdict::Facility) {
434:                 ray.state = EnvelopeRayState::NotRun;
435:                 ray.reason = "求解设施失败（二分中断——该方向证据缺失）";
436:                 result.facilityFailure = facility;
437:                 stopAll = true;
438:                 break;
439:             }
440:             hi = mid;  // 不可达侧内缩（含搜索未果——近似根源 2）
441:         }
442: 
443:         if (stopAll) {
444:             break;
445:         }
446: 
447:         // 方向完成：rMax＝已证实可达的最远距离（下估计——非精确边界，
448:         // 标注随 result.precision/kEnvelopeApproximationNote 随行）。
449:         ray.state = EnvelopeRayState::Computed;
450:         ray.rMax = lo;
451:     }
452: 
453:     // ---- 第 4 步：停止后的剩余方向收尾（取消/设施失败路径——未开始
454:     // 方向保持 NotRun 初值，reason 补非空文案——ERR-01）。----
455:     if (stopAll) {
456:         for (std::uint32_t j = 0; j < query.directionCount; ++j) {
457:             EnvelopeRayRecord& ray = result.rays[j];
458:             if (ray.state != EnvelopeRayState::NotRun) {
459:                 continue;  // 已完成/已标记方向如实保留
460:             }
461:             if (ray.reason.empty()) {
462:                 ray.reason = result.facilityFailure.has_value()
463:                                  ? "求解设施失败（未开始——partial 如实标记）"
464:                                  : "协作取消（未开始——partial 如实标记）";
465:             }
466:         }
467:     }
468: 
469:     // 探测总数（逐方向之和——守恒自检：实现缺陷即 logic_error，不静默）。
470:     for (const EnvelopeRayRecord& ray : result.rays) {
471:         result.probeCount += ray.probeCount;
472:     }
473:     if (result.probeCount != probeSerial) {
474:         throw std::logic_error(
475:             "kin-envelope：探测总数与探针序号计数不一致（实现缺陷——"
476:             "不静默）；probeCount=" + std::to_string(result.probeCount)
477:             + " serial=" + std::to_string(probeSerial));
478:     }
479: 
480:     return Expected<EnvelopeResult>::ok(std::move(result));
481: }
482: 
483: }  // namespace sdurws::ird::kinematics

optimization.Pareto.slotValue
27: 
28: /// 激活目标槽位取值（FeasibleCandidate 八槽 → 指标值；越界/缺失由调用方
29: /// 前置校验保证——本辅助不做校验，直接取 optional 载荷）。
30: double slotValue(const FeasibleCandidate& c, MetricId id) noexcept
31: {
32:     return *c.metricValues[static_cast<std::size_t>(id)];
33: }
34: 
35: /// "aᵢ 不劣于 bᵢ（按方向 dᵢ，容差 tᵢ）"（§7.4 定义式——min/max 对称展开；
36: /// closeWithin 的参考元＝bᵢ，卡 §7.4 字面）。

optimization.Pareto.notWorse
34: 
35: /// "aᵢ 不劣于 bᵢ（按方向 dᵢ，容差 tᵢ）"（§7.4 定义式——min/max 对称展开；
36: /// closeWithin 的参考元＝bᵢ，卡 §7.4 字面）。
37: bool notWorse(double a, double b, MetricDirection d, const core::Tolerance& t) noexcept
38: {
39:     if (d == MetricDirection::Minimize) {
40:         // min 方向：a ≤ b 即不劣；近似相等（容差内）同样视为不劣——
41:         // 零容差时 closeWithin 退化为 a == b（浮点全序，DOPT-5）。
42:         return a <= b || core::closeWithin(a, b, t);
43:     }
44:     // max 方向：a ≥ b 即不劣（对称）。
45:     return a >= b || core::closeWithin(a, b, t);
46: }
47: 
48: /// "aᵢ 严格优于 bᵢ（按方向 dᵢ，容差 tᵢ）"——差异须**超出容差**的优
49: /// （容差内的优不算严格优：保证"逐元素近似相等 ⇒ 互不支配"自洽）。

optimization.Pareto.strictlyBetter
47: 
48: /// "aᵢ 严格优于 bᵢ（按方向 dᵢ，容差 tᵢ）"——差异须**超出容差**的优
49: /// （容差内的优不算严格优：保证"逐元素近似相等 ⇒ 互不支配"自洽）。
50: bool strictlyBetter(double a, double b, MetricDirection d,
51:                     const core::Tolerance& t) noexcept
52: {
53:     if (d == MetricDirection::Minimize) {
54:         return a < b && !core::closeWithin(a, b, t);
55:     }
56:     return a > b && !core::closeWithin(a, b, t);
57: }
58: 
59: }  // namespace
60: 

optimization.Pareto.dominates
62: // 支配判定（Pareto.hpp 契约——noexcept 纯函数）
63: // =====================================================================
64: 
65: bool dominates(const FeasibleCandidate& a, const FeasibleCandidate& b,
66:                const ObjectiveSet& objectives) noexcept
67: {
68:     // 第一步：∀i —— aᵢ 不劣于 bᵢ（任一目标劣即不支配——短路返回）。
69:     for (const auto& entry : objectives.entries) {
70:         // 方向经 metricDirectionOf 零分配取向（词表方向实现单点——
71:         // 热路径友好；noexcept 函数内禁用会分配的 metricDefinitions()）。
72:         const MetricDirection d = metricDirectionOf(entry.metricId);
73:         if (!notWorse(slotValue(a, entry.metricId), slotValue(b, entry.metricId),
74:                       d, entry.tolerance)) {
75:             return false;
76:         }
77:     }
78:     // 第二步：∃j —— aⱼ 严格优于 bⱼ（全不劣但无一严格优＝互不支配——
79:     // 逐元素近似相等的候选对在此归为互不支配，§7.4 自洽性）。
80:     for (const auto& entry : objectives.entries) {
81:         const MetricDirection d = metricDirectionOf(entry.metricId);
82:         if (strictlyBetter(slotValue(a, entry.metricId),
83:                            slotValue(b, entry.metricId), d, entry.tolerance)) {
84:             return true;
85:         }
86:     }
87:     return false;
88: }

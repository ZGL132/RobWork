235: const std::vector<std::string_view>& builtInStrategyIds()
236: {
237:     // 词表序＝卡面 §8.2 表行序（确定性）；内部静态表——进程生存期只读共享。
238:     // 每个 token 都有真实实现类（上方两个 generateNextBatch 实现）——契约
239:     // 测试逐 token 经 generateWithBuiltInStrategy 解析钉住（NFR-MNT-04
240:     // "不预建空占位"的机器可断言面）。
241:     static const std::vector<std::string_view> kVocabulary {
242:         kStrategySeededLhs,
243:         kStrategyBaselinePerturb,
244:     };
245:     return kVocabulary;
246: }

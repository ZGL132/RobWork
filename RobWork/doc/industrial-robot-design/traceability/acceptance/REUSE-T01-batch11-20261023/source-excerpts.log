optimization.Generator.validateBaselinePerturbParams
64: // 内置策略二：baseline-perturb 邻域扰动（§8.2 表第二行）
65: // =====================================================================
66: 
67: void validateBaselinePerturbParams(const BaselinePerturbParams& params)
68: {
69:     // 检查序固定（确定性首错）；全部不静默修正（NFR-COR-03）。消息含实际
70:     // 值与合法域（ERR-01 比较型定位纪律）。
71:     // ① 有限性：NaN/Inf 无配置意义（浮点比较失去序语义）。
72:     if (!std::isfinite(params.perturbRatio)) {
73:         throw OptimizationError(
74:             kOptInputInvalid,
75:             "OPT-INPUT-INVALID: baseline-perturb perturbRatio 非有限（实际值 "
76:                 + std::to_string(params.perturbRatio)
77:                 + "）——扰动比例须为有限数");
78:     }
79:     // ② 下界：0＝无扰动（批退化为基线自身重复——无搜索语义），负值方向
80:     //    语义颠倒；合法域自正数起。
81:     if (params.perturbRatio <= 0.0) {
82:         throw OptimizationError(
83:             kOptInputInvalid,
84:             "OPT-INPUT-INVALID: baseline-perturb perturbRatio="
85:                 + std::to_string(params.perturbRatio)
86:                 + "（合法域 (0, 0.04]——0 无扰动语义，负值非法）");
87:     }
88:     // ③ 上界：4× 默认封顶（0.04——REQUIREMENTS 附录 C《P-04 冻结数值表》
89:     //    表①"工程策略可放宽上界 ±4%（4×默认封顶）"冻结档位；超档位配置
90:     //    不静默接受）。
91:     if (params.perturbRatio > kBaselinePerturbMaxRatio) {
92:         throw OptimizationError(
93:             kOptInputInvalid,
94:             "OPT-INPUT-INVALID: baseline-perturb perturbRatio="
95:                 + std::to_string(params.perturbRatio) + "（合法域 (0, 0.04]——"
96:                 "上界为附录 C 表①冻结放宽档位 4×默认封顶）");
97:     }
98: }

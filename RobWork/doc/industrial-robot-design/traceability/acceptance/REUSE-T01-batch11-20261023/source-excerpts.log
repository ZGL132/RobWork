109: 
110: GenerationBatch BaselinePerturbGenerator::generateNextBatch(const GenerationContext& ctx)
111: {
112:     // 第 1 步：防御复验（配置面＋策略参数面——生成器是两者共同的消费入口；
113:     // 绕过 validateConfiguration 直调本接口也拦截——最后防线，与
114:     // generateSeededLhsCandidates/canonicalizeRunConfiguration 同款纪律）。
115:     validateConfiguration(ctx.config);
116:     validateBaselinePerturbParams(m_params);
117: 
118:     // 第 2 步：取消位（空批＋cancelled——§12.2 取消语义）。
119:     if (ctx.cancellationRequested) {
120:         GenerationBatch batch;
121:         batch.cancelled = true;
122:         return batch;
123:     }
124: 
125:     // 第 3 步：代序（单批策略——邻域在第 0 代完整枚举）。
126:     if (ctx.generationIndex > 0U) {
127:         GenerationBatch batch;
128:         batch.exhausted = true;
129:         return batch;
130:     }
131: 
132:     // 第 4 步：扰动维度集＝未锁定且授权的连续/量化绑定（§8.2"锁定集外
133:     // 扰动"/OPT-02——锁定绑定出现在补丁即拒绝，生成域预先排除）；枚举/
134:     // 离散器件维度不在扰动域（无连续邻域语义——±Δ 无定义；登记于头文件
135:     // 类注）；bindingId 字典序＝确定性维度序。
136:     std::vector<const VariableBinding*> dims;
137:     dims.reserve(ctx.config.variables.size());
138:     for (const auto& b : ctx.config.variables) {
139:         if (b.locked || !b.authorized) {
140:             continue;  // 锁定/未授权维度不扰动（§5.4——出现在补丁即拒绝）
141:         }
142:         if (b.kind == VariableKind::Continuous || b.kind == VariableKind::Quantized) {
143:             dims.push_back(&b);
144:         }
145:     }
146:     std::sort(dims.begin(), dims.end(),
147:               [](const VariableBinding* a, const VariableBinding* b) {
148:                   return a->bindingId < b->bindingId;
149:               });
150: 
151:     GenerationBatch batch;
152: 
153:     // 第 5 步：基线候选恒为批首元素（§8.2"基线候选……总是生成并参与
154:     // 评估"/OPT-11——空补丁有确定身份，label 不参与身份 I-OPT-8）。
155:     CandidatePatch baseline;
156:     baseline.label = "baseline";
157:     batch.candidates.push_back(std::move(baseline));
158: 
159:     // 第 6 步：预算与邻域规模。非基线候选上限 n＝maxCandidates−1（§8.2
160:     // "生成器受 OptimizationBudget 约束"；maxCandidates≥1 已校验无下溢）；
161:     // 邻域总量＝2m（m 维各 ±Δ 一点）。n==0（预算仅基线）或 m==0（无连续/
162:     // 量化授权维度）均为合法退化——批＝仅基线，exhausted 如实置位。
163:     const std::uint32_t n = ctx.config.budget.maxCandidates - 1U;
164:     const std::size_t m = dims.size();
165:     if (n == 0U || m == 0U) {
166:         batch.exhausted = true;
167:         return batch;
168:     }
169: 
170:     // 第 7~8 步：OFAT ±Δ 确定性轮转调度——第 i 个邻域候选取维度 v＝i mod m、
171:     // 方向 sign＝第 0 轮（i/m==0）正向、第 1 轮负向；调度上限 2m（全部
172:     // (维度,方向) 对）。逐点做合法性预检（有限/界内/正性词表位），不合法
173:     // 方向跳过不生成（邻域枚举语义即"合法邻点"——跳过是采样设计而非静默
174:     // 纠错，登记于头文件算法第 7 步）；收集满 n 个或调度耗尽即止。
175:     std::uint32_t collected = 0;
176:     for (std::uint32_t i = 0; i < 2U * m && collected < n; ++i) {
177:         const VariableBinding& b = *dims[i % m];
178:         const int sign = (i < m) ? 1 : -1;  // 第 0 轮 +Δ、第 1 轮 −Δ（轮转序）
179: 
180:         // 单步扰动幅度 Δ_v（§8.2 表第二行"步长/比例入 config"）：
181:         //   Quantized→绑定 step（网格邻点——步长字面承载于 config.opt
182:         //   variables 内）；Continuous→perturbRatio×行程（比例承载于装配期
183:         //   配置面 BaselinePerturbParams，默认 0.01＝附录 C 表①冻结值）。
184:         // step 语义由 VariableBinding 契约保证：Quantized 恒 >0（Continuous
185:         // 恒 0 不进本分支）；量化绑定的防御位（step≤0）属研究定义非法，
186:         // 交由补丁构造/绑定校验面拒绝，此处不重复判定（单一职责）。
187:         const double delta = (b.kind == VariableKind::Quantized)
188:                                  ? b.step
189:                                  : m_params.perturbRatio * (b.upperBound - b.lowerBound);
190:         const double value = b.defaultValue + sign * delta;
191: 
192:         // 合法性预检（三查——任一不过即跳过该方向）：
193:         //   a) 有限：defaultValue/界值异常（NaN/Inf）时扰动值无配置语义；
194:         //   b) 界内：[lowerBound, upperBound] 闭区间（越界方向不是邻点）；
195:         //   c) 正性词表位：valueMustBePositive（I-MDL-11 传动比等——需求
196:         //      原文值域硬约束）维度候选值须 >0。该位定义在**词表条目**上
197:         //      （VariableDefinition——绑定结构无此字段），经 matchDefinition
198:         //      查表；未知绑定查不到条目时不预判正性（补丁构造随后按研究
199:         //      定义非法 fail-fast——两道防线各司其职）。
200:         const bool finite = std::isfinite(value);
201:         const bool inBounds = value >= b.lowerBound && value <= b.upperBound;
202:         const VariableDefinition* def
203:             = matchDefinition(b.bindingId, ctx.config.stage);
204:         const bool positive = def == nullptr || !def->valueMustBePositive
205:                               || value > 0.0;
206:         if (!finite || !inBounds || !positive) {
207:             continue;  // 该方向无合法邻点——跳过（采样设计，非静默纠错）
208:         }
209: 
210:         // 第 8 步：单项补丁构造（OFAT——候选恰含一个绑定项；补丁 canonical
211:         // 唯一编码层，量化对齐/排序/规范化复用 T03 单点）。构造抛出（如
212:         // defaultValue 本身越界/正性矛盾——研究定义非法）按调用方错误
213:         // fail-fast 传播，不跳过不吞（与 seeded-lhs 生成期口径一致）。
214:         PatchItem item;
215:         item.bindingId = b.bindingId;
216:         item.scalarValue = value;
217:         CandidatePatch patch = makeCandidatePatch(
218:             ctx.config.variables, ctx.config.stage, {item},
219:             "perturb-" + std::to_string(collected));
220:         batch.candidates.push_back(std::move(patch));
221:         ++collected;
222:     }
223: 
224:     // 第 9 步：耗尽位——收集数不足预算即邻域已全部枚举（2m 对耗尽），
225:     // 调用方无须再请求下一代（单批策略恒 exhausted；预算恰好收满时同样
226:     // 置位——邻域没有更多候选）。
227:     batch.exhausted = true;
228:     return batch;
229: }

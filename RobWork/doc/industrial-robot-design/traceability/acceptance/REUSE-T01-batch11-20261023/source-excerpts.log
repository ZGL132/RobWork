trajectory.Planner.search
577:  */
578: class PathPlannerAdapterImpl final : public IPathPlannerAdapter {
579: public:
580:     PlanSearchResult search(const PlannerSearchRequest& request) override
581:     {
582:         // ---------------------------------------------------------------
583:         // 第一步：前置校验（调用方契约违约 fail-fast——§15.5 前置逐项）。
584:         // ---------------------------------------------------------------
585:         validateConfigPairAndBounds(request.fromQ, request.toQ, request.lowerBoundQ,
586:                                     request.upperBoundQ,
587:                                     "trajectory/planner/config-pair");
588:         if (request.workCell == nullptr) {
589:             throw TrajectoryError("trajectory/planner/view-missing",
590:                                   "runtime 快照只读视图缺失（WorkCell/Device 零自建"
591:                                   "——§10.1，调用方契约违约）");
592:         }
593:         if (request.deviceRuntimeName.empty()) {
594:             throw TrajectoryError("trajectory/planner/device-name",
595:                                   "设备运行时名为空（⑥端口解析产物透传——R-4）");
596:         }
597:         if (request.session == nullptr) {
598:             throw TrajectoryError("trajectory/planner/session-missing",
599:                                   "policy 碰撞会话缺失（R-5 唯一碰撞权威——适配器"
600:                                   "恒要求会话，跳过检查的语义在编排层承载）");
601:         }
602:         if (!(request.timeBudgetS > 0.0) || !std::isfinite(request.timeBudgetS)) {
603:             throw TrajectoryError("trajectory/planner/time-budget",
604:                                   "时间预算必须为有限正数（s），实际: "
605:                                       + std::to_string(request.timeBudgetS));
606:         }
607:         if (request.seed == 0) {
608:             throw TrajectoryError("trajectory/planner/seed",
609:                                   "规划种子必须为正（0 非法——I-KIN-4 同款拒绝，"
610:                                   "NFR-COR-02 种子纪律）");
611:         }
612:         const PlannerTuning tuning =
613:             parsePlannerSelection(request.plannerFamilyToken, request.plannerParams);
614: 
615:         // ---------------------------------------------------------------
616:         // 第二步：种子化全局随机源（§15.5"种子化规划器"——rw 规划器的随机
617:         // 性经进程级 Math::seed 约束；uint64 种子截断为 unsigned 的映射是
618:         // 确定性的（同种子同截断），不破坏 NFR-COR-02；并发 search 的种
619:         // 子互扰归装配面线程约束——评估器 SingleThread）。
620:         // ---------------------------------------------------------------
621:         rw::math::Math::seed(static_cast<unsigned>(request.seed));
622: 
623:         // ---------------------------------------------------------------
624:         // 第三步：定位设备（只读视图查询——名称为⑥端口解析产物透传；
625:         // 未命中＝调用方违约 fail-fast，不猜测名称——R-4/ARC-04）。
626:         // ---------------------------------------------------------------
627:         const rw::core::Ptr<const rw::models::SerialDevice> device =
628:             request.workCell->findDevice(request.deviceRuntimeName);
629:         if (device.isNull()) {
630:             throw TrajectoryError("trajectory/planner/device-unresolved",
631:                                   "设备在快照只读视图中不可解析: "
632:                                       + request.deviceRuntimeName);
633:         }
634:         const std::size_t dof = device->getDOF();
635:         if (request.fromQ.size() != dof) {
636:             throw TrajectoryError("trajectory/planner/dof-mismatch",
637:                                   "构型维度与设备自由度不一致：构型 "
638:                                       + std::to_string(request.fromQ.size()) + "，设备 "
639:                                       + std::to_string(dof));
640:         }
641: 
642:         // ---------------------------------------------------------------
643:         // 第四步：构造碰撞约束/采样器/规划器（装配序见类注；规划器局部
644:         // 对象——每次 search 独立，无跨调用状态）。
645:         // ---------------------------------------------------------------
646:         const AdapterCallContext ctx(&request.cancel);
647:         // policy 会话适配约束（rw::core::ownedPtr 接管生命周期；合并约束
648:         // 持有其 Ptr——存活期覆盖规划器）。
649:         rw::core::Ptr<PolicySessionQConstraint> policyConstraint =
650:             rw::core::ownedPtr(new PolicySessionQConstraint(request.session, &request.cancel));
651:         // 设备 bounds 约束（编译产物权威限位——构型守卫与采样盒同源）。
652:         rw::core::Ptr<rw::pathplanning::QConstraint> boundsConstraint =
653:             rw::pathplanning::QConstraint::makeBounds(device->getBounds());
654:         // 合并（碰撞＋限位双约束——构型与边都受限）。
655:         rw::core::Ptr<rw::pathplanning::QConstraint> mergedConstraint =
656:             rw::pathplanning::QConstraint::makeMerged(policyConstraint, boundsConstraint);
657:         // 逐轴欧氏度量（rad|m 混合计量——与本域路径长度/选择序同口径）。
658:         const rw::math::QMetric::Ptr metric =
659:             rw::math::MetricFactory::makeEuclidean<rw::math::Q>();
660:         // 边约束（直线插值离散检查——分辨率＝edge-resolution，§10.2）。
661:         const rw::pathplanning::QEdgeConstraint::Ptr edge =
662:             rw::pathplanning::QEdgeConstraint::make(mergedConstraint, metric,
663:                                                     tuning.resolution);
664:         // 规划约束（构型＋边）。
665:         const rw::pathplanning::PlannerConstraint plannerConstraint =
666:             rw::pathplanning::PlannerConstraint::make(mergedConstraint, edge);
667:         // 约束采样器（均匀采样设备 bounds，再经合并约束过滤——采样失败
668:         // 返回空 Q，RRT 内部重试）。
669:         const rw::pathplanning::QSampler::Ptr sampler =
670:             rw::pathplanning::QSampler::makeConstrained(
671:                 rw::pathplanning::QSampler::makeUniform(device->getBounds()),
672:                 mergedConstraint);
673:         // RRT-Connect 规划器（黄金算例锁定选型——词表注释）。
674:         const rw::pathplanning::QToQPlanner::Ptr planner =
675:             rwlibs::pathplanners::RRTPlanner::makeQToQPlanner(
676:                 plannerConstraint, sampler, metric, tuning.extend,
677:                 rwlibs::pathplanners::RRTPlanner::RRTConnect);
678: 
679:         // ---------------------------------------------------------------
680:         // 第五步：K 轮候选循环（预算先到先停；取消轮边界轮询——§15.1）。
681:         // 每轮：query 产出一条候选路径→立即 PathSequence 复核→收集。
682:         // ---------------------------------------------------------------
683:         PlanSearchResult result;
684:         SearchExhaustedRecord exhaustedRecord;
685:         // 墙钟账目：start/deadline 双锚——预算判定用 deadline，消耗账目
686:         // 用 start（SearchExhaustedRecord.consumedBudgetS 的如实来源）。
687:         const auto startClock = std::chrono::steady_clock::now();
688:         const auto deadline = startClock
689:             + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
690:                 std::chrono::duration<double>(request.timeBudgetS));
691:         bool canceled = false;
692:         bool plannerError = false;
693:         std::string plannerErrorCause;
694: 
695:         for (std::uint32_t round = 0; round < tuning.attempts; ++round) {
696:             // 取消轮询（轮边界——命中立即停止；取消不是错误，零错误素材）。
697:             if (request.cancel && request.cancel()) {
698:                 canceled = true;
699:                 break;
700:             }
701:             // 剩余预算（多轮共享总预算——先到先停，§10.3 预算传递）。
702:             const double remainingS =
703:                 std::chrono::duration<double>(deadline - std::chrono::steady_clock::now())
704:                     .count();
705:             if (!(remainingS > 0.0)) {
706:                 break;  // 预算耗尽——按搜索未果收尾
707:             }
708:             // 一轮规划（rw 异常就地转译——不吞、不逃逸，§15.5 错误行）。
709:             rw::trajectory::QPath plannedPath;
710:             bool found = false;
711:             try {
712:                 found = planner->query(request.fromQ, request.toQ, plannedPath, remainingS);
713:             } catch (const rw::core::Exception& e) {
714:                 // RT-ROBWORK-ERROR 转译登记（runtime translateRobWorkError
715:                 // 同款不吞异常——本域归 TRJ 素材轨，原文入 cause）。
716:                 plannerError = true;
717:                 plannerErrorCause = e.getMessage().getText();
718:                 break;
719:             } catch (const std::exception& e) {
720:                 plannerError = true;
721:                 plannerErrorCause = e.what();
722:                 break;
723:             }
724:             exhaustedRecord.attemptedCandidates = round + 1;
725: 
726:             if (!found || plannedPath.size() < 2) {
727:                 continue;  // 本轮未产出（预算内未找到/退化输出）——下一轮
728:             }
729:             // 防御核对：首末点必须与请求端点一致（规划器契约；不一致的
730:             // 输出按本轮无效丢弃——不进入复核，证据账目照实）。
731:             const double endpointsEps = tuning.resolution;  // 分辨率量级容差
732:             const rw::math::Q frontError = plannedPath.front() - request.fromQ;
733:             const rw::math::Q backError = plannedPath.back() - request.toQ;
734:             bool endpointsMatch = frontError.norm2() <= endpointsEps
735:                                   && backError.norm2() <= endpointsEps;
736:             if (!endpointsMatch) {
737:                 continue;  // 丢弃本轮输出（鲁棒性守卫——不计为候选）
738:             }
739: 
740:             // 候选复核采样协议：规划器输出路点全量（密度由 extend/edge-
741:             // resolution 间接决定——进身份）；pathParameters 均匀 s=i/(n-1)
742:             // （§10.3 等长约定）。
743:             const std::size_t sampleCount = plannedPath.size();
744:             std::vector<double> candidateParams(sampleCount);
745:             for (std::size_t i = 0; i < sampleCount; ++i) {
746:                 candidateParams[i] = sampleCount == 1
747:                                          ? 0.0
748:                                          : static_cast<double>(i)
749:                                                / static_cast<double>(sampleCount - 1);
750:             }
751:             const ReviewResult review = reviewPathSequence(
752:                 *request.session, ctx, plannedPath, candidateParams);
753: 
754:             // 候选入册（逐条结果入证据——§10.4"K 与逐条结果入证据"）。
755:             PathCandidate candidate;
756:             candidate.candidateIndex = static_cast<std::uint32_t>(result.candidates.size());
757:             candidate.configurations = plannedPath;
758:             candidate.pathParameters = candidateParams;
759:             switch (review.outcome) {
760:             case ReviewOutcome::Passed:
761:                 candidate.reviewStatus = CandidateReviewStatus::Passed;
762:                 break;
763:             case ReviewOutcome::Collision:
764:                 candidate.reviewStatus = CandidateReviewStatus::Collision;
765:                 candidate.collisionRecords = review.records;
766:                 exhaustedRecord.candidateRecords.insert(
767:                     exhaustedRecord.candidateRecords.end(), review.records.begin(),
768:                     review.records.end());
769:                 break;
770:             case ReviewOutcome::DataInsufficient:
771:                 candidate.reviewStatus = CandidateReviewStatus::DataInsufficient;
772:                 break;
773:             }
774:             result.candidates.push_back(std::move(candidate));
775:         }
776:         exhaustedRecord.consumedBudgetS =
777:             std::chrono::duration<double>(std::chrono::steady_clock::now() - startClock)
778:                 .count();
779: 
780:         // ---------------------------------------------------------------
781:         // 第六步：结局归类（四态——PlanSearchResult 状态—字段联动契约）。
782:         // ---------------------------------------------------------------
783:         if (plannerError) {
784:             result.status = PlanSearchStatus::PlannerError;
785:             result.failure = makeAvoidFailure(
786:                 0xFFFFFFFFu, std::string{kTrjNoPath},
787:                 "避障搜索中规划器异常（rw 异常转译登记）: " + plannerErrorCause,
788:                 "检查场景几何与策略配置后重试；若持续出现请登记诊断");
789:             return result;
790:         }
791:         if (canceled) {
792:             result.status = PlanSearchStatus::Canceled;  // 取消不是错误（UX-03）
793:             if (!result.candidates.empty()) {
794:                 result.exhausted = exhaustedRecord;  // 已消耗账目如实携带
795:             }
796:             return result;
797:         }
798:         // 稳定选择序：在通过候选中取最优（四键全序——选择序实现注）。
799:         std::optional<std::size_t> adopted;
800:         for (std::size_t i = 0; i < result.candidates.size(); ++i) {
801:             if (result.candidates[i].reviewStatus != CandidateReviewStatus::Passed) {
802:                 continue;
803:             }
804:             if (!adopted.has_value()
805:                 || candidatePreferred(result.candidates[i], result.candidates[*adopted],
806:                                       request.lowerBoundQ, request.upperBoundQ)) {
807:                 adopted = i;
808:             }
809:         }
810:         if (adopted.has_value()) {
811:             result.status = PlanSearchStatus::Found;
812:             result.adoptedIndex = adopted;
813:             return result;
814:         }
815:         // 无通过候选——搜索未果（素材轨，不判不可行）。
816:         result.status = PlanSearchStatus::BudgetExhausted;
817:         result.exhausted = exhaustedRecord;
818:         return result;
819:     }
820: };
821: 
822: }  // namespace

trajectory.Planner.makePathPlannerAdapter
825: // 唯一构造入口（§15.5 形态行——makePathPlannerAdapter）
826: // =====================================================================
827: 
828: std::unique_ptr<IPathPlannerAdapter> makePathPlannerAdapter()
829: {
830:     return std::make_unique<PathPlannerAdapterImpl>();
831: }
832: 
833: // =====================================================================
834: // §10.4 避障重规划编排（planPtpWithObstacleAvoidance）

trajectory.Planner.planPtpWithObstacleAvoidance
834: // §10.4 避障重规划编排（planPtpWithObstacleAvoidance）
835: // =====================================================================
836: 
837: AvoidancePlanResult planPtpWithObstacleAvoidance(const AvoidancePlanRequest& request,
838:                                                  IPathPlannerAdapter& adapter)
839: {
840:     // ---------------------------------------------------------------
841:     // 第一步：前置校验（fail-fast——AvoidancePlanRequest 前置逐项；选型
842:     // 复用适配器同款解析器，保证两层错误面一致）。
843:     // ---------------------------------------------------------------
844:     validateConfigPairAndBounds(request.startQ, request.endQ, request.lowerBoundQ,
845:                                 request.upperBoundQ, "trajectory/avoid/config-pair");
846:     if (!(request.constraint.limitsScaleFactor > 0.0)
847:         || request.constraint.limitsScaleFactor > 1.0
848:         || !std::isfinite(request.constraint.limitsScaleFactor)) {
849:         throw TrajectoryError("trajectory/avoid/constraint",
850:                               "限值使用比例必须在 (0,1]，实际: "
851:                                   + std::to_string(request.constraint.limitsScaleFactor));
852:     }
853:     if (!(request.constraint.cartesianSampleStep > 0.0)
854:         || !std::isfinite(request.constraint.cartesianSampleStep)) {
855:         throw TrajectoryError("trajectory/avoid/constraint",
856:                               "采样步长必须为有限正数（m），实际: "
857:                                   + std::to_string(request.constraint.cartesianSampleStep));
858:     }
859:     if (!request.tcpRef.isValid()) {
860:         throw TrajectoryError("trajectory/avoid/tcp-ref",
861:                               "tcpRef 必须为合法对象身份（§6.3 必填）");
862:     }
863:     if (request.endKind == WaypointKind::TaskPoint && !request.sourceTaskPoint.has_value()) {
864:         throw TrajectoryError("trajectory/avoid/source-task-point",
865:                               "endKind==TaskPoint 时 sourceTaskPoint 必填（NFR-COR-04）");
866:     }
867:     if (request.endKind != WaypointKind::TaskPoint && request.sourceTaskPoint.has_value()) {
868:         throw TrajectoryError("trajectory/avoid/source-task-point",
869:                               "endKind 非 TaskPoint 时 sourceTaskPoint 必须为空（防悬空"
870:                               "附件——身份面同语义同字节纪律）");
871:     }
872:     if (request.startKind == WaypointKind::TaskPoint
873:         && !request.startSourceTaskPoint.has_value()) {
874:         throw TrajectoryError("trajectory/avoid/start-source-task-point",
875:                               "startKind==TaskPoint 时 startSourceTaskPoint 必填");
876:     }
877:     if (request.startKind != WaypointKind::TaskPoint
878:         && request.startSourceTaskPoint.has_value()) {
879:         throw TrajectoryError("trajectory/avoid/start-source-task-point",
880:                               "startKind 非 TaskPoint 时 startSourceTaskPoint 必须为空");
881:     }
882:     // 会话/视图一致性（collisionCheckApplicable 是唯一开关——带会话却
883:     // 跳过检查（或反之）的双口径在结构上禁止）。
884:     if (request.constraint.collisionCheckApplicable) {
885:         if (request.policySession == nullptr || request.workCell == nullptr
886:             || request.deviceRuntimeName.empty()) {
887:             throw TrajectoryError("trajectory/avoid/collision-wiring",
888:                                   "碰撞检查适用时 policy 会话/快照视图/设备名必须"
889:                                   "齐备（R-5 唯一碰撞权威）");
890:         }
891:     } else if (request.policySession != nullptr || request.workCell != nullptr) {
892:         throw TrajectoryError("trajectory/avoid/collision-wiring",
893:                               "碰撞检查不适用时不得携带会话/视图（防双口径——唯一"
894:                               "开关＝constraint.collisionCheckApplicable）");
895:     }
896:     if (!(request.timeBudgetS > 0.0) || !std::isfinite(request.timeBudgetS)) {
897:         throw TrajectoryError("trajectory/avoid/time-budget",
898:                               "时间预算必须为有限正数（s），实际: "
899:                                   + std::to_string(request.timeBudgetS));
900:     }
901:     if (request.seed == 0) {
902:         throw TrajectoryError("trajectory/avoid/seed",
903:                               "规划种子必须为正（0 非法——I-KIN-4 同款拒绝）");
904:     }
905:     const PlannerTuning tuning =
906:         parsePlannerSelection(request.plannerFamilyToken, request.plannerParams);
907: 
908:     AvoidancePlanResult outcome;
909:     outcome.segment.segmentIndex = request.segmentIndex;
910:     outcome.segment.spaceType = SegmentSpaceType::JointLinear;
911:     outcome.segment.tcpRef = request.tcpRef;
912:     outcome.segment.frameRef = request.frameRef;
913:     outcome.segment.constraint = request.constraint;
914:     outcome.segment.sourceTaskPoint = request.sourceTaskPoint;
915: 
916:     // ---------------------------------------------------------------
917:     // 第二步：取消轮询（任何计算前——取消不是错误，零素材）。
918:     // ---------------------------------------------------------------
919:     if (request.cancel && request.cancel()) {
920:         outcome.status = AvoidanceStatus::Canceled;
921:         return outcome;
922:     }
923: 
924:     // ---------------------------------------------------------------
925:     // 第三步：碰撞检查不适用 → 直连采纳（V13-01 同款唯一开关语义：策略
926:     // 未启用碰撞＝碰撞检查不在范围，非降级；段约束标记自明）。
927:     // ---------------------------------------------------------------
928:     if (!request.constraint.collisionCheckApplicable) {
929:         outcome.status = AvoidanceStatus::Ok;
930:         outcome.directPathAdopted = true;
931:         // 几何构造：两端点路点（JointLinear 逐轴线性语义——§7.3；中间无
932:         // Via 点）。
933:         Waypoint start;
934:         start.kind = request.startKind;
935:         start.segmentIndex = request.segmentIndex;
936:         start.q = request.startQ;
937:         start.sourceTaskPoint = request.startSourceTaskPoint;
938:         Waypoint end;
939:         end.kind = request.endKind;
940:         end.segmentIndex = request.segmentIndex;
941:         end.q = request.endQ;
942:         end.sourceTaskPoint = request.sourceTaskPoint;
943:         outcome.segment.waypoints = {start, end};
944:         double length = 0.0;
945:         for (std::size_t i = 0; i < request.startQ.size(); ++i) {
946:             length += std::abs(request.endQ[i] - request.startQ[i]);
947:         }
948:         outcome.segment.pathLengthJoint = length;
949:         outcome.segment.pathLengthTcp = 0.0;  // FK 派生观察不计算——恒 0 不冒充
950:         validateTrajectorySegment(outcome.segment);  // 段构造保证的自证
951:         return outcome;
952:     }
953: 
954:     // ---------------------------------------------------------------
955:     // 第四步：直连候选筛查（§10.4 流程图第一分支——按 edge-resolution
956:     // 均匀采样，一次 PathSequence 查询；与候选复核同一会话通道，AT-19）。
957:     // ---------------------------------------------------------------
958:     const AdapterCallContext ctx(&request.cancel);
959:     const SampledPath direct = sampleStraightPath(request.startQ, request.endQ,
960:                                                   tuning.resolution);
961:     const ReviewResult directReview =
962:         reviewPathSequence(*request.policySession, ctx, direct.configurations,
963:                            direct.pathParameters);
964:     if (directReview.outcome == ReviewOutcome::DataInsufficient) {
965:         // 直连复核不可采信（含取消到达——policy 样本边界取消）→ 不当作
966:         // 碰撞淘汰（KIN-05）；取消观测直接命中的情形归取消语义。
967:         if (request.cancel && request.cancel()) {
968:             outcome.status = AvoidanceStatus::Canceled;
969:             return outcome;
970:         }
971:         // 非取消的不可采信（Failed/EmptyScope/禁用）——归 PlannerError 面
972:         // （环境类失败素材；绝不当"无碰撞直连"采纳）。
973:         outcome.status = AvoidanceStatus::PlannerError;
974:         outcome.failure = makeAvoidFailure(
975:             request.segmentIndex, std::string{kTrjRecheckDataInsufficient},
976:             "直连路径筛查不可采信（碰撞评估未产生终态结论——证据缺失不当作"
977:             "无碰撞，KIN-05）",
978:             "检查策略启用状态与碰撞几何清单后重试");
979:         return outcome;
980:     }
981: 
982:     auto buildSegment = [&](const std::vector<rw::math::Q>& configurations) {
983:         // 段几何：起点＋中间 Via 点＋终点（避障候选的中间路点为规划器
984:         // 引入——WaypointKind::Via，非必经状态，C8 语义）。
985:         outcome.segment.waypoints.clear();
986:         Waypoint start;
987:         start.kind = request.startKind;
988:         start.segmentIndex = request.segmentIndex;
989:         start.q = request.startQ;
990:         start.sourceTaskPoint = request.startSourceTaskPoint;
991:         outcome.segment.waypoints.push_back(start);
992:         for (std::size_t i = 1; i + 1 < configurations.size(); ++i) {
993:             Waypoint via;
994:             via.kind = WaypointKind::Via;
995:             via.segmentIndex = request.segmentIndex;
996:             via.q = configurations[i];
997:             outcome.segment.waypoints.push_back(via);
998:         }
999:         Waypoint end;
1000:         end.kind = request.endKind;
1001:         end.segmentIndex = request.segmentIndex;
1002:         end.q = configurations.back();
1003:         end.sourceTaskPoint = request.sourceTaskPoint;
1004:         outcome.segment.waypoints.push_back(end);
1005:         double length = 0.0;
1006:         for (std::size_t i = 1; i < configurations.size(); ++i) {
1007:             for (std::size_t j = 0; j < configurations[i].size(); ++j) {
1008:                 length += std::abs(configurations[i][j] - configurations[i - 1][j]);
1009:             }
1010:         }
1011:         outcome.segment.pathLengthJoint = length;
1012:         outcome.segment.pathLengthTcp = 0.0;  // FK 派生观察不计算
1013:     };
1014: 
1015:     if (directReview.outcome == ReviewOutcome::Passed) {
1016:         // 直连无碰撞 → 采纳为该段路径（§10.4 流程图——不进搜索）。
1017:         // 段几何只落两端点：JointLinear 段的几何＝逐轴线性（§7.3），筛查
1018:         // 用的中间采样点只是碰撞检查的样本（不进段路点——共线冗余点会
1019:         // 污染段结构语义与后续平滑/时间化的输入面）。
1020:         outcome.status = AvoidanceStatus::Ok;
1021:         outcome.directPathAdopted = true;
1022:         buildSegment({direct.configurations.front(), direct.configurations.back()});
1023:         validateTrajectorySegment(outcome.segment);
1024:         return outcome;
1025:     }
1026: 
1027:     // 直连检出碰撞 → 记录直连淘汰（C8 证据素材——"初始候选路径碰撞"是
1028:     // AT-06 明文反例），进入避障搜索（重规划）。
1029:     if (!directReview.records.empty()) {
1030:         outcome.directCollision = directReview.records.front();  // 首发现（停机样本）
1031:     }
1032: 
1033:     // ---------------------------------------------------------------
1034:     // 第五步：避障搜索（K 轮候选＋逐条复核＋选择序——全部委托适配器；
1035:     // 请求字段逐项投影——同源校验已在上面完成）。
1036:     // ---------------------------------------------------------------
1037:     PlannerSearchRequest searchRequest;
1038:     searchRequest.fromQ = request.startQ;
1039:     searchRequest.toQ = request.endQ;
1040:     searchRequest.lowerBoundQ = request.lowerBoundQ;
1041:     searchRequest.upperBoundQ = request.upperBoundQ;
1042:     searchRequest.workCell = request.workCell;
1043:     searchRequest.deviceRuntimeName = request.deviceRuntimeName;
1044:     searchRequest.session = request.policySession;
1045:     searchRequest.plannerFamilyToken = request.plannerFamilyToken;
1046:     searchRequest.plannerParams = request.plannerParams;
1047:     // 预算共享：直连筛查消耗未单独记账（两次会话查询，开销相对规划预算
1048:     // 可忽略——账目口径＝搜索预算全归 search，如实登记）。
1049:     searchRequest.timeBudgetS = request.timeBudgetS;
1050:     searchRequest.seed = request.seed;
1051:     searchRequest.cancel = request.cancel;
1052:     const PlanSearchResult searchResult = adapter.search(searchRequest);
1053: 
1054:     switch (searchResult.status) {
1055:     case PlanSearchStatus::Found: {
1056:         const PathCandidate& adopted = searchResult.candidates[*searchResult.adoptedIndex];
1057:         outcome.status = AvoidanceStatus::Ok;
1058:         outcome.directPathAdopted = false;
1059:         outcome.adoptedCandidateIndex = searchResult.adoptedIndex;
1060:         buildSegment(adopted.configurations);
1061:         validateTrajectorySegment(outcome.segment);  // 段构造保证的自证
1062:         return outcome;
1063:     }
1064:     case PlanSearchStatus::BudgetExhausted:
1065:         // 搜索未果 → SearchExhaustedRecord → DataInsufficient 素材——
1066:         // **不判不可行**（§7.6 行 4/C8；任务级判定归 evidence）。
1067:         outcome.status = AvoidanceStatus::SearchExhausted;
1068:         outcome.searchRecord = searchResult.exhausted;
1069:         outcome.failure = makeAvoidFailure(
1070:             request.segmentIndex, std::string{kTrjNoPath},
1071:             "避障搜索未果（直连路径碰撞且预算内全部候选淘汰——已试候选 "
1072:                 + std::to_string(searchResult.exhausted->attemptedCandidates)
1073:                 + " 轮；搜索未果不构成任务不可行证明）",
1074:             "调整工况/障碍布局或放宽规划预算后重评；该段以数据不足素材进入"
1075:             "证据汇总");
1076:         return outcome;
1077:     case PlanSearchStatus::PlannerError:
1078:         outcome.status = AvoidanceStatus::PlannerError;
1079:         outcome.failure = searchResult.failure;
1080:         return outcome;
1081:     case PlanSearchStatus::Canceled:
1082:         outcome.status = AvoidanceStatus::Canceled;  // 取消透传——零错误素材
1083:         return outcome;
1084:     }
1085:     // 词表封闭——不可达；fail-fast 兜底（实现缺陷显性化）。
1086:     throw TrajectoryError("trajectory/avoid/status-exhausted",
1087:                           "PlanSearchStatus 词表外取值（实现缺陷）");
1088: }
1089: 
1090: }  // namespace sdurws::ird::trajectory
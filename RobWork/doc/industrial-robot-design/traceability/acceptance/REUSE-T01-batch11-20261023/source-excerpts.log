90: // =====================================================================
91: // buildFront（执行序见 Pareto.hpp——五步固定）

optimization.Pareto.ParetoFrontBuilder.buildFront
91: // buildFront（执行序见 Pareto.hpp——五步固定）
92: // =====================================================================
93: 
94: ParetoFrontResult ParetoFrontBuilder::buildFront(
95:     const std::vector<FeasibleCandidate>& candidates,
96:     const ObjectiveSet& objectives) const
97: {
98:     // ---- 第 1 步：目标集与输入校验（调用方契约违约 fail-fast——§12.3；
99:     //      错误归类：目标集/槽位形状/激活指标缺失或非有限＝调用方错误
100:     //      OPT-INPUT-INVALID——"—"候选在管线侧排除，到达本面即违约，
101:     //      文件头注④） ----
102:     {
103:         // 目标集自身合法性（空/重复/容差——与 Objective 侧同源口径：
104:         // 这里以最小面复验，防绕过 makeObjectiveSet 的构造路径）。
105:         if (objectives.entries.empty()) {
106:             throw OptimizationError(kOptInputInvalid,
107:                                     "buildFront: 激活目标集为空——无支配比较基础");
108:         }
109:         for (std::size_t i = 0; i < objectives.entries.size(); ++i) {
110:             for (std::size_t j = i + 1; j < objectives.entries.size(); ++j) {
111:                 if (objectives.entries[i].metricId
112:                     == objectives.entries[j].metricId) {
113:                     throw OptimizationError(
114:                         kOptInputInvalid,
115:                         "buildFront: 激活目标重复（"
116:                             + std::string(toToken(objectives.entries[i].metricId))
117:                             + "）");
118:                 }
119:             }
120:             const core::Tolerance& t = objectives.entries[i].tolerance;
121:             if (!std::isfinite(t.relative) || !std::isfinite(t.absolute)
122:                 || t.relative < 0.0 || t.absolute < 0.0) {
123:                 throw OptimizationError(
124:                     kOptInputInvalid,
125:                     "buildFront: 支配容差非法（须 ≥0 且有限，指标 "
126:                         + std::string(toToken(objectives.entries[i].metricId))
127:                         + "）");
128:             }
129:         }
130:         // 逐候选形状与激活指标校验（输入序遍历——首错定位确定性）。
131:         for (const auto& c : candidates) {
132:             if (c.metricValues.size() != kMetricCount) {
133:                 throw OptimizationError(
134:                     kOptInputInvalid,
135:                     "buildFront: 候选指标槽数须为八（MetricId 枚举序），实际 "
136:                         + std::to_string(c.metricValues.size()) + "（候选 "
137:                         + c.candidateId.toCanonical() + "）");
138:             }
139:             for (const auto& entry : objectives.entries) {
140:                 const std::optional<double>& v =
141:                     c.metricValues[static_cast<std::size_t>(entry.metricId)];
142:                 if (!v.has_value()) {
143:                     // 激活目标槽位缺失＝"—"候选未被管线侧排除（§7.4 缺失
144:                     // 指标不参与支配比较的实现位置——@pre 防线）。
145:                     throw OptimizationError(
146:                         kOptInputInvalid,
147:                         "buildFront: 激活目标指标缺失（not-computable）——"
148:                         "候选 "
149:                             + c.candidateId.toCanonical() + " 指标 "
150:                             + std::string(toToken(entry.metricId))
151:                             + "；'—'候选应在管线侧排除（DataInsufficient）");
152:                 }
153:                 if (!std::isfinite(*v)) {
154:                     // 非有限值（NaN/Inf）＝上游指标评估缺陷（§7.2：该候选
155:                     // 应已按评估失败处理）——不静默比较、不静默转 0。
156:                     throw OptimizationError(
157:                         kOptInputInvalid,
158:                         "buildFront: 指标值非有限——候选 "
159:                             + c.candidateId.toCanonical() + " 指标 "
160:                             + std::string(toToken(entry.metricId))
161:                             + "；上游应按评估失败处理（§7.2）");
162:                 }
163:             }
164:         }
165:     }
166: 
167:     // ---- 第 2 步：去重（CandidateId 相同 → 保留输入序首见，丢弃计数——
168:     //      §7.4"重复 CandidateId → 去重为单候选（保留首次评估，dedupCount
169:     //      计数入审计）"；同身份不同指标向量按同规去重——身份是内容寻址
170:     //      权威，差异本身属上游一致性缺陷，计数如实暴露） ----
171:     std::vector<const FeasibleCandidate*> unique;  ///< 去重后（保持首见序）
172:     unique.reserve(candidates.size());
173:     std::uint32_t dropped = 0;
174:     for (const auto& c : candidates) {
175:         bool seen = false;
176:         for (const auto* u : unique) {
177:             if (u->candidateId == c.candidateId) {
178:                 seen = true;
179:                 break;
180:             }
181:         }
182:         if (seen) {
183:             ++dropped;  // 重复丢弃——审计计数（不抛：同身份重复是合法输入
184:                         // 形态——跨批合并的常态，§8.3 第 11 步）。
185:             continue;
186:         }
187:         unique.push_back(&c);
188:     }
189: 
190:     // ---- 第 3 步：非支配分层（逐层筛选——文件头注②；每轮在剩余集中
191:     //      取"不被任何同轮候选支配"者为当前层；扫描序＝去重后首见序，
192:     //      层内收集序＝首见序——两序都只是中间态，最终序由第 4 步全序
193:     //      比较器定死，NFR-COR-02） ----
194:     const std::size_t n = unique.size();
195:     std::vector<std::size_t> rank(n, 0);     ///< 每候选非支配 rank（0 基）
196:     std::vector<bool> assigned(n, false);    ///< 是否已入层
197:     std::size_t remaining = n;               ///< 剩余未分层候选数
198:     for (std::size_t currentRank = 0; remaining > 0; ++currentRank) {
199:         // 当前层：未被层外剩余集中任何未分层候选支配的候选。
200:         // O(剩余²) 支配判定——R1 预算 ≤256 候选（卡 §4.3 OptimizationBudget
201:         // 默认），最坏 6.5 万次纯函数调用，无性能顾虑。
202:         std::vector<std::size_t> front;
203:         for (std::size_t i = 0; i < n; ++i) {
204:             if (assigned[i]) {
205:                 continue;  // 已入前序层——不再参与本轮筛选。
206:             }
207:             bool dominatedByAny = false;
208:             for (std::size_t j = 0; j < n; ++j) {
209:                 if (j == i || assigned[j]) {
210:                     continue;  // 同候选/已分层候选不参与支配本轮。
211:                 }
212:                 if (dominates(*unique[j], *unique[i], objectives)) {
213:                     dominatedByAny = true;
214:                     break;
215:                 }
216:             }
217:             if (!dominatedByAny) {
218:                 front.push_back(i);
219:             }
220:         }
221:         // front 非空恒成立（有限偏序下剩余集中至少一个极小元——若为空
222:         // 属算法缺陷，fail-fast 不死循环）。
223:         if (front.empty()) {
224:             throw OptimizationError(kOptInputInvalid,
225:                                     "buildFront: 非支配分层异常（空层）——"
226:                                     "内部一致性缺陷");
227:         }
228:         for (const std::size_t i : front) {
229:             rank[i] = currentRank;
230:             assigned[i] = true;
231:             --remaining;
232:         }
233:     }
234: 
235:     // ---- 第 4 步：稳定排序（三键全序——§7.4/DOPT-8；键②用**严格浮点
236:     //      比较**，容差不进排序键——文件头注①：容差近似相等非传递，混入
237:     //      即破坏全序；键③ CandidateId 字节字典序兜底——无巧合平局） ----
238:     const std::vector<MetricDefinition> defs = metricDefinitions();  // 排序前
239:     // 一次构建（比较器内查表——方向权威消费面；非热路径逐次构造）。
240:     std::vector<std::size_t> order(n);
241:     for (std::size_t i = 0; i < n; ++i) {
242:         order[i] = i;
243:     }
244:     std::sort(order.begin(), order.end(),
245:               [&](std::size_t lhs, std::size_t rhs) {
246:                   // 键①：非支配 rank 升序（前沿层序——第一前沿最先）。
247:                   if (rank[lhs] != rank[rhs]) {
248:                       return rank[lhs] < rank[rhs];
249:                   }
250:                   // 键②：激活目标值依次按方向严格比较（目标次序＝
251:                   // objectives 声明序——§7.4 稳定排序原文）。
252:                   for (const auto& entry : objectives.entries) {
253:                       const MetricDirection d =
254:                           defs[static_cast<std::size_t>(entry.metricId)]
255:                               .direction;
256:                       const double vl = slotValue(*unique[lhs], entry.metricId);
257:                       const double vr = slotValue(*unique[rhs], entry.metricId);
258:                       if (vl < vr) {
259:                           return d == MetricDirection::Minimize;
260:                       }
261:                       if (vr < vl) {
262:                           return d == MetricDirection::Maximize;
263:                       }
264:                       // 相等（浮点严格相等）→ 下一目标键。
265:                   }
266:                   // 键③：CandidateId 字节字典序终键（全序保证——同指标
267:                   // 向量候选由此定序，确定性无平局）。
268:                   return unique[lhs]->candidateId < unique[rhs]->candidateId;
269:               });
270: 
271:     // ---- 第 5 步：组装结果（entries 按稳定序；双集合＝rank 0 子集与
272:     //      全体，均保持 entries 序——§7.4 双标记显式呈现） ----
273:     ParetoFrontResult result;
274:     result.duplicatesDropped = dropped;
275:     result.entries.reserve(n);
276:     result.nondominatedIds.reserve(n);
277:     result.feasibleIds.reserve(n);
278:     for (const std::size_t i : order) {
279:         ParetoFrontEntry entry;
280:         entry.candidateId = unique[i]->candidateId;
281:         entry.isBaseline = unique[i]->isBaseline;
282:         entry.nondominationRank = rank[i];
283:         entry.paretoNondominated = (rank[i] == 0);  // 第一前沿＝非支配集
284:         result.entries.push_back(entry);
285:         result.feasibleIds.push_back(entry.candidateId);
286:         if (entry.paretoNondominated) {
287:             result.nondominatedIds.push_back(entry.candidateId);
288:         }
289:     }
290:     return result;
291: }
292: 
293: }  // namespace sdurws::ird::optimization


389: /**
390:  * @brief PathSequence 复核结论（域内三态——与 CandidateReviewStatus 对齐）。

trajectory.Planner.reviewPathSequence
416:     std::vector<CandidateCollisionRecord> records;  ///< 碰撞淘汰明细（Collision 态非空）
417: };
418: 
419: ReviewResult reviewPathSequence(const policy::CollisionEvaluationSession& session,
420:                                 const AdapterCallContext& ctx,
421:                                 const std::vector<rw::math::Q>& configurations,
422:                                 const std::vector<double>& pathParameters)
423: {
424:     // 查询装配（PathSequence 契约：构型非空＋pathParameters 等长；无
425:     // baseState＝场景基准状态——policy evaluate 侧取 WC 默认态）。
426:     policy::CollisionQuery query;
427:     query.kind = policy::CollisionQueryKind::PathSequence;
428:     query.configurations = configurations;
429:     query.pathParameters = pathParameters;
430:     query.stopAtFirstFinding = true;  // 淘汰场景——首个发现即停
431:     query.requestMinDistance = false; // 二值后端无距离能力（P-POL-11），不请求
432: 
433:     const policy::CollisionEvaluation evaluation = session.evaluate(query, ctx);
434: 
435:     ReviewResult result;
436:     // 只有"Completed＋Applicable＋finalized"是可采信终态（§6.3 状态机）。
437:     if (evaluation.status == policy::CollisionEvaluationStatus::Completed
438:         && evaluation.finalized
439:         && evaluation.applicability == policy::ScopeApplicability::Applicable) {
440:         bool collided = false;
441:         for (const policy::CollisionFinding& finding : evaluation.findings) {
442:             if (finding.kind != policy::CollisionFindingKind::Collision) {
443:                 continue;  // MarginViolation＝间距不足非碰撞（§7.4）——不淘汰
444:             }
445:             collided = true;
446:             CandidateCollisionRecord record;
447:             record.objectA = finding.objectA;  // policy 规范序 A<B（NFR-COR-05）
448:             record.objectB = finding.objectB;
449:             record.sampleIndex = finding.sampleIndex;
450:             record.pathParameter = finding.pathParameter;  // PathSequence 必填（TRJ-04）
451:             result.records.push_back(std::move(record));
452:         }
453:         // coverage 完整性说明（§10.4"coverage 完整"）：段内样本的全对查询
454:         // 事实由 policy coverage 记录承载；几何缺口（pairsWithGeometry<
455:         // pairsInScope）policy 侧已以 POLICY-CLL-GEOMETRY-MISSING 显式化
456:         // （走 Failed→DataInsufficient 分支），此处不重复判定。
457:         result.outcome = collided ? ReviewOutcome::Collision : ReviewOutcome::Passed;
458:         return result;
459:     }
460:     result.outcome = ReviewOutcome::DataInsufficient;  // 不可采信——KIN-05
461:     return result;
462: }

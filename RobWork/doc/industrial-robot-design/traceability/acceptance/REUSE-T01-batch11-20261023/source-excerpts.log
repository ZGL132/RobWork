trajectory.Planner.doSetLog
155:     /// @brief 日志句柄注入（QConstraint 纯虚的空实现——本适配器零日志
156:     /// 面适配：诊断产出归 policy 会话与评估器组装面，规划约束层不重复
157:     /// 记录；NFR-MNT-03 单一权威）。
158:     void doSetLog(rw::core::Log::Ptr) override {}
159: 
160:     /// @brief 单构型碰撞判定（QConstraint 契约的实现点——适配语义见类注）。
161:     bool doInCollision(const rw::math::Q& q) const override

trajectory.Planner.doInCollision
158:     void doSetLog(rw::core::Log::Ptr) override {}
159: 
160:     /// @brief 单构型碰撞判定（QConstraint 契约的实现点——适配语义见类注）。
161:     bool doInCollision(const rw::math::Q& q) const override
162:     {
163:         // 第一步：装配 SingleState 查询（kind 与样本数匹配契约——恰 1 个
164:         // 构型且 pathParameters 为空，policy §6.2；违约由 evaluate 入口
165:         // fail-fast——本适配器保证不触雷）。
166:         policy::CollisionQuery query;
167:         query.kind = policy::CollisionQueryKind::SingleState;
168:         query.configurations = {q};
169:         // stopAtFirstFinding＝筛选/淘汰场景（§6.2 字段语义——单构型查询
170:         // 的对逐对查询可在首个发现即停；输出仍带 coverage）。
171:         query.stopAtFirstFinding = true;
172: 
173:         // 第二步：直穿会话评估（会话构造后只读——并发只读安全由会话
174:         // backendQueryMutex 保证，policy §9.3；本适配器零额外同步）。
175:         const policy::CollisionEvaluation evaluation = m_session->evaluate(query, m_ctx);
176: 
177:         // 第三步：三态映射（仅"Completed＋Applicable＋finalized"可采信）。
178:         if (evaluation.status == policy::CollisionEvaluationStatus::Completed
179:             && evaluation.finalized
180:             && evaluation.applicability == policy::ScopeApplicability::Applicable) {
181:             for (const policy::CollisionFinding& finding : evaluation.findings) {
182:                 // 仅 Collision 种类构成碰撞（MarginViolation 非碰撞——§7.4）。
183:                 if (finding.kind == policy::CollisionFindingKind::Collision) {
184:                     return true;  // 碰撞→剪枝（§10.3 流程图"碰撞→剪枝"）
185:                 }
186:             }
187:             return false;  // 无碰撞发现→扩展继续
188:         }
189:         // 不可采信（finalized=false / EmptyScope / DisabledByPolicy）——
190:         // 保守"碰撞"＋观测计数（KIN-05：绝不视为无碰撞）。
191:         ++untrustedObserved;
192:         return true;
193:     }
194: 
195: private:
196:     /// 碰撞会话（共享只读——④端口唯一碰撞权威）。

trajectory.Planner.parsePlannerSelection
232:  * （D-TRJ-5 数值零自设纪律的规划器侧形态）；缺键＝配置不完整＝调用方
233:  * 违约，拒绝而不是猜。
234:  */
235: PlannerTuning parsePlannerSelection(const std::string& familyToken,
236:                                     const std::map<std::string, std::string>& params)
237: {
238:     // 1. family 词表（§10.2 封闭词表——词表外拒绝，不猜测）。
239:     if (familyToken != kTrjPlannerFamilyRrtConnect) {
240:         throw TrajectoryError("trajectory/planner/selection-family",
241:                               "规划器 family 不在登记词表（当前唯一实现值 "
242:                               "rrt-connect），实际值: " + familyToken);
243:     }
244:     // 2. 参数键白名单（未知键拒绝——键集合封闭，§10.2"逐键登记"）。
245:     for (const auto& entry : params) {
246:         if (entry.first != kTrjPlannerParamExtend
247:             && entry.first != kTrjPlannerParamEdgeResolution
248:             && entry.first != kTrjPlannerParamCandidateAttempts) {
249:             throw TrajectoryError("trajectory/planner/selection-param-key",
250:                                   "规划器参数键不在白名单（extend / edge-resolution / "
251:                                   "candidate-attempts），实际键: " + entry.first);
252:         }
253:     }
254:     // 3. 逐键取值与合法域（三键必备——缺键拒绝，不补默认）。
255:     PlannerTuning tuning;
256:     const auto readDouble = [&](const char* key) {
257:         const auto it = params.find(key);
258:         if (it == params.end()) {
259:             throw TrajectoryError("trajectory/planner/selection-param-missing",
260:                                   "规划器参数缺键（三键必填）: " + std::string{key});
261:         }
262:         try {
263:             const std::string& text = it->second;
264:             // std::stod 消费前缀——校验"整串可解析"（尾随非法字符拒绝）。
265:             std::size_t consumed = 0;
266:             const double value = std::stod(text, &consumed);
267:             if (consumed != text.size()) {
268:                 throw std::invalid_argument("trailing");
269:             }
270:             return value;
271:         } catch (const std::exception&) {
272:             throw TrajectoryError("trajectory/planner/selection-param-value",
273:                                   "规划器参数值不是合法数值: " + std::string{key}
274:                                       + " = " + it->second);
275:         }
276:     };
277:     tuning.extend = readDouble(kTrjPlannerParamExtend);
278:     tuning.resolution = readDouble(kTrjPlannerParamEdgeResolution);
279:     if (!(tuning.extend > 0.0) || !std::isfinite(tuning.extend)) {
280:         throw TrajectoryError("trajectory/planner/selection-param-value",
281:                               "规划器扩展步长 extend 必须为有限正数（rad|m），实际: "
282:                                   + std::to_string(tuning.extend));
283:     }
284:     if (!(tuning.resolution > 0.0) || !std::isfinite(tuning.resolution)) {
285:         throw TrajectoryError("trajectory/planner/selection-param-value",
286:                               "规划器边检查分辨率 edge-resolution 必须为有限正数"
287:                               "（rad|m），实际: " + std::to_string(tuning.resolution));
288:     }
289:     const double attemptsRaw = readDouble(kTrjPlannerParamCandidateAttempts);
290:     if (!(attemptsRaw >= 1.0) || attemptsRaw != std::floor(attemptsRaw)
291:         || attemptsRaw > static_cast<double>(std::numeric_limits<std::uint32_t>::max())) {
292:         throw TrajectoryError("trajectory/planner/selection-param-value",
293:                               "规划器候选轮数 candidate-attempts 必须为正整数（≥1），"
294:                               "实际: " + std::to_string(attemptsRaw));
295:     }
296:     tuning.attempts = static_cast<std::uint32_t>(attemptsRaw);
297:     return tuning;
298: }
299: 
300: /**
301:  * @brief 构型对与评价区间的公共校验（适配器/编排层共用——同一违约同一

trajectory.Planner.validateConfigPairAndBounds
307:  * 素材的归口是 PTP 层端点守卫 §7.4/V-03，本层重复产码会破坏唯一判定点
308:  * 纪律）。
309:  */
310: void validateConfigPairAndBounds(const rw::math::Q& fromQ, const rw::math::Q& toQ,
311:                                  const rw::math::Q& lowerBoundQ,
312:                                  const rw::math::Q& upperBoundQ,
313:                                  const char* errorTokenPrefix)
314: {
315:     const std::size_t dof = fromQ.size();
316:     if (toQ.size() != dof || lowerBoundQ.size() != dof || upperBoundQ.size() != dof) {
317:         throw TrajectoryError(errorTokenPrefix, "起终点构型与评价区间维度不一致");
318:     }
319:     for (std::size_t i = 0; i < dof; ++i) {
320:         if (!(lowerBoundQ[i] < upperBoundQ[i])) {
321:             throw TrajectoryError(errorTokenPrefix,
322:                                   "评价区间逐轴必须 lower<upper，轴 " + std::to_string(i)
323:                                       + " 实际: [" + std::to_string(lowerBoundQ[i]) + ", "
324:                                       + std::to_string(upperBoundQ[i]) + "]");
325:         }
326:     }
327:     for (std::size_t i = 0; i < dof; ++i) {
328:         if (!std::isfinite(fromQ[i]) || !std::isfinite(toQ[i])) {
329:             throw TrajectoryError(errorTokenPrefix,
330:                                   "端点构型含非有限分量（rad|m），轴 "
331:                                       + std::to_string(i));
332:         }
333:         if (fromQ[i] < lowerBoundQ[i] || fromQ[i] > upperBoundQ[i]
334:             || toQ[i] < lowerBoundQ[i] || toQ[i] > upperBoundQ[i]) {
335:             throw TrajectoryError(errorTokenPrefix,
336:                                   "端点构型越出评价区间（调用方前置违约——§15.1），轴 "
337:                                       + std::to_string(i));
338:         }
339:     }
340: }

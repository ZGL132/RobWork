39: GenerationBatch SeededLhsGenerator::generateNextBatch(const GenerationContext& ctx)
40: {
41:     // 取消位先行（§12.2 @cancellation——空批＋cancelled，不产出部分批；
42:     // 生成批是不可分的确定性整体）。
43:     if (ctx.cancellationRequested) {
44:         GenerationBatch batch;
45:         batch.cancelled = true;
46:         return batch;
47:     }
48:     // 单批策略代序语义：第 0 代产出全部邻域/采样候选；>0 代已无候选
49:     // （多代推进消费归 §8.5/WP-21-T03——本批不伪造"再来一代"的语义）。
50:     if (ctx.generationIndex > 0U) {
51:         GenerationBatch batch;
52:         batch.exhausted = true;
53:         return batch;
54:     }
55:     // 候选批逐字节委托 WP-20-T06 生成函数（单一实现点——splitmix64/层置换/
56:     // 采样域收缩/基线恒首全部在其内，本类零算法复制零行为漂移）。
57:     GenerationBatch batch;
58:     batch.candidates = generateSeededLhsCandidates(ctx.config);
59:     batch.exhausted = true;  // 全批一次产出——单批策略
60:     return batch;
61: }

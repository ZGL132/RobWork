247: 
248: GenerationBatch generateWithBuiltInStrategy(const std::string& strategyId,
249:                                             const GenerationContext& ctx,
250:                                             const BaselinePerturbParams& perturbParams)
251: {
252:     // 词表核对（与 validateConfiguration 检查⑨同源——同一 builtInStrategyIds
253:     // 单点）：未登记 token 在此同样拒绝（直调本函数绕过配置校验的防线），
254:     // 消息含已实现词表全文（ERR-01 定位纪律）。
255:     const auto& vocab = builtInStrategyIds();
256:     const bool registered = std::find(vocab.begin(), vocab.end(), strategyId)
257:                             != vocab.end();
258:     if (!registered) {
259:         std::string vocabText;
260:         for (const auto& v : vocab) {
261:             if (!vocabText.empty()) {
262:                 vocabText += "／";
263:             }
264:             vocabText += std::string(v);
265:         }
266:         throw OptimizationError(
267:             kOptInputInvalid,
268:             "OPT-INPUT-INVALID: strategyId=\"" + strategyId + "\" 未登记（已实现"
269:             "策略词表：" + vocabText
270:                 + "——新策略按 OPT-10 扩展点注册：实现 ICandidateGenerator＋词表"
271:                   "登记随单元卡增量修订留痕）");
272:     }
273: 
274:     // 分派（token 逐一比对——词表规模小，直排比对即确定性唯一路径）。
275:     if (strategyId == std::string(kStrategySeededLhs)) {
276:         return SeededLhsGenerator{}.generateNextBatch(ctx);
277:     }
278:     // baseline-perturb：携带调用方策略配置面（缺省＝冻结比例 0.01）。
279:     return BaselinePerturbGenerator{perturbParams}.generateNextBatch(ctx);
280: }

    double f64()
    {
        std::uint64_t bits = 0;
        for (int i = 0; i < 8; ++i) {
            std::uint8_t b = 0;
            raw(&b, 1);
            bits |= static_cast<std::uint64_t>(b) << (8 * i);
        }
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));

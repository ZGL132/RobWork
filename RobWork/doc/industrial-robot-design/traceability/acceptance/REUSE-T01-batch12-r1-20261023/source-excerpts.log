513: 
514: bool JsonValue::deepEquals(const JsonValue& o) const
515: {
516:     if (kind != o.kind) { return false; }
517:     switch (kind) {
518:     case Kind::Null:   return true;
519:     case Kind::Bool:   return boolean == o.boolean;
520:     case Kind::Number: {
521:         // 按位比较（确定性口径：-0.0 与 0.0 视为不同——序列化输出本就不同）。
522:         if (std::isnan(number) || std::isnan(o.number)) { return false; }
523:         return std::memcmp(&number, &o.number, sizeof(double)) == 0;
524:     }
525:     case Kind::String: return text == o.text;
526:     case Kind::Array:
527:         if (items.size() != o.items.size()) { return false; }
528:         for (std::size_t i = 0; i < items.size(); ++i) {
529:             if (!items[i].deepEquals(o.items[i])) { return false; }
530:         }
531:         return true;
532:     case Kind::Object: {
533:         // 语义等价：键集相同且逐键值相等（键序无关——dump 层才保证插入序）。
534:         if (members.size() != o.members.size()) { return false; }
535:         for (const auto& kv : members) {
536:             const JsonValue* other = o.find(kv.first);
537:             if (other == nullptr || !kv.second.deepEquals(*other)) { return false; }
538:         }
539:         return true;
540:     }
541:     }
542:     return false;
543: }

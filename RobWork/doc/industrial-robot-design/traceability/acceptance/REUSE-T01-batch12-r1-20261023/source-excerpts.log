112:     // ---- 值解析（depth 防栈溢出） ----
113:     JsonValue parseValue(std::size_t depth)
114:     {
115:         if (depth > kMaxDepth) {
116:             fail("嵌套超过 " + std::to_string(kMaxDepth) + " 层（拒绝深嵌套）");
117:         }
118:         skipWs();
119:         if (eof()) {
120:             fail("值位置意外到达文本末尾");
121:         }
122:         switch (peek()) {
123:         case '{': return parseObject(depth);
124:         case '[': return parseArray(depth);
125:         case '"': {
126:             JsonValue v;
127:             v.kind = JsonValue::Kind::String;
128:             v.text = parseString();
129:             return v;
130:         }
131:         case 't': expectLiteral("true"); {
132:             JsonValue v; v.kind = JsonValue::Kind::Bool; v.boolean = true; return v;
133:         }
134:         case 'f': expectLiteral("false"); {
135:             JsonValue v; v.kind = JsonValue::Kind::Bool; v.boolean = false; return v;
136:         }
137:         case 'n': expectLiteral("null"); {
138:             JsonValue v; v.kind = JsonValue::Kind::Null; return v;
139:         }
140:         default:
141:             // 数字或非法字面（NaN/Infinity/注释等在此给出针对性消息）。
142:             if (peek() == '-' || (peek() >= '0' && peek() <= '9')) {
143:                 return parseNumber();
144:             }
145:             if (peek() == 'N') { fail("NaN 字面被拒绝（受限格式不收非有限数）"); }
146:             if (peek() == 'I') { fail("Infinity 字面被拒绝"); }
147:             if (peek() == '/') { fail("注释被拒绝（// 与 /* 均不收——受限格式无注释）"); }
148:             fail(std::string{"非法值起始字符: '"} + peek() + "'");
149:         }
150:     }

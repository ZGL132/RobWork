80: void StoreCloseSupervisor::stop() noexcept

workflow.CloseSupervisor.StoreCloseSupervisor.stop sdurws::ird::workflow::StoreCloseSupervisor::stop
78: }
79: 
80: void StoreCloseSupervisor::stop() noexcept
81: {
82:     // 恒收敛（不以 running 位为跳过条件——监督循环的自然退出路径先置
83:     // 观测位后收尾〔放弃日志在 running 清位之后仍有写入〕，stop 若见
84:     // running==false 即跳过 join 会与收尾竞态：主线程在放弃日志写入前
85:     // 读快照——留痕丢失）。未启动＝线程对象不 joinable＝天然 no-op；
86:     // 重复调用＝二次 joinable 已 false＝幂等。
87:     m_stopRequested.store(true, std::memory_order_release);
88:     if (m_thread.joinable()) {
89:         m_thread.join();  // 阻塞至监督循环完全退出——返回后观测位/日志
90:                           // 全部可见（线程收尾 happens-before join 返回）
91:     }
92:     m_running.store(false, std::memory_order_release);
93: }

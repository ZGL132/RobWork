testkit.ProcessRunner.EventWatch.awaitFile sdurws::ird::testkit::EventWatch::awaitFile
604:  * @return true＝时限内出现；false＝时限内未出现（调用方裁决为测试失败）
605:  */
606: bool EventWatch::awaitFile(const std::filesystem::path& marker,
607:                            std::chrono::milliseconds deadline)
608: {
609:     const auto deadlinePoint = Clock::now() + deadline;
610:     for (;;) {
611:         std::error_code probeError;  // exists() 失败不抛——按"本轮未出现"续轮询
612:         if (fs::exists(marker, probeError)) {
613:             return true;
614:         }
615:         if (Clock::now() >= deadlinePoint) {
616:             return false;  // 有界等待的出口：到点即返，绝不无限等待
617:         }
618:         std::this_thread::sleep_for(kPollInterval);
619:     }
620: }
621: 
622: /**

testkit.ProcessRunner.EventWatch.awaitLineInFile sdurws::ird::testkit::EventWatch::awaitLineInFile
637:  * @throws TestKitError(Usage) needle 为空串（任何文件都命中＝等待语义失效）
638:  */
639: bool EventWatch::awaitLineInFile(const std::filesystem::path& log,
640:                                  std::string_view needle,
641:                                  std::chrono::milliseconds deadline)
642: {
643:     if (needle.empty()) {
644:         throw TestKitError(TestKitErrorKind::Usage,
645:                            "EventWatch::awaitLineInFile：needle 为空串——空串在任何"
646:                            "文件都命中，等待语义无意义，属调用方装配错误");
647:     }
648:     const auto deadlinePoint = Clock::now() + deadline;
649:     for (;;) {
650:         std::error_code probeError;
651:         if (fs::exists(log, probeError)) {
652:             // 二进制模式打开：只做字节级行切分，不做任何文本翻译（编码无关注）。
653:             std::ifstream in{log, std::ios::binary};
654:             std::string line;
655:             while (std::getline(in, line)) {
656:                 if (line.find(needle) != std::string::npos) {
657:                     return true;
658:                 }
659:             }
660:         }
661:         if (Clock::now() >= deadlinePoint) {
662:             return false;
663:         }
664:         std::this_thread::sleep_for(kPollInterval);
665:     }
666: }

testkit.ProcessRunner.DestructorImpl sdurws::ird::testkit::TestProcessRunner::Impl::~Impl
273:     bool hasCached = false;                 ///< 缓存有效标志（cached 本身有合法零值，不能当标志用）
274: 
275:     ~Impl()
276:     {
277:         // 顺序敏感：先关 Job（内核在此兜底杀树——KILL_ON_JOB_CLOSE），再关
278:         // 进程句柄；TempDir 成员随后析构删目录，此时子进程已不可能存活。
279:         if (hJob != nullptr) {
280:             ::CloseHandle(hJob);
281:             hJob = nullptr;
282:         }
283:         if (hProcess != nullptr) {
284:             ::CloseHandle(hProcess);
285:             hProcess = nullptr;
286:         }
287:     }
288: };

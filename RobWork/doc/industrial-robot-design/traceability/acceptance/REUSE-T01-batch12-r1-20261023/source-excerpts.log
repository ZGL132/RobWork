139:  * @return Win32 等待毫秒数（0/正数/INFINITE）
140:  */
141: DWORD toWin32Wait(std::chrono::milliseconds ms) noexcept
142: {
143:     if (ms.count() <= 0) {
144:         return 0;  // deadline 已过：轮询等待立即返回（超时路径由调用方裁决）
145:     }
146:     constexpr auto kInfiniteMinus1 = std::chrono::milliseconds{0xFFFFFFFE};
147:     if (ms >= kInfiniteMinus1) {
148:         return INFINITE;  // 天文值钳制——语义仍是"等到为止"，不改变调用方意图
149:     }
150:     return static_cast<DWORD>(ms.count());
151: }

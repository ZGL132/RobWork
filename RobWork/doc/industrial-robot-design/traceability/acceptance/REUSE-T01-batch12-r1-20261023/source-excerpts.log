25: StoreCloseSupervisor::StoreCloseSupervisor(project::ProjectStore& store,
26:                                            execution::TaskScheduler& scheduler,
27:                                            Config config,
28:                                            diagnostics::IDevLogSink* devLog,
29:                                            ClockFn clock)
30:     : m_store(store)
31:     , m_scheduler(scheduler)
32:     , m_config(config)
33:     , m_devLog(devLog)
34:     , m_clock(std::move(clock))
35: {
36:     // 装配违约 fail-fast（§10.3 错误语义行——零/负阈值无监督语义；WorkflowError
37:     // 前缀 "workflow/caller-contract:" 由类型自带）。
38:     if (m_config.abandonThreshold <= std::chrono::milliseconds::zero()) {
39:         throw WorkflowError("关闭监督器兜底阈值必须为正（abandonThreshold>0）");
40:     }
41:     if (m_config.giveUpGrace <= std::chrono::milliseconds::zero()) {
42:         throw WorkflowError("关闭监督器放弃宽限必须为正（giveUpGrace>0）");
43:     }
44:     if (m_config.pollInterval <= std::chrono::milliseconds::zero()) {
45:         throw WorkflowError("关闭监督器轮询拍间隔必须为正（pollInterval>0）");
46:     }
47: }

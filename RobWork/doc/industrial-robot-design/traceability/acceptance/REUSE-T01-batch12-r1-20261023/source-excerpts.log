95: void StoreCloseSupervisor::superviseLoop()
96: {
97:     // 阈值计时起点（t0＝start 时刻——Config.abandonThreshold 的量度基准）。
98:     const auto now = [this] {
99:         return m_clock ? m_clock()
100:                        : std::chrono::steady_clock::now();
101:     };
102:     const auto t0 = now();
103:     const auto tDiag = t0 + m_config.abandonThreshold;  // ②段兜底诊断时点
104:     const auto tGiveUp = tDiag + m_config.giveUpGrace;  // ③段放弃监督时点
105:     bool abandonDiagWritten = false;  // ③段一次性标志（Dev 日志恰一条）
106: 
107:     // 监督循环（①~④序——头文件 start() 注）：**先观测后查停止**——
108:     // 循环体首拍必须完成闭合观测再让位给 stop 请求（宿主 start 后立即
109:     // stop 的短会话形态下，闭合事实不被停止请求吞掉；此后每拍同序）。
110:     // 线程约束澄清（tick 单线程域）：调度推进（TaskScheduler::tick——
111:     // 取消协议/排空监视/自动兜底的推进泵）归宿主**调度循环线程**（真实
112:     // 宿主形态：关闭期间调度循环持续 tick——Scheduler.hpp"tick 仅调度域
113:     // 单线程"）；本监督线程**只观测不驱动**（并发 tick＝锁域违例——
114:     // 实测会死锁），这正是"编排线程只观察不推进"（Lifecycle.cpp
115:     // awaitStoreClosed 同款纪律）的监督面表达。
116:     //   ① store 已闭合 → 记观测退出（关闭完成——监督成功收场）；
117:     //   ② 越兜底阈值仍未闭合 → 一次性 Dev 日志（"残留会话"告知——project
118:     //      §9.7 登记义务：强制 abandonAll 已由宿主调度循环的排空自动兜底
119:     //      承载，本日志承载"若仍未闭合说明存在非任务侧在途引用"的诚实
120:     //      告知）；
121:     //   ③ 越放弃宽限仍未闭合 → Dev 日志＋放弃退出（不阻塞进程退出——
122:     //      project §9.7 原文义务；非任务侧引用〔在途命令/草稿保存〕不是
123:     //      abandon 处置面，监督不能替它清零，如实留痕后退出）；
124:     //   ④ stop() 请求 → 退出（宿主主动收敛——run 返回后的正常路径）。
125:     while (true) {
126:         // ① 闭合观测（closed() 为内部互斥快照查询——并发安全）。
127:         if (m_store.closed()) {
128:             m_storeClosedObserved.store(true, std::memory_order_release);
129:             m_running.store(false, std::memory_order_release);
130:             return;
131:         }
132: 
133:         // ④ 停止请求（在闭合观测**之后**检查——首拍观测优先语义）。
134:         if (m_stopRequested.load(std::memory_order_acquire)) {
135:             break;
136:         }
137: 
138:         const auto t = now();
139: 
140:         // ② 兜底诊断（一次性——超阈值瞬间恰一条，不逐拍刷屏）。
141:         if (!abandonDiagWritten && t >= tDiag) {
142:             abandonDiagWritten = true;
143:             m_abandonDiagObserved.store(true, std::memory_order_release);
144:             if (m_devLog != nullptr) {
145:                 m_devLog->logDev(
146:                     kCloseSupervisorChannel,
147:                     "关闭排空超阈值仍未闭合：强制 abandonAll(ForceTerminated) "
148:                     "已由排空编排自动兜底承载；若存储上下文仍未闭合，说明存在"
149:                     "非任务侧在途引用（在途命令/草稿保存）——继续监督至宽限");
150:             }
151:         }
152: 
153:         // ③ 放弃监督（不阻塞进程退出——§9.7 原文义务）。路径序：先
154:         // 置观测位（宿主 wait-gaveUp 循环的释放面）→**写日志**→清
155:         // running→return——日志写入先于线程退出，join 返回后必然可见。
156:         if (t >= tGiveUp) {
157:             m_gaveUp.store(true, std::memory_order_release);
158:             if (m_devLog != nullptr) {
159:                 m_devLog->logDev(
160:                     kCloseSupervisorChannel,
161:                     "关闭监督放弃：宽限期内存储上下文仍未闭合（非任务侧在途"
162:                     "引用未释放）——残留事实已留痕，监督退出不阻塞进程退出；"
163:                     "请人工核查在途命令/草稿保存持有者");
164:             }
165:             m_running.store(false, std::memory_order_release);
166:             return;
167:         }
168: 
169:         // 拍间隔（awaitStoreClosed 同款 1 ms 拍频——避免忙等烧核；clock
170:         // 注入形态下的真实睡眠与虚拟推进解耦：测试用短阈值＋真实拍频）。
171:         std::this_thread::sleep_for(m_config.pollInterval);
172:     }
173: 
174:     // ④ stop() 请求退出——走到此处即宿主主动收敛（闭合与否以观测位为
175:     // 准——m_storeClosedObserved 只在真实观测到 closed() 时置位）。
176:     m_running.store(false, std::memory_order_release);
177: }

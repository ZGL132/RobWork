testkit.ProcessRunner.utf8ToWide (anonymous namespace)::utf8ToWide
163:  * @throws TestKitError(EnvUnavailable) 转换失败（非法 UTF-8 序列等）
164:  */
165: std::wstring utf8ToWide(const std::string& s)
166: {
167:     if (s.empty()) {
168:         return {};
169:     }
170:     const int need = ::MultiByteToWideChar(CP_UTF8, 0, s.data(),
171:                                            static_cast<int>(s.size()), nullptr, 0);
172:     if (need <= 0) {
173:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
174:                            "ProcessRunner：UTF-8→UTF-16 转换失败（输入串长 " +
175:                                std::to_string(s.size()) + "）");
176:     }
177:     std::wstring wide(static_cast<size_t>(need), L'\0');
178:     ::MultiByteToWideChar(CP_UTF8, 0, s.data(), static_cast<int>(s.size()),
179:                           wide.data(), need);
180:     return wide;
181: }

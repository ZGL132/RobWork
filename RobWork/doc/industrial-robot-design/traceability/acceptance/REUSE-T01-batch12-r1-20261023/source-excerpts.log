310: void TestProcessRunner::start(const ProcessSpec& spec, std::filesystem::path workingDir)
311: {
312:     // ---- 第 1 步：调用方契约检查（fail-fast——错误语义见头文件注释）----
313:     if (impl_ != nullptr) {
314:         throw TestKitError(TestKitErrorKind::Usage,
315:                            "TestProcessRunner::start：实例已启动过，不可重复 start"
316:                            "（同一实例一次生命周期；多进程用例请各用独立实例）");
317:     }
318:     if (spec.executable.empty()) {
319:         throw TestKitError(TestKitErrorKind::Usage,
320:                            "TestProcessRunner::start：ProcessSpec.executable 为空——"
321:                            "无可执行文件的启动请求属调用方装配错误");
322:     }
323: 
324:     // ---- 第 2 步：建立 Job Object 并启用"句柄关闭即杀树"----
325:     HANDLE hJob = ::CreateJobObjectW(nullptr, nullptr);
326:     if (hJob == nullptr) {
327:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
328:                            "TestProcessRunner::start：CreateJobObjectW 失败（GetLastError=" +
329:                                std::to_string(::GetLastError()) + "）");
330:     }
331:     JOBOBJECT_EXTENDED_LIMIT_INFORMATION jobLimit{};
332:     jobLimit.BasicLimitInformation.LimitFlags |= JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
333:     if (!::SetInformationJobObject(hJob, JobObjectExtendedLimitInformation,
334:                                    &jobLimit, sizeof(jobLimit))) {
335:         const DWORD err = ::GetLastError();
336:         ::CloseHandle(hJob);
337:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
338:                            "TestProcessRunner::start：SetInformationJobObject 失败"
339:                            "（GetLastError=" + std::to_string(err) +
340:                            "）——无 KILL_ON_JOB_CLOSE 兜底不允许继续");
341:     }
342: 
343:     // ---- 第 3 步：拼命令行与合并环境块（零继承句柄——事件同步走文件标记）----
344:     // bInheritHandles=FALSE 的原因：§6.5 把跨进程同步判据限定为可观察文件，
345:     // 子进程不需要继承任何句柄；不继承也杜绝了句柄泄漏进子进程的面。
346:     std::wstring cmdLine = detail::quoteWindowsArg(spec.executable.wstring());
347:     for (const std::string& rawArg : spec.args) {
348:         cmdLine += L' ';
349:         cmdLine += detail::quoteWindowsArg(utf8ToWide(rawArg));
350:     }
351:     std::wstring envBlock = buildEnvironmentBlock(spec.env);
352: 
353:     // workingDir 缺省语义（§6.5 签名注释"= TempDir"）：空路径→运行器持有
354:     // 的临时目录；显式路径则校验存在——把拼写错误挡在启动前（Usage）而不是
355:     // 让 CreateProcess 以晦涩的目录错误失败。局部经 unique_ptr 持有，启动
356:     // 成功后才移交 Impl——启动失败路径上临时目录照常 RAII 清理。
357:     std::unique_ptr<TempDir> ownedDir;
358:     if (workingDir.empty()) {
359:         ownedDir = std::make_unique<TempDir>("procrunner-wd");   // 构造即建立（§6.2）
360:         workingDir = ownedDir->path();
361:     } else if (!fs::exists(workingDir)) {
362:         ::CloseHandle(hJob);
363:         throw TestKitError(TestKitErrorKind::Usage,
364:                            "TestProcessRunner::start：workingDir 不存在（" +
365:                                workingDir.string() + "）——调用方须先建目录");
366:     }
367: 
368:     // ---- 第 4 步：挂起态启动子进程 ----
369:     STARTUPINFOW si{};
370:     si.cb = sizeof(si);
371:     PROCESS_INFORMATION pi{};
372:     const BOOL created = ::CreateProcessW(
373:         nullptr,                        // lpApplicationName 空：由命令行首段解析模块路径
374:         cmdLine.data(),                 // 可写缓冲（CreateProcessW 会原位改写）
375:         nullptr, nullptr,               // 安全属性：默认（句柄不继承，见上）
376:         FALSE,                          // bInheritHandles：不继承
377:         CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT,
378:         envBlock.data(),                // 合并环境块（双 NUL 结尾）
379:         workingDir.wstring().c_str(),   // 子进程当前工作目录
380:         &si, &pi);
381:     if (!created) {
382:         const DWORD err = ::GetLastError();
383:         ::CloseHandle(hJob);
384:         // 可执行文件路径拼错也走这里（ERROR_FILE_NOT_FOUND）——归环境错误
385:         // 而非 Usage：无法与"路径存在但被占用/被杀毒拦截"区分前不预判调用方。
386:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
387:                            "TestProcessRunner::start：CreateProcessW 失败"
388:                            "（GetLastError=" + std::to_string(err) + "，命令行首段=" +
389:                            spec.executable.string() + "）");
390:     }
391: 
392:     // ---- 第 5 步：绑定 Job（失败即终止已创建进程——不许留 Job 外孤儿）----
393:     if (!::AssignProcessToJobObject(hJob, pi.hProcess)) {
394:         const DWORD err = ::GetLastError();
395:         ::TerminateProcess(pi.hProcess, kForcedExitCode);
396:         ::CloseHandle(pi.hThread);
397:         ::CloseHandle(pi.hProcess);
398:         ::CloseHandle(hJob);
399:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
400:                            "TestProcessRunner::start：AssignProcessToJobObject 失败"
401:                            "（GetLastError=" + std::to_string(err) +
402:                            "）——已终止未受管束的子进程");
403:     }
404: 
405:     // ---- 第 6 步：恢复执行；状态就位 ----
406:     if (::ResumeThread(pi.hThread) == static_cast<DWORD>(-1)) {
407:         const DWORD err = ::GetLastError();
408:         ::TerminateJobObject(hJob, kForcedExitCode);  // 树终止——孙进程也一并处理
409:         ::CloseHandle(pi.hThread);
410:         ::CloseHandle(pi.hProcess);
411:         ::CloseHandle(hJob);
412:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
413:                            "TestProcessRunner::start：ResumeThread 失败"
414:                            "（GetLastError=" + std::to_string(err) + "）——已终止子进程树");
415:     }
416:     ::CloseHandle(pi.hThread);  // 主线程句柄不再需要（等待只挂 hProcess）
417: 
418:     impl_ = new Impl();
419:     impl_->hProcess = pi.hProcess;
420:     impl_->hJob = hJob;
421:     impl_->startedAt = Clock::now();
422:     impl_->timeout = spec.timeout;
423:     impl_->ownedWorkingDir = std::move(ownedDir);
424: }
425: 
426: /**

testkit.ProcessRunner.TestProcessRunner.outcome sdurws::ird::testkit::TestProcessRunner::outcome
441:  *                                       超上限仍不退出（环境异常不静默）
442:  */
443: ProcessOutcome TestProcessRunner::outcome()
444: {
445:     if (impl_ == nullptr) {
446:         throw TestKitError(TestKitErrorKind::Usage,
447:                            "TestProcessRunner::outcome：未 start 即取结果——"
448:                            "调用方契约违约（fail-fast）");
449:     }
450:     // 幂等重入：终结结果只判定一次，重复调用返回缓存（消费方常在断言后再
451:     // 调 outcome 收尾，双态返回会让两次断言互相矛盾）。
452:     if (impl_->hasCached) {
453:         return impl_->cached;
454:     }
455: 
456:     auto& im = *impl_;
457: 
458:     // ---- 路径一：kill() 已请求终止 → 等真退出，报 Killed ----
459:     if (im.phase == Impl::Phase::KilledByRequest) {
460:         const DWORD wait = ::WaitForSingleObject(
461:             im.hProcess, toWin32Wait(kTerminateJoinTimeout));
462:         if (wait != WAIT_OBJECT_0) {
463:             // 终止请求已发出却久不退出（WAIT_TIMEOUT/FAILED）：环境异常，
464:             // 静默报 Killed 会掩盖"进程树没死"的严重事实。
465:             throw TestKitError(TestKitErrorKind::EnvUnavailable,
466:                                "TestProcessRunner::outcome：kill 后子进程未在上限内退出"
467:                                "（wait=" + std::to_string(wait) + "）");
468:         }
469:         im.cached.kind = ProcessExitKind::Killed;
470:         im.cached.exitCode = 0;  // 冻结语义：非 Exited 形态 exitCode 恒 0
471:         im.cached.duration = std::chrono::duration_cast<std::chrono::milliseconds>(
472:             im.killedAt - im.startedAt);  // 进程存活时长到 kill 请求时刻为止
473:         im.hasCached = true;
474:         im.phase = Impl::Phase::Completed;
475:         return im.cached;
476:     }
477: 
478:     // ---- 路径二：正常等待（Running）——deadline＝start＋timeout 的剩余时间 ----
479:     const auto deadline = im.startedAt + im.timeout;
480:     const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
481:         deadline - Clock::now());
482:     const DWORD wait = ::WaitForSingleObject(im.hProcess, toWin32Wait(remaining));
483: 
484:     if (wait == WAIT_FAILED) {
485:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
486:                            "TestProcessRunner::outcome：WaitForSingleObject 失败"
487:                            "（GetLastError=" + std::to_string(::GetLastError()) + "）");
488:     }
489: 
490:     if (wait == WAIT_OBJECT_0) {
491:         // 进程已退出：按退出码二分（§6.5——0＝正常完成事件；非 0＝崩溃，
492:         // 覆盖 exit(N) 与访问违例等异常码两种"崩溃注入"形态）。
493:         DWORD code = 0;
494:         if (!::GetExitCodeProcess(im.hProcess, &code)) {
495:             throw TestKitError(TestKitErrorKind::EnvUnavailable,
496:                                "TestProcessRunner::outcome：GetExitCodeProcess 失败"
497:                                "（GetLastError=" + std::to_string(::GetLastError()) + "）");
498:         }
499:         if (code == 0) {
500:             im.cached.kind = ProcessExitKind::Exited;
501:             im.cached.exitCode = 0;  // 唯一携带真实码的形态（此处码必为 0）
502:         } else {
503:             im.cached.kind = ProcessExitKind::Crashed;
504:             im.cached.exitCode = 0;  // 冻结语义：Crashed 不携带码（信息走测试日志）
505:         }
506:     } else {
507:         // WAIT_TIMEOUT：deadline 内未见完成事件 → 先杀树再报告
508:         // TerminatedByTimeout（§6.5"超时→终止进程树后返回"的顺序即在此处）。
509:         if (!::TerminateJobObject(im.hJob, kForcedExitCode)) {
510:             throw TestKitError(TestKitErrorKind::EnvUnavailable,
511:                                "TestProcessRunner::outcome：超时后 TerminateJobObject 失败"
512:                                "（GetLastError=" + std::to_string(::GetLastError()) + "）");
513:         }
514:         const DWORD joined = ::WaitForSingleObject(
515:             im.hProcess, toWin32Wait(kTerminateJoinTimeout));
516:         if (joined != WAIT_OBJECT_0) {
517:             throw TestKitError(TestKitErrorKind::EnvUnavailable,
518:                                "TestProcessRunner::outcome：超时终止后子进程未在上限内退出"
519:                                "（wait=" + std::to_string(joined) + "）");
520:         }
521:         im.cached.kind = ProcessExitKind::TerminatedByTimeout;
522:         im.cached.exitCode = 0;  // 冻结语义：超时形态不携带码
523:     }
524: 
525:     // duration＝从 Resume 到"观察到终结"的墙钟时长（近似值，理由见头注释）。
526:     im.cached.duration = std::chrono::duration_cast<std::chrono::milliseconds>(
527:         Clock::now() - im.startedAt);
528:     im.hasCached = true;
529:     im.phase = Impl::Phase::Completed;
530:     return im.cached;
531: }
532: 
533: /**

testkit.ProcessRunner.TestProcessRunner.kill sdurws::ird::testkit::TestProcessRunner::kill
541:  * @throws TestKitError(EnvUnavailable)  TerminateJobObject 失败（杀树请求未受理）
542:  */
543: void TestProcessRunner::kill()
544: {
545:     if (impl_ == nullptr) {
546:         throw TestKitError(TestKitErrorKind::Usage,
547:                            "TestProcessRunner::kill：未 start 即终止——调用方契约违约");
548:     }
549:     if (impl_->hasCached) {
550:         return;  // 已终结：无进程可杀——幂等无操作（调用方无须预判状态）
551:     }
552:     if (impl_->phase == Impl::Phase::Running) {
553:         if (!::TerminateJobObject(impl_->hJob, kForcedExitCode)) {
554:             throw TestKitError(TestKitErrorKind::EnvUnavailable,
555:                                "TestProcessRunner::kill：TerminateJobObject 失败"
556:                                "（GetLastError=" + std::to_string(::GetLastError()) + "）");
557:         }
558:         impl_->phase = Impl::Phase::KilledByRequest;
559:         impl_->killedAt = Clock::now();
560:     }
561:     // phase == KilledByRequest：重复 kill——终止请求已发出，无需再发（幂等）。
562: }
563: 
564: /**

testkit.ProcessRunner.TestProcessRunner.DestructorTestProcessRunner sdurws::ird::testkit::TestProcessRunner::~TestProcessRunner
569:  * 继续跑，测试管线整体被污染。正常路径（已终结）这里只做句柄/目录释放。
570:  */
571: TestProcessRunner::~TestProcessRunner()
572: {
573:     if (impl_ == nullptr) {
574:         return;  // 未 start 过：无资源（构造函数零工作与之对称）
575:     }
576:     if (impl_->phase == Impl::Phase::Running) {
577:         // 先显式杀树（KILL_ON_JOB_CLOSE 是第二道内核兜底，双保险），并给
578:         // 最多 kTerminateJoinTimeout 让其退出——防止目录删除撞上仍在写的
579:         // 子进程。此处失败不抛（析构禁抛）：KILL_ON_JOB_CLOSE 仍会兜底。
580:         ::TerminateJobObject(impl_->hJob, kForcedExitCode);
581:         ::WaitForSingleObject(impl_->hProcess, toWin32Wait(kTerminateJoinTimeout));
582:     }
583:     delete impl_;  // Impl 析构：关句柄→析构缺省 TempDir（顺序见 Impl 注释）
584:     impl_ = nullptr;
585: }

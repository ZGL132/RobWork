59: 
60: CheckResult checkAllCloseWithin(std::string_view fieldPathTemplate,
61:                                 const std::vector<double>& actualSi,
62:                                 const std::vector<double>& referenceSi,
63:                                 core::Tolerance tolerance,
64:                                 std::string_view sourceTag) noexcept
65: {
66:     (void)sourceTag;
67:     CheckResult result;
68: 
69:     // 长度不匹配：失败并列出缺失/额外索引（§4.3.3 表——非异常，测试失败级）。
70:     // 缺失侧值以 NaN 占位（机器可读——非有限即显式缺失语义）。
71:     const std::size_t common = std::min(actualSi.size(), referenceSi.size());
72:     for (std::size_t i = 0; i < common; ++i) {
73:         // 逐元素 C4（防正负抵消——不以差值总和替代）。
74:         if (!core::closeWithin(actualSi[i], referenceSi[i], tolerance)) {
75:             std::string path{fieldPathTemplate};
76:             path += std::string("[");
77:             path += std::to_string(i);
78:             path += std::string("]");
79:             result.failures.push_back(
80:                 makeDetail(path, true, i, actualSi[i], referenceSi[i], tolerance));
81:             result.passed = false;
82:         }
83:     }
84:     if (actualSi.size() != referenceSi.size()) {
85:         // 额外索引逐条登记（较长侧的超出元素缺失对侧）。
86:         const auto& longer = actualSi.size() > referenceSi.size() ? actualSi : referenceSi;
87:         const bool actualLonger = actualSi.size() > referenceSi.size();
88:         for (std::size_t i = common; i < longer.size(); ++i) {
89:             CompareDetail d = makeDetail(std::string(fieldPathTemplate) + "[" + std::to_string(i) + "]",
90:                                          true, i, actualLonger ? longer[i] : 0.0,
91:                                          actualLonger ? 0.0 : longer[i], tolerance);
92:             d.actual = actualLonger ? longer[i] : std::nan("");
93:             d.expected = actualLonger ? std::nan("") : longer[i];
94:             result.failures.push_back(d);
95:             result.passed = false;
96:         }
97:     }
98:     return result;
99: }

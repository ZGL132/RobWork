workflow.CloseSupervisor.running sdurws::ird::workflow::StoreCloseSupervisor::running
160: 
161:     /// 监督线程是否在运行（start 后、stop/自然退出前为 true）。
162:     bool running() const noexcept { return m_running.load(std::memory_order_acquire); }
163: 
164:     /// 监督期间是否观测到 store 闭合（closed()——关闭完成的复核面）。
165:     bool storeClosedObserved() const noexcept
166:     {
167:         return m_storeClosedObserved.load(std::memory_order_acquire);
168:     }
169: 
170:     /// 监督期间是否触发过兜底诊断（超阈值仍未闭合——残留会话告知位）。
171:     bool abandonDiagObserved() const noexcept
172:     {
173:         return m_abandonDiagObserved.load(std::memory_order_acquire);
174:     }
175: 
176:     /// 监督是否以"放弃"收场（越放弃宽限仍未闭合——不阻塞进程退出的
177:     /// 诚实退出位；true 时宿主应把残留事实升级人工处置）。
178:     bool gaveUp() const noexcept { return m_gaveUp.load(std::memory_order_acquire); }

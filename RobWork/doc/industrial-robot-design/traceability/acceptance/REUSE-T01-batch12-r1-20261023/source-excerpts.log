101: CheckResult checkAtMost(std::string_view fieldPath, double actualSi, double boundSi,
102:                         std::string_view unit)
103: {
104:     CheckResult result;
105:     // 单位须已注册（§4.3.3 表：未注册→TestKitError(unit-mismatch)——数据集非法级）。
106:     const auto token = core::UnitToken::find(unit);
107:     if (!token.has_value()) {
108:         throw TestKitError(TestKitErrorKind::UnitMismatch,
109:                            "unit-mismatch: 单位未注册: " + std::string{unit});
110:     }
111:     if (nonFinite(actualSi) || nonFinite(boundSi)) {
112:         // 非有限上界/实际值：数据集非法级（§4.3.3 表——与容差失败不同分类）。
113:         throw TestKitError(TestKitErrorKind::UnitMismatch,
114:                            "unit-mismatch: atMost 输入非有限（NaN/±Inf）");
115:     }
116:     if (actualSi > boundSi) {
117:         core::Tolerance t = core::Tolerance::make(0.0, boundSi);
118:         result.failures.push_back(
119:             makeDetail(std::string{fieldPath}, false, 0, actualSi, boundSi, t));
120:         result.passed = false;
121:     }
122:     return result;
123: }

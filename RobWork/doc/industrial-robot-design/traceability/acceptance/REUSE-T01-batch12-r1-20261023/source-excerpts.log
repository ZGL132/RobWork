testkit.ProcessRunner.quoteWindowsArg sdurws::ird::testkit::detail::quoteWindowsArg
63:  * @return 可直接拼入命令行的参数串
64:  */
65: std::wstring quoteWindowsArg(const std::wstring& arg)
66: {
67:     // F-595：空串参数必须发射 ""——原实现原样返回空串，命令行里只留下
68:     // 一个空格，子进程 argv 丢失该参数且后续参数整体前移（位置型参数
69:     // 全部错位）。
70:     if (arg.empty()) {
71:         return L"\"\"";  // 空参数的规范形态（带引号的空串）
72:     }
73:     const bool needQuote = arg.find_first_of(L" \t\"") != std::wstring::npos;
74:     if (!needQuote) {
75:         return arg;  // 无特殊字符：原样拼接（绝大多数测试参数走此捷径）
76:     }
77:     std::wstring out{L'"'};
78:     size_t pendingBackslashes = 0;  // 当前连续反斜杠计数（遇非反斜杠或结尾时结算）
79:     for (const wchar_t c : arg) {
80:         if (c == L'\\') {
81:             ++pendingBackslashes;  // 先攒着——是否翻倍取决于后一个字符
82:             continue;
83:         }
84:         if (c == L'"') {
85:             // F-596：Windows 解析规则为 2N+1——引号前 N 个反斜杠全部翻
86:             // 倍（2N）再加一个转义引号的反斜杠（+1）。原实现发 N+1：
87:             // 含 \" 序列的参数（N≥1）在子进程端被吞掉一半反斜杠且引号
88:             // 被当分隔符——参数碎裂、引号状态翻转。
89:             out.append(2 * pendingBackslashes + 1, L'\\');
90:             out.push_back(L'"');
91:         } else {
92:             out.append(pendingBackslashes, L'\\');  // 普通字符：反斜杠原样
93:             out.push_back(c);
94:         }
95:         pendingBackslashes = 0;
96:     }
97:     // 结尾反斜杠也要翻倍（后面紧跟收尾引号，规则同"紧邻引号"）
98:     out.append(pendingBackslashes * 2, L'\\');
99:     out.push_back(L'"');
100:     return out;
101: }
102: 
103: }  // namespace sdurws::ird::testkit::detail


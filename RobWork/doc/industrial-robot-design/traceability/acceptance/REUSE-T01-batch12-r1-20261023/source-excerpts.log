testkit.ProcessRunner.buildEnvironmentBlock (anonymous namespace)::buildEnvironmentBlock
197:  * @throws TestKitError(EnvUnavailable) UTF-8 转换失败或父环境块不可得
198:  */
199: std::wstring buildEnvironmentBlock(const std::map<std::string, std::string>& overrides)
200: {
201:     std::map<std::wstring, std::wstring> merged;
202: 
203:     // 第一遍：父环境全量装入。GetEnvironmentStringsW 返回
204:     // "NAME=VALUE\0NAME=VALUE\0...\0" 的双 NUL 结尾块，逐条扫描。
205:     // 注意返回类型是非 const LPWCH——FreeEnvironmentStringsW 要求同一指针
206:     // 类型，不能用 const 接收。
207:     wchar_t* const parent = ::GetEnvironmentStringsW();
208:     if (parent == nullptr) {
209:         throw TestKitError(TestKitErrorKind::EnvUnavailable,
210:                            "ProcessRunner：父环境块不可得（GetEnvironmentStringsW 失败）");
211:     }
212:     for (const wchar_t* p = parent; *p != L'\0'; p += std::wstring(p).size() + 1) {
213:         const std::wstring entry{p};
214:         const auto eq = entry.find(L'=');
215:         // 以 '=' 开头的条目是 cmd 的隐藏变量（如 "=C:=C:\..."），不进入覆盖
216:         // 模型（无法用普通 "NAME=VALUE" 语义表达，丢弃不影响测试子进程）。
217:         if (eq != std::wstring::npos && eq > 0) {
218:             merged.emplace(entry.substr(0, eq), entry.substr(eq + 1));
219:         }
220:     }
221:     ::FreeEnvironmentStringsW(parent);
222: 
223:     // 第二遍：覆盖条目写入（map 赋值语义＝同名覆盖、其余新增）。
224:     for (const auto& [name, value] : overrides) {
225:         merged[utf8ToWide(name)] = utf8ToWide(value);
226:     }
227: 
228:     std::wstring block;
229:     for (const auto& [name, value] : merged) {
230:         block += name;
231:         block += L'=';
232:         block += value;
233:         block += L'\0';
234:     }
235:     block.push_back(L'\0');  // 终止 NUL：整块以双 NUL 结尾
236:     return block;
237: }
238: 

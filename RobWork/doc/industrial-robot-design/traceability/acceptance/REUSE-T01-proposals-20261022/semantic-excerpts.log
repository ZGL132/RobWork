TEST(ReuseAudit, EulerMaskCannotBeSubstitutedByEaaRows) {
    using namespace rw::math;
    // RobWork RPY 参数顺序是 yaw/pitch/roll，产品字段顺序是 roll/pitch/yaw。
    // 仅 roll 改变；固定 yaw/pitch 时，空间 EAA 的 y/z 仍出现非零分量。
    const auto actual = RPY<>(0.7, 0.4, 0.6).toRotation3D();
    const auto desired = RPY<>(0.7, 0.4, 1.2).toRotation3D();
    const RPY<> actualAngles(actual), desiredAngles(desired);
    EXPECT_NEAR(0.0, desiredAngles[0] - actualAngles[0], 1e-12); // yaw 固定。
    EXPECT_NEAR(0.0, desiredAngles[1] - actualAngles[1], 1e-12); // pitch 固定。
    const EAA<> spatialError = actual * EAA<>(inverse(actual) * desired);
    EXPECT_GT(std::hypot(spatialError[1], spatialError[2]), 0.2);
}

// 上游选择的反例：JacobianIKSolver 在半周目标处的公开收敛结果须用独立姿态误差复核。
TEST(ReuseAudit, JacobianSolverHalfTurnNeedsIndependentValidation) {
    using namespace rw::kinematics;
    using namespace rw::math;
    using namespace rw::models;
    StateStructure structure;
    auto* base = new FixedFrame("base", Transform3D<>());
    auto* joint = new RevoluteJoint("joint", Transform3D<>());
    auto* tcp = new FixedFrame("tcp", Transform3D<>());
    structure.addFrame(base, structure.getRoot());
    structure.addFrame(joint, base);
    structure.addFrame(tcp, joint);
    joint->setActive(true);
    State state = structure.getDefaultState();
    const auto device = rw::core::ownedPtr(new SerialDevice(base, tcp, "view", state));
    rw::invkin::JacobianIKSolver solver(device, state);
    // 夹具只有绕 Z 的关节；绕 X 半周不可达，不能把 RPY 首参误当 roll。
    const Transform3D<> target(RPY<>(0, 0, rw::math::Pi).toRotation3D());
    const bool reportedConverged = solver.solveLocal(target, 1e-6, state, 2);
    EXPECT_TRUE(reportedConverged); // 实测上游差异，不允许生产沿用其成功判定。
    const EAA<> actualResidual(inverse(device->baseTend(state).R()) * target.R());
    EXPECT_NEAR(rw::math::Pi, actualResidual.angle(), 1e-12);
}

// GAP-IK/KIN-02：ParallelIK耗尽预算后仍可能返回候选，非空不能作为成功证据。
TEST(ReuseAudit, ParallelSolverBudgetExhaustionStillReturnsCandidate) {
    using namespace rw::kinematics;
    using namespace rw::math;
    using namespace rw::models;
    StateStructure structure;
    auto* base = new FixedFrame("base", Transform3D<>());
    auto* joint = new RevoluteJoint("joint", Transform3D<>());
    auto* tcp = new FixedFrame("tcp", Transform3D<>(Vector3D<>(1, 0, 0)));
    structure.addFrame(base, structure.getRoot());
    structure.addFrame(joint, base);
    structure.addFrame(tcp, joint);
    joint->setActive(true);
    State state = structure.getDefaultState();
    ParallelLeg leg(std::vector<Frame*>{base, joint, tcp});
    ParallelDevice device(ParallelDevice::Legs{&leg}, "view", state);
    device.setBounds({Q(1, -3.14), Q(1, 3.14)});
    rw::invkin::ParallelIKSolver solver(&device);
    solver.setMaxIterations(2);
    solver.setMaxError(1e-10);
    VectorND<6, bool> enabled;
    for (int i = 0; i < 6; ++i) enabled[i] = i < 3;
    const Transform3D<> target(Vector3D<>(2, 0, 0));
    const auto solutions = solver.solve(
        std::vector<rw::invkin::ParallelIKSolver::Target>{{tcp, target, enabled}}, state);
    // 独立几何界限：TCP只能在半径1 m的圆上，(2,0,0)至少相差1 m。
    ASSERT_EQ(1u, solutions.size());
    State candidate = state;
    device.setQ(solutions.front(), candidate);
    EXPECT_NEAR(1.0, (leg.baseTend(candidate).P() - target.P()).norm2(), 1e-12);
void ODESimulator::resetScene (rw::kinematics::State& state)
{
    if (isInErrorGlobal) {
        // delete world and reinitialize everything
    }

    isInErrorGlobal = false;
    _time           = 0.0;

    // first run through all rigid bodies and set the velocity and force to zero
    RW_DEBUGS ("- Resetting bodies: " << _allbodies.size ());
    for (dBodyID body : _allbodies) {
        dBodySetLinearVel (body, 0, 0, 0);
        dBodySetAngularVel (body, 0, 0, 0);
        dBodySetForce (body, 0, 0, 0);
        dBodySetTorque (body, 0, 0, 0);
    }

    for (ODEBody* body : _odeBodies) {
        body->reset (state);
    }

    // next the position need be reset to what is in state
    // run through all rw bodies and set the body position accordingly
    RW_DEBUGS ("- Resetting sensors: " << _odeSensors.size ());
    for (ODETactileSensor* sensor : _odeSensors) {
        sensor->clear ();
    }

    RW_DEBUGS ("- Resetting devices: " << _odeDevices.size ());
    // run through all devices and set the rigid bodies accoringly
    for (ODEDevice* device : _odeDevices) {
        device->reset (state);
    }
    RW_DEBUGS ("Finished reset!!");
}

void ODESimulator::disableCollision (rwsim::dynamics::Body::Ptr b1, rwsim::dynamics::Body::Ptr b2)
{
    _bpstrategy->addRule (ProximitySetupRule::makeExclude (b1->getName (), b2->getName ()));
}

void ODESimulator::enableCollision (rwsim::dynamics::Body::Ptr b1, rwsim::dynamics::Body::Ptr b2)
{
    _bpstrategy->addRule (ProximitySetupRule::makeInclude (b1->getName (), b2->getName ()));
}

void ODESimulator::exitPhysics ()
{
    for (ODEConstraint* constraint : _odeConstraints) {
        delete constraint;
    }
    _odeConstraints.clear ();

    for (ODEDevice* vdev : _odeDevices) {
        delete vdev;
    }
    _odeDevices.clear ();

    for (ODETactileSensor* sensor : _odeSensors) {
        delete sensor;
    }
    _odeSensors.clear ();

    while (_odeBodies.size () > 0) {
        ODEBody* body = _odeBodies[0];
        if (!_dwc->inDevice (body->getRwBody ()))
            delete body;
        std::vector< ODEBody* >::iterator it = _odeBodies.begin ();
        while (it < _odeBodies.end ()) {
         * The method provides the, in a least square sense, optimal joint
         * velocity for the specified tool velocity screw. That is the
         * \f$\mathbf{\dot{q}}\f$ minimizing
         * \f$\|\mathbf{J}\mathbf{\dot{q}}-\mathbf{\dot{x}}\|^2\f$, subject to the joint position,
         * velocity and acceleration limits.
         *
         * @param q [in] current device joint configuration
         * @param dq [in] current device joint velocity
         * @param tcpscrew [in] desired velocity screw of tcp
         *
         * @return the optimal joint velocity
         */
        rw::math::Q solve (const rw::math::Q& q, const rw::math::Q& dq,
                           const rw::math::VelocityScrew6D<>& tcpscrew);

      private:
        typedef rw::math::Q::Base VectorBase;

        VectorBase inequalitySolve (const Eigen::MatrixXd& G, const VectorBase& b,
                                    const VectorBase& lower, const VectorBase& upper);

        void calculateVelocityLimits (VectorBase& lower, VectorBase& upper, const VectorBase& q,
                                      const VectorBase& dq);
        /**
         * @copydoc rw::invkin::IterativeIK::solve
         */
        std::vector< rw::math::Q > solve (const rw::math::Transform3D<>& baseTend,
                                          const rw::kinematics::State& state) const;

        void setCheckJointLimits (bool limit){};

      private:
        QPController _qpcontroller;
        const rw::models::SerialDevice* _device;
        rw::core::PropertyMap _properties;
        rw::kinematics::State _state;
        double _maxQuatStep;

        bool performLocalSearch (const rw::models::SerialDevice* device,
                                 const rw::math::Transform3D<>& bTed, double maxError,
                                 rw::kinematics::State& state, unsigned int maxIter) const;
    };


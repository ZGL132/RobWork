62: // 支配判定（Pareto.hpp 契约——noexcept 纯函数）
63: // =====================================================================
64: 
65: bool dominates(const FeasibleCandidate& a, const FeasibleCandidate& b,
66:                const ObjectiveSet& objectives) noexcept
67: {
68:     // 第一步：∀i —— aᵢ 不劣于 bᵢ（任一目标劣即不支配——短路返回）。
69:     for (const auto& entry : objectives.entries) {
70:         // 方向经 metricDirectionOf 零分配取向（词表方向实现单点——
71:         // 热路径友好；noexcept 函数内禁用会分配的 metricDefinitions()）。
72:         const MetricDirection d = metricDirectionOf(entry.metricId);
73:         if (!notWorse(slotValue(a, entry.metricId), slotValue(b, entry.metricId),
74:                       d, entry.tolerance)) {
75:             return false;
76:         }
77:     }
78:     // 第二步：∃j —— aⱼ 严格优于 bⱼ（全不劣但无一严格优＝互不支配——
79:     // 逐元素近似相等的候选对在此归为互不支配，§7.4 自洽性）。
80:     for (const auto& entry : objectives.entries) {
81:         const MetricDirection d = metricDirectionOf(entry.metricId);
82:         if (strictlyBetter(slotValue(a, entry.metricId),
83:                            slotValue(b, entry.metricId), d, entry.tolerance)) {
84:             return true;
85:         }
86:     }
87:     return false;
88: }

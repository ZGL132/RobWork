160: class JsonParser {
161: public:
162:     explicit JsonParser(std::string_view text)
163:         : p_(text.data()), end_(text.data() + text.size())
164:     {
165:     }
166: 
167:     /// 解析整个文档：一个顶层值＋输入必须恰好耗尽（尾随内容＝截断/拼接
168:     /// 现场证据，拒绝）。
169:     JsonValue parseDocument()
170:     {
171:         JsonValue v = parseValue(0);
172:         if (p_ != end_) {
173:             corrupt("trailing content after JSON document（截断或非 canonical 尾部）");
174:         }
175:         return v;
176:     }
177: 
178: private:
179:     const char* p_;     ///< 当前扫描位置（耗尽后 peek/next 即报截断）
180:     const char* end_;   ///< 输入末尾（哨兵）
181:     bool firstDigitWasZero_ = false;  ///< 当前数字字面量首数字是否为 '0'
182: 
183:     /// 输入是否已耗尽。
184:     bool atEnd() const { return p_ == end_; }
185: 
186:     /// 读取当前字节（不前进）。耗尽即"截断"——canonical 文档不允许提前结束。
187:     char peek()
188:     {
189:         if (atEnd()) { corrupt("truncated input（文档在结构中间结束）"); }
190:         return *p_;
191:     }
192: 
193:     /// 消费一个字节并返回。
194:     char next()
195:     {
196:         const char c = peek();
197:         ++p_;
198:         return c;
199:     }
200: 
201:     /// 期望当前字节为 expected，否则拒绝（结构层语法错误）。
202:     void expect(char expected)
203:     {
204:         const char c = next();
205:         if (c != expected) {
206:             corrupt(std::string("syntax error: expected '") + expected + "' got '"
207:                     + printable(c) + "'");
208:         }
209:     }
210: 
211:     /// 控制字符/引号的可打印呈现（错误消息防注入——不透传原始字节）。
212:     static std::string printable(char c)
213:     {
214:         if (c >= 0x20 && c < 0x7F) { return std::string{c}; }
215:         static constexpr char kHex[] = "0123456789abcdef";
216:         const auto u = static_cast<unsigned char>(c);
217:         std::string s = "0x";
218:         s += kHex[(u >> 4) & 0xF];
219:         s += kHex[u & 0xF];
220:         return s;
221:     }
222: 
223:     /// 值分发：对象/数组/字符串/整数；其余一律拒绝。
224:     JsonValue parseValue(int depth)
225:     {
226:         // 深度上限检查在进入前做（每层 +1——防御在先，不依赖递归自然爆栈）。
227:         if (depth > kMaxDepth) { corrupt("nesting depth exceeds limit（非法深嵌套）"); }
228:         const char c = peek();
229:         switch (c) {
230:         case '{': return parseObject(depth);
231:         case '[': return parseArray(depth);
232:         case '"': {
233:             JsonValue v;
234:             v.kind = JsonValue::Kind::String;
235:             v.str = parseString();
236:             return v;
237:         }
238:         case '-':
239:         case '0': case '1': case '2': case '3': case '4':
240:         case '5': case '6': case '7': case '8': case '9': {
241:             JsonValue v;
242:             v.kind = JsonValue::Kind::Integer;
243:             parseNumber(v);
244:             return v;
245:         }
246:         default:
247:             // true/false/null 与一切裸词在词法层拒绝——§4.4 契约无此类字段，
248:             // 缺失即可选，出现即非 canonical（文件头规则 2）。

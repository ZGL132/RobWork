95: function(ird_read_flat path out_var)
96:     file(READ "${path}" _raw)
97:     string(REGEX REPLACE "#[^\n]*" "" _nocomment "${_raw}")
98:     string(REGEX REPLACE "[\r\n\t]+" " " _flat "${_nocomment}")
99:     string(REGEX REPLACE "  +" " " _flat "${_flat}")
100:     set(${out_var} "${_flat}" PARENT_SCOPE)
101: endfunction()
102: 
103: # 从压平文本中提取某命令的全部括号块（不含嵌套括号——仓库风格约束）
104: function(ird_extract_blocks flat_text command out_var)
105:     string(REGEX MATCHALL "${command}[ \t]*\\([^)]*\\)" _blocks "${flat_text}")
106:     set(${out_var} "${_blocks}" PARENT_SCOPE)
107: endfunction()
108: 
109: # 括号块 → 参数列表（去掉命令名与括号；CMake 列表以分号分隔，故空格→分号
110: # 后才能用 list()/foreach 逐参处理。前提：参数内不含空格——仓库 CMake 风格
111: # 中路径均无空格，见第 1 步"文本级解析确定性前提"）
112: function(ird_block_args block out_var)
113:     string(REGEX REPLACE "^[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(" "" _inner "${block}")
114:     string(REGEX REPLACE "\\)$" "" _inner "${_inner}")
115:     string(STRIP "${_inner}" _inner)
116:     string(REPLACE " " ";" _args "${_inner}")
117:     set(${out_var} "${_args}" PARENT_SCOPE)
118: endfunction()
119: 
120: set(IRD_TARGETS "")        # 全部显式目标名（不含变量名/ALIAS）
121: foreach(_cl ${IRD_CMAKELISTS})
122:     ird_read_flat("${_cl}" _flat)
123:     ird_extract_blocks("${_flat}" "add_library" _blocks)
124:     foreach(_b ${_blocks})
125:         ird_block_args("${_b}" _args)
126:         list(GET _args 0 _tgt)
127:         # 变量名目标（含 ${...}）静态不可展开——跳过（见第 1 步注释）
128:         if(_tgt MATCHES "\\$\\{")
129:             continue()
130:         endif()
131:         # ALIAS / IMPORTED 不是可链接检查的独立目标
132:         set(_is_alias FALSE)
133:         foreach(_a ${_args})
134:             if(_a STREQUAL "ALIAS" OR _a STREQUAL "IMPORTED")
135:                 set(_is_alias TRUE)
136:             endif()
137:         endforeach()
138:         if(NOT _is_alias)
139:             list(APPEND IRD_TARGETS "${_tgt}")
140:         endif()
141:     endforeach()
142: endforeach()
143: 
144: # 目标名 → 单元 与 目标名 → 形态（bare/lib、plugin、worker、test、contract_test）
145: # 解析规则：sdurws_ird_<unit>[_<suffix>]；未知单元目标在边检查时报 SUB。
146: # WP-22-T02 返工回填（2026-10-06）：_gui_test 后缀并入 test 形态——GUI 测试
147: # 目标（sdurws_ird_<unit>_gui_test，ui/requirements/modeling 三单元登记的
148: # 测试目标形态，DTB §5.1"ctest 全单元"口径与各卡 §3.2 目标表）此前三段
149: # 后缀不匹配任何形态正则、unit 解析为空，其链接边（本单元自边＋testkit）
150: # 被误判为"表外依赖边 ->ui/->testkit"——按 testkit.md §2.4 T-1 允许形态
151: # （白名单文件头明文"引擎按此硬编码判定"）归入 test 形态统一判定。
152: function(ird_classify_target name out_unit out_face)
153:     set(_unit "")
154:     set(_face "other")
155:     if(name MATCHES "^sdurws_ird_([a-z]+)$")
156:         set(_unit "${CMAKE_MATCH_1}")
157:         set(_face "product")
158:     elseif(name MATCHES "^sdurws_ird_([a-z]+)_(plugin|worker|app)$")
159:         set(_unit "${CMAKE_MATCH_1}")
160:         set(_face "${CMAKE_MATCH_2}")
161:     # WP-01-T05：性能测试同样遵守 testkit §2.4 的测试目标规则。只扩展
162:     # 明确登记的两种后缀；不使用 .*_test，避免任意工具名得到测试豁免。
163:     elseif(name MATCHES "^sdurws_ird_([a-z]+)_(test|contract_test|gui_test|perf_test|largedata_perf_test)$")
164:         set(_unit "${CMAKE_MATCH_1}")
165:         set(_face "test")
166:     endif()
167:     set(${out_unit} "${_unit}" PARENT_SCOPE)
168:     set(${out_face} "${_face}" PARENT_SCOPE)
169: endfunction()
170: 
171: # 提取链接边：每条边记录 "目标|链接库"（规范化 RWS::ird::X → sdurws_ird_X）
172: set(IRD_EDGES "")
173: foreach(_cl ${IRD_CMAKELISTS})
174:     ird_read_flat("${_cl}" _flat)


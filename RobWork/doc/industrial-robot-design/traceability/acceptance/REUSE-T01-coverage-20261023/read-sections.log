60: namespace {
61: 
62: // =====================================================================
63: // 构造辅助
64: // =====================================================================
65: 
66: /// 指定种子的非零候选身份（内容寻址格式的测试构造——字节填种子，避免
67: /// 保留值全零；种子即身份在断言中的可读标记）。
68: CandidateId makeCid(unsigned char seed)
69: {
70:     CandidateId id;
71:     id.bytes.fill(seed);
72:     return id;
73: }
74: 
75: /// 两目标（包络 min + 裕量 max）可行候选构造——本组测试的标准场景：
76: /// 指标向量按 {Envelope, MinJointMargin} 两槽填值，其余槽全 nullopt
77: /// （非激活槽自由——§7.4"八槽全量展示"语义的输入形态）。
78: FeasibleCandidate makeCandidate(unsigned char seed, double envelope,
79:                                 double margin, bool isBaseline = false)
80: {
81:     FeasibleCandidate c;
82:     c.candidateId = makeCid(seed);
83:     c.isBaseline = isBaseline;
84:     c.metricValues.assign(kMetricCount, std::nullopt);
85:     c.metricValues[static_cast<std::size_t>(MetricId::Envelope)] = envelope;
86:     c.metricValues[static_cast<std::size_t>(MetricId::MinJointMargin)] = margin;
87:     return c;
88: }
89: 
90: /// 两目标（min 包络 / max 裕量）零容差目标集——标准场景 objectives。
91: ObjectiveSet makeTwoObjectives()
92: {
93:     return makeObjectiveSet({{MetricId::Envelope, {}},
94:                              {MetricId::MinJointMargin, {}}});
95: }
96: 
97: /// 按 entries 序取身份（断言辅助）。
98: std::vector<CandidateId> idsOf(const ParetoFrontResult& r)
99: {
100:     std::vector<CandidateId> ids;
101:     ids.reserve(r.entries.size());
102:     for (const auto& e : r.entries) {
103:         ids.push_back(e.candidateId);
104:     }
105:     return ids;
106: }
107: 
108: }  // namespace

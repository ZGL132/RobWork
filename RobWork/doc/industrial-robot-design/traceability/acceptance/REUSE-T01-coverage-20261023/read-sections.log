405: {
406:     const ImportSourceSpan hostSpan = engine.spanOf(fileIdx, hostOffset);
407:     const std::size_t n = text.size();
408:     std::size_t i = 0;
409:     while (i < n) {
410:         if (text[i] != '$') {
411:             out->push_back(text[i]);
412:             ++i;
413:             continue;
414:         }
415:         // '$' 起始：区分 ${引用}、$(ROS 替换参数)、字面 '$'。
416:         if (i + 1 >= n) {
417:             out->push_back('$');  // 尾随孤立 '$'——无替换语义，原样保留
418:             break;
419:         }
420:         if (text[i + 1] == '{') {
421:             // 找配对 '}'（计数嵌套——嵌套内容在标识符判别处被拒，计数只
422:             // 为正确圈定边界）。
423:             std::size_t depth = 1;
424:             std::size_t j = i + 2;
425:             while (j < n && depth > 0) {
426:                 if (text[j] == '{') { ++depth; }
427:                 else if (text[j] == '}') { --depth; }
428:                 ++j;
429:             }
430:             if (depth != 0) {
431:                 const std::string raw(text.substr(i));
432:                 engine.pushUnresolvedDiag(
433:                     "unsupported-construct", raw,
434:                     "${ 替换未闭合——受控子集要求完整 ${标识符} 形态",
435:                     "改为 ${参数名} 形态或在展开环境提供该参数", hostSpan);
436:                 engine.fail(XacroExpandErrorCode::UndefinedSymbol,
437:                             {{"item-kind", "unsupported-construct"},
438:                              {"symbol", raw}},
439:                             "未闭合的 ${ 替换——定位见诊断");
440:                 return false;
441:             }
442:             // 圈定内容并去首尾空白（"${ name }" 与 "${name}" 同义——字面
443:             // 空白不参与符号名）。
444:             std::string_view inner = text.substr(i + 2, j - i - 3);
445:             while (!inner.empty() && (inner.front() == ' ' || inner.front() == '\t'
446:                                       || inner.front() == '\r' || inner.front() == '\n')) {
447:                 inner.remove_prefix(1);
448:             }
449:             while (!inner.empty() && (inner.back() == ' ' || inner.back() == '\t'
450:                                       || inner.back() == '\r' || inner.back() == '\n')) {
451:                 inner.remove_suffix(1);
452:             }
453:             if (!isPlainIdentifier(inner)) {
454:                 // 表达式/算式/函数调用——明确不求值（绝不执行任意代码；
455:                 // ${a+b}/${foo()} 等一律定位失败，NFR-COR-03 不静默）。
456:                 engine.pushUnresolvedDiag(
457:                     "unsupported-expression", std::string(inner),
458:                     "${} 内为表达式形态——受控子集只支持纯标识符引用，"
459:                     "不做任何表达式求值",
460:                     "改为纯标识符引用，或在展开环境预计算后以字面代入",
461:                     hostSpan);
462:                 engine.fail(XacroExpandErrorCode::UndefinedSymbol,
463:                             {{"item-kind", "unsupported-expression"},
464:                              {"symbol", std::string(inner.substr(0, 64))}},
465:                             "${} 表达式形态被拒绝（绝不执行任意代码）——定位见诊断");
466:                 return false;
467:             }
468:             const std::string* value = engine.resolveSymbol(std::string(inner));
469:             if (value == nullptr) {
470:                 // 未定义参数——行列定位诊断（MDL-19/AT-31 验收面）。
471:                 engine.pushUnresolvedDiag(
472:                     "undefined-param", std::string(inner),
473:                     "引用了未定义参数——展开环境（substitutions）与文档属性中均无此名",
474:                     "在展开环境提供该参数，或先以 xacro:property 定义", hostSpan);
475:                 engine.fail(XacroExpandErrorCode::UndefinedSymbol,
476:                             {{"item-kind", "undefined-param"},
477:                              {"symbol", std::string(inner)}},
478:                             "未定义参数 '" + std::string(inner) + "'——定位见诊断");

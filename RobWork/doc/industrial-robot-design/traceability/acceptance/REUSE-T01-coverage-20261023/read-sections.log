44: 
45: /// presence 字节的两个合法值（其余值在解码侧拒绝——严格编码）。
46: constexpr std::uint8_t kPresenceAbsent = 0;
47: constexpr std::uint8_t kPresencePresent = 1;
48: 
49: /// 大端字节流写出器（确定性：无缓冲策略差异——顺序 append）。
50: class Writer {
51: public:
52:     /// 无符号整数大端写出（多字节字段统一大端——§4.4 规则 4）。
53:     void u8(std::uint8_t v) { m_out.push_back(v); }
54:     void u16(std::uint16_t v)
55:     {
56:         m_out.push_back(static_cast<std::uint8_t>(v >> 8));
57:         m_out.push_back(static_cast<std::uint8_t>(v));
58:     }
59:     void u32(std::uint32_t v)
60:     {
61:         m_out.push_back(static_cast<std::uint8_t>(v >> 24));
62:         m_out.push_back(static_cast<std::uint8_t>(v >> 16));
63:         m_out.push_back(static_cast<std::uint8_t>(v >> 8));
64:         m_out.push_back(static_cast<std::uint8_t>(v));
65:     }
66:     void u64(std::uint64_t v)
67:     {
68:         for (int shift = 56; shift >= 0; shift -= 8) {
69:             m_out.push_back(static_cast<std::uint8_t>(v >> shift));
70:         }
71:     }
72: 
73:     /// 有符号 64 位（时间戳纳秒）——按二进制补码位模式大端写出。
74:     void i64(std::int64_t v) { u64(static_cast<std::uint64_t>(v)); }
75: 
76:     /// double 以 IEEE754 位模式大端写出；NaN/±Inf 编码入口拒绝（§4.4 规则
77:     /// 7——evidence D-06 同源：身份编码不承载非有限值）。
78:     void f64(double v)
79:     {
80:         if (!std::isfinite(v)) {
81:             throw ReportError(ReportErrorCode::DataInvalid,
82:                               "ReportCodec: 非有限浮点值（NaN/±Inf）拒绝入编码");
83:         }
84:         std::uint64_t bits = 0;
85:         static_assert(sizeof(bits) == sizeof(v), "double 必须为 64 位 IEEE754");
86:         std::memcpy(&bits, &v, sizeof(bits));
87:         u64(bits);
88:     }
89: 
90:     /// 布尔以单字节 0/1 写出。
91:     void boolean(bool v) { u8(v ? 1 : 0); }
92: 
93:     /// optional presence 字节（§4.4 规则 5——显式编码，无隐式缺席）。
94:     void presence(bool present) { u8(present ? kPresencePresent : kPresenceAbsent); }
95: 
96:     /// 原始字节（Id128/Digest256 等定长数组——原样写入）。
97:     void raw(const std::uint8_t* data, std::size_t n)
98:     {
99:         m_out.insert(m_out.end(), data, data + n);
100:     }
101: 
102:     /// 字符串：u32 长度前缀＋UTF-8 字节；NUL 拒绝（§4.4 规则 6）。
103:     void string(const std::string& s)
104:     {
105:         if (s.find('\0') != std::string::npos) {
106:             throw ReportError(ReportErrorCode::DataInvalid,
107:                               "ReportCodec: 字符串含 NUL 字节（UTF-8 禁 NUL）");
108:         }
109:         u32(static_cast<std::uint32_t>(s.size()));
110:         raw(reinterpret_cast<const std::uint8_t*>(s.data()), s.size());
111:     }
112: 
113:     /// 已注册单位 token：以冻结 symbol 字符串承载（解码侧经 find 还原——
114:     /// 持久化 token 不用注册表下标，下标非稳定契约）。
115:     void unitToken(core::UnitToken unit)
116:     {
117:         if (!unit.isValid()) {
118:             throw ReportError(ReportErrorCode::DataInvalid,
119:                               "ReportCodec: 未注册 UnitToken 拒绝入编码");
120:         }
121:         string(std::string(unit.symbol()));
122:     }
123: 
124:     /// 取出完整字节流。
125:     std::vector<std::uint8_t> take() { return std::move(m_out); }
126: 
127: private:
128:     std::vector<std::uint8_t> m_out;   ///< 累积输出字节
129: };

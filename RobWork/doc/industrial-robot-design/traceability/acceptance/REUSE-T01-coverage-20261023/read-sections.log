30: double slotValue(const FeasibleCandidate& c, MetricId id) noexcept
31: {
32:     return *c.metricValues[static_cast<std::size_t>(id)];
33: }
34: 
35: /// "aᵢ 不劣于 bᵢ（按方向 dᵢ，容差 tᵢ）"（§7.4 定义式——min/max 对称展开；
36: /// closeWithin 的参考元＝bᵢ，卡 §7.4 字面）。
37: bool notWorse(double a, double b, MetricDirection d, const core::Tolerance& t) noexcept
38: {
39:     if (d == MetricDirection::Minimize) {
40:         // min 方向：a ≤ b 即不劣；近似相等（容差内）同样视为不劣——
41:         // 零容差时 closeWithin 退化为 a == b（浮点全序，DOPT-5）。
42:         return a <= b || core::closeWithin(a, b, t);
43:     }
44:     // max 方向：a ≥ b 即不劣（对称）。
45:     return a >= b || core::closeWithin(a, b, t);
46: }
47: 
48: /// "aᵢ 严格优于 bᵢ（按方向 dᵢ，容差 tᵢ）"——差异须**超出容差**的优
49: /// （容差内的优不算严格优：保证"逐元素近似相等 ⇒ 互不支配"自洽）。
50: bool strictlyBetter(double a, double b, MetricDirection d,
51:                     const core::Tolerance& t) noexcept
52: {
53:     if (d == MetricDirection::Minimize) {
54:         return a < b && !core::closeWithin(a, b, t);
55:     }
56:     return a > b && !core::closeWithin(a, b, t);
57: }

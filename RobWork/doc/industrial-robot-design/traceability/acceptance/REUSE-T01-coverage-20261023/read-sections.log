236: FrameAssembler::Status FrameAssembler::feed(const std::uint8_t* data, std::size_t size,
237:                                             std::vector<ChannelFrame>& out)
238: {
239:     // 协议错误闩：通道字节流一旦出现非法帧，后续字节的对齐已不可信——
240:     // 恒失败（恢复手段＝任务失败＋通道重建，§6.5）。
241:     if (m_failed) {
242:         return Status::ProtocolError;
243:     }
244:     m_buffer.insert(m_buffer.end(), data, data + size);
245: 
246:     // 增量解析：每次尝试从消费位凑出一个完整帧，凑不出即止（等下次喂入）。
247:     for (;;) {
248:         const std::size_t available = m_buffer.size() - m_offset;
249:         if (available < kFrameFixedHeaderSize) {
250:             break;  // 连固定头都未凑齐
251:         }
252:         const std::uint8_t* base = m_buffer.data() + m_offset;
253:         // 校验 1：magic 逐字节（错位/混入垃圾在此暴露）。
254:         if (std::memcmp(base, kFrameMagic.data(), kFrameMagic.size()) != 0) {
255:             m_failed = true;
256:             return Status::ProtocolError;
257:         }
258:         // 校验 2：协议主版本（次版本兼容语义阶段 A 不存在——非 1 即拒，
259:         // §6.5"消息版本"行）。
260:         const std::uint16_t version = getU16(base + 7);
261:         if (version != kChannelProtocolVersion) {
262:             m_failed = true;
263:             return Status::ProtocolError;
264:         }
265:         // 校验 3：载荷长度上限（防长度域被破坏后按它读穿/分配爆掉）。
266:         const std::uint32_t payloadLen = getU32(base + 19);
267:         if (payloadLen > kMaxFramePayload) {
268:             m_failed = true;
269:             return Status::ProtocolError;
270:         }
271:         const std::size_t frameSize =
272:             kFrameFixedHeaderSize + kIdentityBlockSize + payloadLen;
273:         if (available < frameSize) {
274:             break;  // 帧体未凑齐——等下一块字节
275:         }
276:         // 校验 4：身份块（五元组随行承诺的帧级核对——ARCH §4.1）。
277:         const std::uint8_t* idBytes = base + kFrameFixedHeaderSize;
278:         std::optional<core::TaskIdentity> identity =
279:             decodeIdentityBlock(idBytes, kIdentityBlockSize);
280:         if (!identity.has_value() || !identity->isValid()) {
281:             m_failed = true;
282:             return Status::ProtocolError;
283:         }
284: 
285:         // 全部校验通过——取帧并推进消费位（压缩策略：消费位过半即向首
286:         // 搬移一次，均摊 O(1)，缓冲不无界增长）。
287:         ChannelFrame frame;
288:         frame.type = static_cast<ChannelMsgType>(base[9]);
289:         frame.flags = base[10];
290:         frame.seq = getU64(base + 11);
291:         frame.identity = *identity;
292:         frame.payload.assign(base + kFrameFixedHeaderSize + kIdentityBlockSize,
293:                              base + frameSize);
294:         m_offset += frameSize;
295:         if (m_offset * 2 >= m_buffer.size()) {
296:             m_buffer.erase(m_buffer.begin(),
297:                            m_buffer.begin() + static_cast<std::ptrdiff_t>(m_offset));
298:             m_offset = 0;
299:         }
300:         out.push_back(std::move(frame));
301:     }
302:     return Status::Ok;
303: }

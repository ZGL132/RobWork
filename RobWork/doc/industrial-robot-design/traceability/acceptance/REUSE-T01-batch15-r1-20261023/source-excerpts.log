506: void HostView3DPreviewBackend::clear()
507: {
508:     if (m_studio == nullptr) {
509:         return;
510:     }
511:     WorkCellScene::Ptr scene = m_studio->getWorkCellScene();
512:     if (scene.isNull()) {
513:         m_nodeNames.clear();
514:         return;
515:     }
516:     for (const std::string& name : m_nodeNames) {
517:         scene->removeDrawable(name);  // 幂等（不存在＝false，无副作用）
518:     }
519:     m_nodeNames.clear();
520: }

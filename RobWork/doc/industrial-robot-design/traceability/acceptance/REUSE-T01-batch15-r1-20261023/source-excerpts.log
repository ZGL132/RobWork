ui.HostView3DGateway.applyPresentation sdurws::ird::ui::HostView3DGateway::applyPresentation
65: // =====================================================================
66: 
67: PresentationApplyReport HostView3DGateway::applyPresentation(
68:     const PresentationViewProjection& view)
69: {
70:     PresentationApplyReport report;
71:     // 视图完整性前置（桥的身份对账之后的双保险——不完整视图不进挂接）。
72:     if (!view.isComplete()) {
73:         report.ok = false;
74:         report.failureToken = "ui-t45.incomplete-view";
75:         report.failureDetail = "呈现视图不完整（身份/存在性查询缺项）";
76:         return report;  // 旧呈现保持原状（桥保留旧当前呈现语义）
77:     }
78:     // hostPayload 取回（本类型本解释——禁止跨适配器解释的契约边界）。
79:     // void 载荷别名构造＋static 下转：类型契约由载荷提供方保证（装配
80:     // 纪律——void 起点无 dynamic 可言，误型载荷属装配缺陷非运行态）。
81:     const auto object = std::shared_ptr<const HostPresentationObject>(
82:         view.hostPayload,
83:         static_cast<const HostPresentationObject*>(view.hostPayload.get()));
84:     if (object == nullptr) {
85:         report.ok = false;
86:         report.failureToken = "ui-t45.payload-null";
87:         report.failureDetail = "hostPayload 为空（无可应用的呈现对象）";
88:         return report;
89:     }
90:     // 原子替换＝新呈现先挂接（失败＝旧呈现保持原状并如实报告——"失败
91:     // 保持原状"的事务语义），成功后整组摘除旧呈现（切换窗口内新旧短暂
92:     // 并存——观察面在返回后才见新态，原子性对消费者成立）。
93:     if (!object->apply()) {
94:         report.ok = false;
95:         report.failureToken = "ui-t45.attach-failed";
96:         report.failureDetail = "呈现对象挂接失败（对象自报）";
97:         return report;
98:     }
99:     releasePresentation();
100:     m_attachedPresentation = object;
101:     report.ok = true;
102:     return report;
103: }

ui.anonymous.applyCellColor sdurws::ird::ui::(anonymous namespace)::applyCellColor
85: /// 逐点着色分色（判定已由域侧完成——本函数只做词表到 GL 颜色的映射；
86: /// 色值经 UiTheme palette 词表供色——UI-T65 消硬编码，F-495 统一供色）。
87: void applyCellColor(View3DCellState state)
88: {
89:     switch (state) {
90:     case View3DCellState::Good:
91:         glColor3fv(ui::palette::kSampleGoodGl);  // 达标＝绿（词表）
92:         break;
93:     case View3DCellState::Weak:
94:         glColor3fv(ui::palette::kSampleWeakGl);  // 临界＝黄（词表）
95:         break;
96:     case View3DCellState::Failed:
97:         glColor3fv(ui::palette::kSampleFailedGl);  // 不达标＝红（词表）
98:         break;
99:     case View3DCellState::NotSampled:
100:         glColor3fv(ui::palette::kSampleNotSampledGl);  // 未采样＝灰（UI-T65）
101:         break;
102:     }
103: }

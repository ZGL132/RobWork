105: void HostView3DGateway::releasePresentation()
106: {
107:     if (m_attachedPresentation != nullptr) {
108:         // 整组摘除（场景绑定在对象侧——网关零场景依赖；尽力而为，桥对
109:         // 失败仅 Dev 留痕的既有语义）。
110:         m_attachedPresentation->remove();
111:         m_attachedPresentation.reset();
112:     }
113: }

359: 
360: bool HostView3DPreviewBackend::draw(const View3DPreviewUpdate& update)
361: {
362:     // 场景现取（studio 公开 API 直供——getView 中介零需要）。
363:     if (m_studio == nullptr) {
364:         return false;
365:     }
366:     WorkCellScene::Ptr scene = m_studio->getWorkCellScene();
367:     if (scene.isNull()) {
368:         return false;
369:     }
370:     // 挂接锚 WorkCell 三级现取（F-550② 修复——会话预览是会话编辑面
371:     // 〔PM-11/协议头注〕，草稿期（首应用前）就必须可见；此前实现把
372:     // "宿主已有发布 WorkCell"当前置，新项目增工位/区域后三维恒空白）：
373:     //   ①宿主 WorkCell（发布链 setWorkCell 后——常态路径）；
374:     //   ②场景当前 WorkCell（宿主装载，或上次装入的会话预览锚——复用）；
375:     //   ③新建会话预览锚装入场景（ensureSessionPreviewAnchor——仅场景
376:     //     层，studio 模型层零触碰）。
377:     // "无锚不画"是框架硬约束（场景挂接 API 在场景无 WorkCell 时抛异常
378:     // ——WorkCellScene::addDrawable 防御），修复让锚恒在位而非放弃渲染。
379:     rw::models::WorkCell::Ptr workcell = m_studio->getWorkCell();
380:     if (workcell.isNull()) {
381:         workcell = ensureSessionPreviewAnchor(*scene);
382:     }
383:     if (workcell.isNull()) {
384:         return false;  // 锚不可得（视图缺位等装配降级——诚实失败）
385:     }
386:     Frame* const world = workcell->getWorldFrame();
387:     if (world == nullptr) {
388:         return false;
389:     }
390: 
391:     // ①清旧组（节点名清单逐个删——原子替换语义的"先清"半区）。
392:     clear();
393: 
394:     // ②工位标记（UI-T77——F-555 双形态）：
395:     //   - position 形态（世界系点位）：坐标轴＋标签一体自绘
396:     //     （StationMarkerRender）挂 WORLD 根帧——工位作为带坐标的空间点
397:     //     在三维可辨（此前标记恒渲染于参考系原点＝工位坐标投影链丢失）；
398:     //     投影方保证到达本形态的 position 已可用（World 恒等或参考帧已
399:     //     解析——变换失败降级为挂帧形态），故无需再解析 frameName；
400:     //   - 挂帧形态（position 空，UI-T33 旧语义）：findFrame 挂 FrameAxis
401:     //     （坐标轴随帧动——会话/示教移动零重投；帧不可解析＝跳过并计数
402:     //     ——失败可见面）。
403:     //   两形态标签统一走 Qt 纹理化文本（QtTextBillboard——F-556：GLUT
404:     //   位图字体无 CJK，UTF-8 工位名乱码的替代承载；标签名独立命名空间
405:     //   防与轴同名冲突——removeDrawable 按名逐个删互不干扰）。
406:     // 帧解析锚＝上方现取的挂接锚 WC（F-550②——发布前＝会话预览锚，
407:     // "WORLD" 别名经 WorkCell::findFrame 特判命中其根帧；发布后＝编译
408:     // 产物 WC，同一别名命中发布根帧——两态查找语义一致）。
409:     int unresolved = 0;
410:     for (const View3DFrameMarker& marker : update.frameMarkers) {
411:         if (marker.position.has_value()) {
412:             // 点值形态：轴＋标签一体挂 WORLD（世界系点位——见上注）。
413:             const std::string nodeName =
414:                 std::string(kPreviewPrefix) + "marker3d-" + marker.label;
415:             scene->addRender(nodeName,
416:                              rw::core::ownedPtr(new StationMarkerRender(
417:                                  *marker.position, marker.label)),
418:                              world);
419:             m_nodeNames.push_back(nodeName);
420:             continue;
421:         }
422:         Frame* const frame = workcell->findFrame(marker.frameName);
423:         if (frame == nullptr) {
424:             ++unresolved;  // 失败可见面在投影方摘要——此处计数不虚构坐标轴
425:             continue;
426:         }
427:         const rw::core::Ptr<Frame> framePtr(frame);  // 非 owning 包装（场景树持有帧存活）
428:         const std::string axisName =
429:             std::string(kPreviewPrefix) + "marker-" + marker.label;
430:         scene->addFrameAxis(axisName, 0.25, frame);  // 轴长 0.25 m（工位尺度）
431:         m_nodeNames.push_back(axisName);
432:         // 标签（Qt 纹理化文本——F-556 替代件；挂帧随动，帧原点上方）。
433:         const std::string labelName =
434:             std::string(kPreviewPrefix) + "label-" + marker.label;
435:         scene->addRender(labelName,
436:                          rw::core::ownedPtr(
437:                              new QtTextBillboardRender(marker.label, framePtr)),
438:                          frame);
439:         m_nodeNames.push_back(labelName);
440:     }
441: 
442:     // ③区域边界框（世界系八角点 12 棱线框——辨识蓝）。
443:     if (update.boxOutline.has_value()) {
444:         const std::string nodeName = std::string(kPreviewPrefix) + "box";
445:         scene->addRender(nodeName,
446:                          rw::core::ownedPtr(new RegionOutlineRender(*update.boxOutline)),
447:                          world);
448:         m_nodeNames.push_back(nodeName);
449:     }
450: 
451:     // ④采样格（点阵着色——Good 绿/Weak 黄/Failed 红；空＝中性灰）。
452:     if (update.sampleGrid.has_value()) {
453:         const std::string nodeName = std::string(kPreviewPrefix) + "grid";
454:         scene->addRender(nodeName,
455:                          rw::core::ownedPtr(new SampleGridRender(*update.sampleGrid)),
456:                          world);
457:         m_nodeNames.push_back(nodeName);
458:     }
459: 
460:     // 失败可见面追加到摘要（协议值不可变——摘要由投影方承载；此处经
461:     // 节点名留痕：未解析帧计数以独立占位节点名可查——Dev 面诊断锚）。
462:     if (unresolved > 0) {
463:         const std::string nodeName = std::string(kPreviewPrefix) + "unresolved-"
464:                                      + std::to_string(unresolved);
465:         m_nodeNames.push_back(nodeName);  // 名单留痕（无渲染体——诊断锚）
466:     }
467:     return true;
468: }

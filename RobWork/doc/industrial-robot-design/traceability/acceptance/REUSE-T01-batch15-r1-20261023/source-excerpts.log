ui.StationMarkerRender.draw sdurws::ird::ui::(anonymous namespace)::StationMarkerRender::draw
153:     }
154: 
155:     void draw(const DrawableNode::RenderInfo& info,
156:               DrawableNode::DrawType type, double alpha) const override
157:     {
158:         (void)type;
159:         const PreviewColorScope colorScope;
160:         // 三轴：局部平移至点位后画 X/Y/Z 三线段（GL_LINES——轴指示惯例
161:         // 形态；轴长与挂帧形态 addFrameAxis 同尺度 0.25 m＝工位尺度）。
162:         glPushMatrix();
163:         glTranslated(m_position[0], m_position[1], m_position[2]);
164:         glLineWidth(2.0f);
165:         glBegin(GL_LINES);
166:         glColor4f(ui::palette::kAxisXGl[0], ui::palette::kAxisXGl[1],
167:                   ui::palette::kAxisXGl[2], static_cast<float>(alpha));
168:         glVertex3d(0.0, 0.0, 0.0);
169:         glVertex3d(kAxisLenM, 0.0, 0.0);
170:         glColor4f(ui::palette::kAxisYGl[0], ui::palette::kAxisYGl[1],
171:                   ui::palette::kAxisYGl[2], static_cast<float>(alpha));
172:         glVertex3d(0.0, 0.0, 0.0);
173:         glVertex3d(0.0, kAxisLenM, 0.0);
174:         glColor4f(ui::palette::kAxisZGl[0], ui::palette::kAxisZGl[1],
175:                   ui::palette::kAxisZGl[2], static_cast<float>(alpha));
176:         glVertex3d(0.0, 0.0, 0.0);
177:         glVertex3d(0.0, 0.0, kAxisLenM);
178:         glEnd();
179:         glLineWidth(1.0f);
180:         glPopMatrix();
181:         // 标签：点位上方（轴顶之外——层次分离）；挂 WORLD＝局部系即世界
182:         // 系，帧世界位姿恒等（省 State 查询——根帧语义保证）。
183:         m_label.drawBillboard(
184:             m_position + Vector3D<double>(0.0, 0.0, kLabelLiftM),
185:             Transform3D<double>::identity(), info, alpha);
186:     }

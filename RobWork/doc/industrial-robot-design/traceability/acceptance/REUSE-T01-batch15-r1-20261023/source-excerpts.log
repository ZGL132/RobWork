119: std::optional<rw::math::Transform3D<>>
120: HostView3DGateway::currentTcpPose(const std::string& deviceName)
121: {
122:     // 双缝缺省/双取失败＝诚实降级（nullopt——调用方呈现失败原因）。
123:     if (!m_deps.resolveTcpFrame || !m_deps.currentState) {
124:         return std::nullopt;
125:     }
126:     const rw::kinematics::Frame* tcpFrame = m_deps.resolveTcpFrame(deviceName);
127:     const rw::kinematics::State* state = m_deps.currentState();
128:     if (tcpFrame == nullptr || state == nullptr) {
129:         return std::nullopt;
130:     }
131:     // TCP 世界系位姿（worldTframe——宿主会话态只读，KIN-06：零修订、
132:     // 不写设计模型；设备 base 即模型根布置时与 base→TCP 一致）。
133:     const rw::core::Ptr<const rw::kinematics::Frame> frameView(tcpFrame);
134:     return rw::kinematics::Kinematics::worldTframe(frameView, *state);
135: }

42: 
43: QtTextBillboard::TextTexture

ui.QtTextBillboard.rasterizeAndUpload sdurws::ird::ui::QtTextBillboard::rasterizeAndUpload
41: }
42: 
43: QtTextBillboard::TextTexture
44: QtTextBillboard::rasterizeAndUpload(const std::string& text)
45: {
46:     // ---- Qt 离屏排版：QFont 默认应用字体（像素字号——DPI 无关，纹理
47:     // 尺寸稳定）；UTF-8 → QString 原生解码，CJK 字形经系统字体回退
48:     // （Windows 下"Microsoft YaHei"族）——GLUT 位图字体做不到的这一步
49:     // 就是 F-556 乱码的消解点。图像留 8/4 px 内边距防字形裁边。
50:     QFont font;
51:     font.setPixelSize(16);
52:     const QString qs = QString::fromStdString(text);
53:     const QFontMetrics fm(font);
54:     TextTexture tex{0, std::max(1, fm.horizontalAdvance(qs) + 8),
55:                     std::max(1, fm.height() + 4)};
56:     QImage img(tex.w, tex.h, QImage::Format_RGBA8888);
57:     img.fill(Qt::transparent);
58:     QPainter painter(&img);
59:     painter.setFont(font);
60:     painter.setRenderHint(QPainter::Antialiasing, true);
61:     painter.setPen(QColor(ui::palette::kMarkerLabelHex));  // 词表字色（工程蓝）
62:     painter.drawText(img.rect(), Qt::AlignCenter, qs);
63:     painter.end();
64: 
65:     // ---- GL 纹理上传（GL 1.1 标准入口；RGBA8888 内存布局与
66:     // GL_RGBA/GL_UNSIGNED_BYTE 直配——无字节序换算；NPOT 尺寸在现代
67:     // GL 兼容面直上，LINEAR 单级过滤——标签文本无 mipmap 需求）。
68:     glGenTextures(1, &tex.id);
69:     glBindTexture(GL_TEXTURE_2D, tex.id);
70:     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
71:     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
72:     glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
73:     glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, tex.w, tex.h, 0, GL_RGBA,
74:                  GL_UNSIGNED_BYTE, img.bits());
75:     return tex;
76: }
77: 
78: void QtTextBillboard::drawBillboard(

ui.QtTextBillboard.drawBillboard sdurws::ird::ui::QtTextBillboard::drawBillboard
76: }
77: 
78: void QtTextBillboard::drawBillboard(
79:     const Vector3D<double>& centerLocal,
80:     const Transform3D<double>& wTframe,
81:     const DrawableNode::RenderInfo& info, double alpha) const
82: {
83:     // ①GL 上下文现取（纹理上传/绑定的前提；无上下文＝离屏快照等
84:     // 装配态——文本层诚实跳过，不虚构呈现）。
85:     QOpenGLContext* const ctx = QOpenGLContext::currentContext();
86:     if (ctx == nullptr) {
87:         return;
88:     }
89:     // ②相机现取（billboard 朝向来源；无相机信息＝无法面向视口——同上）。
90:     if (info._cam.isNull()) {
91:         return;
92:     }
93:     // ③纹理缓存（进程级——键＝文本＋字色；上下文更换＝旧句柄全失效，
94:     // 整缓存作废重建，见契约头生命周期说明。仅 UI 线程访问——§3.4）。
95:     static std::map<std::pair<std::string, QRgb>, TextTexture> s_cache;
96:     static QOpenGLContext* s_texContext = nullptr;
97:     if (s_texContext != ctx) {
98:         s_cache.clear();
99:         s_texContext = ctx;
100:     }
101:     const QRgb labelRgba = QColor(ui::palette::kMarkerLabelHex).rgba();
102:     const auto key = std::make_pair(m_text, labelRgba);
103:     auto it = s_cache.find(key);
104:     if (it == s_cache.end()) {
105:         it = s_cache.emplace(key, rasterizeAndUpload(m_text)).first;
106:     }
107:     const TextTexture& tex = it->second;
108: 
109:     // ④billboard 四角（局部系）：相机右/上向量经挂接帧逆变换投回局部
110:     // 系（框架 RenderText 同款手法——wTf⁻¹·wTc 的旋转取列 0/列 1），
111:     // 中心对 @p centerLocal、世界尺寸按图像纵横比展开。
112:     const Transform3D<double> wTc = info._cam->getTransform();
113:     const Rotation3D<double> fTcR = inverse(wTframe).R() * wTc.R();
114:     const Vector3D<double> right(fTcR(0, 0), fTcR(1, 0), fTcR(2, 0));
115:     const Vector3D<double> up(fTcR(0, 1), fTcR(1, 1), fTcR(2, 1));
116:     const double halfH = 0.5 * kTextHeightM;
117:     const double halfW =
118:         halfH * static_cast<double>(tex.w) / static_cast<double>(tex.h);
119:     const Vector3D<double> tl = centerLocal - right * halfW + up * halfH;
120:     const Vector3D<double> tr = centerLocal + right * halfW + up * halfH;
121:     const Vector3D<double> br = centerLocal + right * halfW - up * halfH;
122:     const Vector3D<double> bl = centerLocal - right * halfW - up * halfH;
123: 
124:     // ⑤纹理四边形（混合状态自管——进出配对；v 坐标 0＝QImage 顶行
125:     // 〔行序直上 GL——glTexImage2D 自 v=0 装载首行〕）。
126:     glEnable(GL_TEXTURE_2D);
127:     glEnable(GL_BLEND);
128:     glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
129:     glBindTexture(GL_TEXTURE_2D, tex.id);
130:     glColor4f(1.0f, 1.0f, 1.0f, static_cast<float>(alpha));
131:     glBegin(GL_QUADS);
132:     glTexCoord2f(0.0f, 0.0f);
133:     glVertex3d(tl[0], tl[1], tl[2]);
134:     glTexCoord2f(1.0f, 0.0f);
135:     glVertex3d(tr[0], tr[1], tr[2]);
136:     glTexCoord2f(1.0f, 1.0f);
137:     glVertex3d(br[0], br[1], br[2]);
138:     glTexCoord2f(0.0f, 1.0f);
139:     glVertex3d(bl[0], bl[1], bl[2]);
140:     glEnd();
141:     glDisable(GL_BLEND);
142:     glDisable(GL_TEXTURE_2D);
143: }

105: /// 区域框 tint 分色（UI-T65——覆盖率映射档；None/缺省＝区域框既有辨识

ui.anonymous.tintColor sdurws::ird::ui::(anonymous namespace)::tintColor
108: /// 误为 kPrimary 同值且字面量硬编码，acc/ui-t65/1 阻断 B/E2 消账）。
109: /// 返回色三元组供 glColor4f 消费。
110: std::array<float, 3> tintColor(std::optional<View3DTint> tint)
111: {
112:     if (!tint.has_value() || *tint == View3DTint::None) {
113:         return {ui::palette::kRegionTintDefaultGl[0],
114:                 ui::palette::kRegionTintDefaultGl[1],
115:                 ui::palette::kRegionTintDefaultGl[2]};  // 缺省蓝（词表单点）
116:     }
117:     switch (*tint) {
118:     case View3DTint::Good:
119:         return {ui::palette::kSampleGoodGl[0], ui::palette::kSampleGoodGl[1],
120:                 ui::palette::kSampleGoodGl[2]};  // 达标档＝绿
121:     case View3DTint::Weak:
122:         return {ui::palette::kSampleWeakGl[0], ui::palette::kSampleWeakGl[1],
123:                 ui::palette::kSampleWeakGl[2]};  // 未达档＝黄
124:     case View3DTint::Failed:
125:         return {ui::palette::kSampleFailedGl[0], ui::palette::kSampleFailedGl[1],
126:                 ui::palette::kSampleFailedGl[2]};  // 零达标档＝红
127:     }
128:     // 不可达分支（switch 全覆盖——防御面）：同缺省蓝词表值。
129:     return {ui::palette::kRegionTintDefaultGl[0],
130:             ui::palette::kRegionTintDefaultGl[1],
131:             ui::palette::kRegionTintDefaultGl[2]};
132: }

ui.RegionOutlineRender.draw sdurws::ird::ui::(anonymous namespace)::RegionOutlineRender::draw
209:     }
210: 
211:     void draw(const DrawableNode::RenderInfo& info,
212:               DrawableNode::DrawType type, double alpha) const override
213:     {
214:         (void)info;
215:         (void)type;
216:         (void)alpha;
217:         const PreviewColorScope colorScope;
218:         // 十二棱（八角点拓扑——UI-T77/F-562 修正：生产者角序＝二进制序
219:         // 〔PanelRegionModel「索引 i 的 bit0→+sx、bit1→+sy、bit2→+sz」〕，
220:         // 边表按该角序连 12 条真棱——x 向 {0,1}{2,3}{4,5}{6,7}＋y 向
221:         // {0,2}{1,3}{4,6}{5,7}＋z 向立柱 {0,4}{1,5}{2,6}{3,7}。旧边表按
222:         // 循环序假设（0→1→2→3）连边，与二进制序不符＝底/顶面画成面对角
223:         // 线蝴蝶结、y 向四棱缺失——任何区域预览必现的几何错误）。
224:         static const int kEdges[12][2] = {
225:             {0, 1}, {1, 3}, {3, 2}, {2, 0},  // 底面（x 棱＋y 棱——二进制序回路 0→1→3→2→0）
226:             {4, 5}, {5, 7}, {7, 6}, {6, 4},  // 顶面（同构回路 4→5→7→6→4）
227:             {0, 4}, {1, 5}, {2, 6}, {3, 7},  // 立柱（z 向——bit2 翻转对）
228:         };
229:         glLineWidth(2.0f);
230:         // 框色＝tint 分色（UI-T65——覆盖率映射档；缺省蓝＝既有选中辨识
231:         // 色语义保持）。
232:         const std::array<float, 3> color = tintColor(m_tint);
233:         glColor4f(color[0], color[1], color[2], static_cast<float>(alpha));
234:         glBegin(GL_LINES);
235:         for (const auto& e : kEdges) {
236:             const Vector3D<double>& a = m_corners[e[0]];
237:             const Vector3D<double>& b = m_corners[e[1]];
238:             glVertex3d(a[0], a[1], a[2]);
239:             glVertex3d(b[0], b[1], b[2]);
240:         }
241:         glEnd();
242:         glLineWidth(1.0f);
243:     }

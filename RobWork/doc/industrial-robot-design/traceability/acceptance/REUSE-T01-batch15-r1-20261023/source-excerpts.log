ui.HostView3DGateway.handleViewDoubleClick sdurws::ird::ui::HostView3DGateway::handleViewDoubleClick
32: // =====================================================================
33: 
34: bool HostView3DGateway::handleViewDoubleClick(const QPoint& pos)
35: {
36:     // 链路五拍：拾取→帧名→反解→域分发→选中（View3DPick 来源）。任何
37:     // 一拍失败＝诚实返回 false（调用方不过滤事件——放行框架默认处理）。
38:     rw::kinematics::Frame* frame = m_deps.pickFrame(pos.x(), pos.y());
39:     if (frame == nullptr) {
40:         return false;  // 未命中（空白处双击——常态，非错误）
41:     }
42:     const std::string runtimeName = frame->getName();
43:     const std::optional<core::ObjectId> oid =
44:         m_deps.nameMap->resolveObjectIdFromRuntimeName(runtimeName);
45:     if (!oid.has_value()) {
46:         return false;  // L3 分支②语义——非业务对象：零选中变化、零伪造
47:     }
48:     // 域分发先行（未命中本域＝域内诚实 false——两域至少其一命中即有
49:     // 产出；分发出口缺省＝该域不参与，装配缺席的诚实形态）。
50:     bool dispatched = false;
51:     if (m_deps.dispatchToModeling) {
52:         dispatched = m_deps.dispatchToModeling(*oid) || dispatched;
53:     }
54:     if (m_deps.dispatchToRequirements) {
55:         dispatched = m_deps.dispatchToRequirements(*oid) || dispatched;
56:     }
57:     // 选中汇聚（View3DPick 来源——selectBusiness 后 L2 高亮判定经既有
58:     // HostHighlightOutlet 回环，链路闭环零第二状态源）。
59:     m_deps.selection->selectBusiness({*oid}, SelectionSource::View3DPick);
60:     return true;
61: }

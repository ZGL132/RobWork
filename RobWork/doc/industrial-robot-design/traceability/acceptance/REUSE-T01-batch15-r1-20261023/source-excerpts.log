155: void QtTextBillboardRender::draw(const DrawableNode::RenderInfo& info,
156:                                  DrawableNode::DrawType type,
157:                                  double alpha) const
158: {
159:     (void)type;
160:     // 帧/状态缺位＝场景树装配残态（防御面——不渲染不崩；RenderInfo
161:     // 的 _state 为裸指针形态——空判用指针比较而非 Ptr::isNull）。
162:     if (m_frame.isNull() || info._state == nullptr) {
163:         return;
164:     }
165:     // 挂接帧世界位姿（billboard 朝向计算输入——随 State 实时取）。
166:     const Transform3D<double> wTframe = m_frame->wTf(*info._state);
167:     // 标签中心＝帧原点上方（与轴指示器的视觉层次分离——轴在原点、名在
168:     // 上方；偏移与点值标记标签同族）。
169:     m_label.drawBillboard(Vector3D<double>(0.0, 0.0, kLabelLiftM), wTframe,
170:                           info, alpha);

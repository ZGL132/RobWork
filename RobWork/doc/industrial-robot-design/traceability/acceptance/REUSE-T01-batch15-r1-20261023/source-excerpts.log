154: bool HostView3DGateway::applyPreview(const View3DPreviewUpdate& update)
155: {
156:     // 预览诚实降级（渲染后端缺位＝呈现/TCP/预览三面独立降级的显式形态
157:     // ——headless/无缝装配下不虚构预览，调用方呈现失败原因）。
158:     if (!m_deps.previewBackend.draw) {
159:         return false;
160:     }
161:     // 整组绘制（原子替换语义在后端 draw 的实现契约——先清旧组再挂新组；
162:     // 失败＝保留旧呈现，"失败保持原状"事务语义与修订呈现同款）。
163:     if (!m_deps.previewBackend.draw(update)) {
164:         return false;
165:     }
166:     m_previewAttached = true;
167:     m_currentPreview = update;
168:     return true;
169: }

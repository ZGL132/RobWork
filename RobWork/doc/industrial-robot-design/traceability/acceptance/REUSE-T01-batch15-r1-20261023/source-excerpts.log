470: rw::core::Ptr<rw::models::WorkCell>
471: HostView3DPreviewBackend::ensureSessionPreviewAnchor(WorkCellScene& scene)
472: {
473:     // ①场景已挂 WorkCell＝原样复用（宿主装载/发布链/上次锚——幂等；
474:     // 重复 setWorkCell 会无谓重建场景节点树并触发查看器世界节点再同步，
475:     // 见下②注）。成员同步持有当前场景锚（可读性——所有权本身由场景
476:     // 共享属主保证）。
477:     if (!scene.getWorkCell().isNull()) {
478:         m_sessionAnchor = scene.getWorkCell();
479:         return m_sessionAnchor;
480:     }
481:     // ②新建会话预览锚 WC：仅含框架根帧的空 WorkCell（名＝ird 前缀族
482:     // 约定——诊断可辨识；WC 名不入任何身份/缓存键，runtime §8.2 同口
483:     // 径）。模型层隔离：studio->getWorkCell() 保持空——发布链"WorkCell
484:     // 即编译产物本体"（HostPresentationAdapters INV-B4 宿主单入口）与
485:     // TreeView 等订阅 studio 工作单元事件的宿主组件，对本锚零感知零干扰。
486:     // 查看器先行校验（不半装）：世界节点重同步是装入的必要半区——查看
487:     // 器缺位（headless 等装配降级）＝装了也渲染不出，如实返回空交调用
488:     // 方按"锚不可得"处理；实践中 scene 可取得则查看器必在位（同一
489:     // RWStudioView3D 持有），本分支为防御面。
490:     if (m_studio->getView() == nullptr
491:         || m_studio->getView()->getSceneViewer() == nullptr) {
492:         return nullptr;
493:     }
494:     m_sessionAnchor = rw::core::ownedPtr(
495:         new rw::models::WorkCell("ird-session-preview"));
496:     scene.setWorkCell(m_sessionAnchor);
497:     // 世界节点重同步（框架硬契约）：WorkCellScene::setWorkCell 会重建
498:     // 场景世界节点（旧节点从根摘除、新节点按锚 WC 帧树生成），而查看器
499:     // 缓存的是旧节点引用——框架自身路径（RWStudioView3D::setWorkCell/
500:     // clear 尾段）都在装 WC 后补 setWorldNode，本直连场景的装配路径必须
501:     // 同款补挂，否则新节点树不进渲染。
502:     m_studio->getView()->getSceneViewer()->setWorldNode(scene.getWorldNode());
503:     return m_sessionAnchor;
504: }

ui.SampleGridRender.draw sdurws::ird::ui::(anonymous namespace)::SampleGridRender::draw
266:     }
267: 
268:     void draw(const DrawableNode::RenderInfo& info,
269:               DrawableNode::DrawType type, double alpha) const override
270:     {
271:         (void)info;
272:         (void)type;
273:         const PreviewColorScope colorScope;
274:         // 格线骨架（UI-T52 字面化——采样格的线段呈现：灰细线与着色点并
275:         // 存〔格线＝格结构、点＝样本锚——两层视觉语义分离〕；空＝无格）。
276:         if (!m_gridLines.empty()) {
277:             glLineWidth(1.0f);
278:             glColor4f(0.55f, 0.55f, 0.60f, static_cast<float>(alpha));  // 格线灰
279:             glBegin(GL_LINES);
280:             for (const auto& seg : m_gridLines) {
281:                 glVertex3d(seg.first[0], seg.first[1], seg.first[2]);
282:                 glVertex3d(seg.second[0], seg.second[1], seg.second[2]);
283:             }
284:             glEnd();
285:         }
286:         // 采样点渲染（点阵着色——评估就位＝逐点分色；空＝中性灰诚实空态）。
287:         glPointSize(5.0f);
288:         glBegin(GL_POINTS);
289:         for (std::size_t i = 0; i < m_samples.size(); ++i) {
290:             glColor4f(0.6f, 0.6f, 0.6f, static_cast<float>(alpha));  // 中性灰
291:             if (i < m_states.size()) {
292:                 applyCellColor(m_states[i]);  // 评估就位＝逐点分色
293:             }
294:             const Vector3D<double>& p = m_samples[i];
295:             glVertex3d(p[0], p[1], p[2]);
296:         }
297:         glEnd();
298:         glPointSize(1.0f);
299:         // 高亮样本叠加层（FIX-T2——"蓝框=当前选中"：放大点＋蓝描边环，
300:         // 蓝色＝区域框缺省档词表同源（F-495 建议语义零新增色值）；
301:         // nullopt＝无高亮零产出——诚实空态不画占位）。
302:         if (m_highlighted.has_value()) {
303:             const Vector3D<double>& h = *m_highlighted;
304:             // 放大点芯（约 3 倍点径——与 5px 常规点在视觉上明确分层）。
305:             glPointSize(14.0f);
306:             // 词表是RGB三元组，glColor4fv会越界读取第4个float作为alpha，
307:             // 导致14px点芯透明/随机透明；显式使用回调alpha，保持宿主透明语义。
308:             glColor4f(ui::palette::kRegionTintDefaultGl[0],
309:                       ui::palette::kRegionTintDefaultGl[1],
310:                       ui::palette::kRegionTintDefaultGl[2],static_cast<float>(alpha));
311:             glBegin(GL_POINTS);
312:             glVertex3d(h[0], h[1], h[2]);
313:             glEnd();
314:             glPointSize(1.0f);
315:             // 蓝描边环（选中框语义的采样点形态——三轴小环近似"框"：
316:             // 世界系半径 0.06 m 与采样格间距同量级，工位级视距可辨）。
317:             glColor4f(ui::palette::kRegionTintDefaultGl[0],
318:                       ui::palette::kRegionTintDefaultGl[1],
319:                       ui::palette::kRegionTintDefaultGl[2],
320:                       static_cast<float>(alpha));
321:             glLineWidth(2.0f);
322:             constexpr double kHighlightRingRadius = 0.06;  // m——环半径
323:             for (int axis = 0; axis < 3; ++axis) {
324:                 glBegin(GL_LINE_LOOP);
325:                 for (int step = 0; step < 24; ++step) {
326:                     // 圆周参数化（24 段近似圆——固定管线无 GLU 依赖；
327:                     // 三正交平面各一环＝三轴环近似球框）。
328:                     const double theta = 2.0 * 3.14159265358979323846
329:                                        * static_cast<double>(step) / 24.0;
330:                     const double c = std::cos(theta) * kHighlightRingRadius;
331:                     const double s = std::sin(theta) * kHighlightRingRadius;
332:                     Vector3D<double> p = h;
333:                     switch (axis) {
334:                     case 0: p[1] += c; p[2] += s; break;  // XY 平面环
335:                     case 1: p[0] += c; p[2] += s; break;  // XZ 平面环
336:                     default: p[0] += c; p[1] += s; break;  // YZ 平面环
337:                     }
338:                     glVertex3d(p[0], p[1], p[2]);
339:                 }
340:                 glEnd();
341:             }
342:             glLineWidth(1.0f);
343:         }
344:     }

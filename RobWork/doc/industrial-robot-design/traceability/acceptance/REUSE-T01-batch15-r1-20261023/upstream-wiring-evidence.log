189: RenderText::RenderText (std::string text, Frame::Ptr frame) : _frame (frame), _font (HELVETICA_12)
190: {
191:     _text = " " + text + " ";
192:     findTextDimensions ();
193: }
194: 
195: void RenderText::draw (const DrawableNode::RenderInfo& info, DrawableNode::DrawType type,
196:                        double alpha) const
197: {
198:     if (_haveGlut && !info._cam.isNull ()) {
199:         SceneCamera::Ptr cam = info._cam;
200:         Transform3D<> wTf    = _frame->wTf (*(info._state));
201:         Transform3D<> wTc    = cam->getTransform ();
202:         Transform3D<> fTc    = inverse (wTf) * wTc;
203: 
204:         Vector3D<> pos (0, 0, 0);                // Initialize label position in frame
205:         moveCloserToCam (fTc, pos, 0.5, cam);    // Move the label closer to the camera to avoid,
206:                                                  // the 3D model to obscure the label
207:         drawText (pos, _text, _font);    // Draw the text
208: 
209:         // Get the corners for the label box
210:         std::vector< rw::math::Vector3D<> > corners = getLabelCorners (fTc, pos, 1, 1, 0, 0);
211: 
212:         // Render the label bounding box
213:         renderSquare (corners[0],
214:                       corners[1],
215:                       corners[2],
216:                       corners[3],
217:                       {255, 255, 255, float (alpha)},
218:                       {0.5, 0.5, 0.5, float (alpha)});
219:     }
220: }
221: 
222: std::vector< rw::math::Vector3D<> > RenderText::getLabelCorners (Transform3D<> fTc, Vector3D<> pos,
223:                                                                  double scale_x, double scale_y,
224:                                                                  int move_x, int move_y) const
225: {
226:     Vector3D<> posCam;
227:     double ppm    = pixelPerMeter (fTc, pos, posCam);
228:     double width  = scale_x * _textWidth / ppm;
229:     double height = scale_y * _textHight / ppm;
230:     double posX   = move_x / ppm;
231:     double posY   = (move_y - 5 * scale_y) / ppm;
232: 
233:     double offset = -0.00001;
234:     if (Vector3D<> (fTc.P () - pos).norm2 () < 0.01) {
235:         offset = 0;
236:     }
237:     Vector3D<> pos1 = fTc * (posCam + Vector3D<> (posX, posY, offset));
238:     Vector3D<> pos2 = fTc * (posCam + Vector3D<> (width + posX, posY, offset));
239:     Vector3D<> pos3 = fTc * (posCam + Vector3D<> (width + posX, height + posY, offset));
240:     Vector3D<> pos4 = fTc * (posCam + Vector3D<> (posX, height + posY, offset));


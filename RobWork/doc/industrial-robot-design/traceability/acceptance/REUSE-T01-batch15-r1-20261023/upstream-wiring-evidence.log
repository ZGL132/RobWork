89: RenderFrame::RenderFrame (float size) : _size (size), _quadratic (NULL)
90: {
91:     initializeColors (_red, _green, _blue);
92: }
93: 
94: RenderFrame::~RenderFrame ()
95: {
96:     if (_quadratic != NULL)
97:         gluDeleteQuadric (_quadratic);
98: }
99: 
100: void RenderFrame::draw (const DrawableNode::RenderInfo& info, DrawableNode::DrawType type,
101:                         double alpha) const
102: {
103:     if (_quadratic == NULL)
104:         _quadratic = gluNewQuadric ();
105:     const float width = 0.3f;
106:     _green[3]         = (float) alpha;
107:     _red[3]           = (float) alpha;
108:     _blue[3]          = (float) alpha;
109:     switch (type) {
110:         case DrawableNode::SOLID:
111:         case DrawableNode::OUTLINE:    // Draw nice frame
112:             glPolygonMode (GL_FRONT_AND_BACK, GL_FILL);
113:             renderSolid (1.0f, 0.3f, _size, _quadratic);
114:             break;
115:         case DrawableNode::WIRE: renderWire (width, _size); break;
116:     }
117: }


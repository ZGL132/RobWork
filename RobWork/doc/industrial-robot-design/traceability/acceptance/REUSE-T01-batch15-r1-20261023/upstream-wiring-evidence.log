376: bool HostWorkCellPresentationObject::apply() const
377: {
378:     // 宿主单入口（框架公开 API——TreeView 与三维场景从同一载体刷新；
379:     // INV-B4 一致性的宿主半区）。WorkCell 即编译链产物本体（对象同一性
380:     // ——hostPresentationWorkCell 出口，零复制）。
381:     if (m_studio == nullptr || m_view == nullptr) {
382:         return false;  // 装配缺位（诚实失败——网关保留旧呈现）
383:     }
384:     const rw::models::WorkCell::Ptr workcell = m_view->hostPresentationWorkCell();
385:     if (workcell.isNull()) {
386:         return false;  // 快照无 WC（结构性不可达——hasWorkCell 恒 true）防御面
387:     }
388:     m_studio->setWorkCell(workcell);
389:     // ---- 发布模型几何呈现分组校准（UI-T78——WP-10-T05 阶段 B 渲染面）：
390:     // setWorkCell 触发框架 updateSceneGraph 后，RT-T15 编译图元 drawable
391:     // 已按 Geometry 缺省分组（CollisionObject）落景——产品主相机缺省绘制
392:     // 掩码不含该组（ShowCollisionModels=false 既有值），不校准则发布模型
393:     // 几何整体不可见。此处把模型 drawable 校准为 Physical 组（缺省可见＋
394:     // 渲染分组显隐菜单管辖——契约头 kPublishedModelRenderGroup 注释）。
395:     // 校准在骨架呈现之前：先模型几何、后骨架辅助层——挂接叙事的层次序。
396:     // 场景缺位（headless 装配降级）＝与骨架同款诚实降级（WC 已装入、
397:     // 呈现缺位——不虚构）。
398:     // ---- 发布模型骨架三维呈现（UI-T77——F-550）：宿主单入口装入后把
399:     // 帧树/设备链呈现进三维（此前三维仅网格＝发布后模型不可见）。挂在
400:     // 发布 WC 的场景节点上——setWorkCell 换 WC 时随旧节点树整体收口
401:     // （见 applyPublishedModelSkeleton 类注生命周期），本对象 remove()
402:     // 的空动作语义不受影响。
403:     // 两半区生命周期同款纪律：drawable 全挂发布 WC 的场景节点（模型图元
404:     // 由框架 updateSceneGraph 建、骨架由 addFrameAxis/addRender 建），
405:     // setWorkcell 换 WC（新实例＝对象身份不同）即旧节点树整体销毁重建
406:     // ——发布/重编译/项目切换三拍零残留、零清理名单（UI-T78 渲染面
407:     // 具名用例在 ui_test 钉扎：重编译产物 WC 新实例＋清单确定性）。
408:     rw::graphics::WorkCellScene::Ptr scene = m_studio->getWorkCellScene();
409:     if (!scene.isNull()) {
410:         calibratePublishedModelRenderGroups(*scene, *workcell);
411:         applyPublishedModelSkeleton(*scene, *workcell);
412:     }  // 场景缺位（headless 装配降级）＝WC 已装入、呈现缺位——诚实降级
413:     return true;
414: }

824: bool WorkCellScene::removeDrawable (const std::string& name)
825: {
826:     FindDrawableVisitor visitor (name, false);
827:     SceneNode::Ptr root = _worldNode.cast< SceneNode > ();
828:     _scene->traverse (root, visitor.functor, StaticFilter (false).functor);
829:     if (visitor._dnode.isNull ())
830:         return true;
831:     if (GroupNode* const gn = visitor._pnode->asGroupNode ()) {
832:         const NodeFrameMap::const_iterator itF = _nodeFrameMap.find (gn);
833:         if (itF != _nodeFrameMap.end ()) {
834:             std::map< const Frame*, std::vector< DrawableNode::Ptr > >::iterator itD =
835:                 _frameDrawableMap.find (itF->second);
836:             if (itD != _frameDrawableMap.end ()) {
837:                 std::vector< DrawableNode::Ptr >& drawables = itD->second;
838:                 for (std::vector< DrawableNode::Ptr >::iterator itDrawables = drawables.begin ();
839:                      itDrawables != drawables.end ();
840:                      itDrawables++) {
841:                     if ((*itDrawables)->getName () == name) {
842:                         drawables.erase (itDrawables);
843:                         break;
844:                     }
845:                 }
846:             }
847:         }
848:     }
849: 
850:     return _scene->removeDrawable (name);
851: }


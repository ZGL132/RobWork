40: void renderSolid (float alpha, float width, float size, GLUquadricObj* quad)
41: {
42:     const float REL_WIDTH = 0.05f;
43:     const float lenHead   = size * 3 * REL_WIDTH;    // the arrow head
44:     const float widthHead = size * 2 * REL_WIDTH;
45:     const float lenBody   = size - lenHead;    // the arrow body
46:     const float widthBody = width * size * REL_WIDTH;
47: 
48:     // Nice frame
49:     // Draw z-axis
50:     glColor4f (0.0f, 0.0f, 1.0f, alpha);                          // Blue color
51:     gluCylinder (quad, widthBody, widthBody, lenBody, 32, 32);    // Draw Our Cylinder
52:     glTranslatef (0.0f, 0.0f, lenBody);                           // Center The Cone
53:     gluCylinder (quad, widthHead, 0.0f, lenHead, 32, 32);         // A Cone
54: 
55:     // Draw x-axis
56:     glColor4f (1.0f, 0.0f, 0.0f, alpha);                          // Red color
57:     glTranslatef (0.0f, 0.0f, -lenBody);                          // Center The Cylinder
58:     glRotatef (90.0f, 0.0f, 1.0f, 0.0f);                          // Rotate around y-ax
59:     gluCylinder (quad, widthBody, widthBody, lenBody, 32, 32);    // Draw Our Cylinder
60:     glTranslatef (0.0f, 0.0f, lenBody);                           // Center The Cone
61:     gluCylinder (quad, widthHead, 0.0f, lenHead, 32, 32);         // A Cone
62: 
63:     // Draw y-axis
64:     glColor4f (0.0f, 1.0f, 0.0f, alpha);                          // Green color
65:     glTranslatef (0.0f, 0.0f, -lenBody);                          // Center The Cylinder
66:     glRotatef (90.0f, -1.0f, 0.0f, 0.0f);                         // Rotate around y-axis
67:     gluCylinder (quad, widthBody, widthBody, lenBody, 32, 32);    // Draw Our Cylinder
68:     glTranslatef (0.0f, 0.0f, lenBody);                           // Center The Cone
69:     gluCylinder (quad, widthHead, 0.0f, lenHead, 32, 32);         // A Cone
70: }

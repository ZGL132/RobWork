4724: void IrdWorkbenchHostPlugin::assembleView3DGateway()
4725: {
4726:     // 宿主三维网关装配（UI-T45——方案 spec 三桥一源的宿主半区；SA-02：
4727:     // 全部经 RWStudioView3D 公开 API 消费，事件注入＝过滤器外挂）。
4728:     if (m_view3dGateway != nullptr || m_domains == nullptr
4729:         || m_selection == nullptr || m_nameMapPort == nullptr) {
4730:         return;  // 已装配/依赖缺席（幂等静默——装配序保证）
4731:     }
4732:     rws::RobWorkStudio* studio = getRobWorkStudio();
4733:     const rws::RWStudioView3D::Ptr view =
4734:         studio != nullptr ? studio->getView() : nullptr;
4735:     if (view == nullptr) {
4736:         // 降级基线（spec §4）：视图不可得＝网关不装配——上行拾取/TCP 源
4737:         // /呈现出口三面缺席（选择服务既有 outlet 保持显式形态），不虚构
4738:         // 三维能力（UX-11/ERR-01）。
4739:         if (m_diag.pipeline) {
4740:             m_diag.pipeline->logDev(kPluginDevChannel,
4741:                                     "view3d gateway: RWStudioView3D 不可得——三桥不接（降级基线）");
4742:         }
4743:         return;
4744:     }
4745: 
4746:     HostView3DGateway::Deps deps;
4747:     /** @brief UI线程最近真实拾取的值锚；函数闭包共享持有，场景Ptr防地址复用。
4748:      * 只缓存交互结果，不作名称或修订真值；每次消费仍查询现有权威端口。
4749:      */
4750:     struct RequirementsPickedAnchor {
4751:         rw::models::WorkCell::Ptr scene;
4752:         std::optional<core::ObjectId> objectId;
4753:         std::string projectId;
4754:         std::string revisionId;
4755:     };
4756:     const auto pickedAnchor = std::make_shared<RequirementsPickedAnchor>();
4757:     // 上行仍使用框架真实raycast；把反解结果固定到发起时项目/修订/场景。
4758:     // 此缓存与业务选中分离，用户回到需求工位后仍可确认刚拾取的夹具Frame。
4759:     deps.pickFrame = [this, view, studio, pickedAnchor](int x, int y) {
4760:         *pickedAnchor = RequirementsPickedAnchor{}; // 空白/失败拾取立即使旧结果失效。
4761:         auto* frame = view->pickFrame(x, y);
4762:         const auto adapter = m_lastStoreAdapter;
4763:         if (frame && studio && adapter && !adapter->isClosed() && m_nameMapPort) {
4764:             pickedAnchor->objectId = m_nameMapPort->resolveObjectIdFromRuntimeName(frame->getName());
4765:             if (pickedAnchor->objectId) {
4766:                 pickedAnchor->scene = studio->getWorkCell();
4767:                 pickedAnchor->projectId = adapter->projectStore().projectId().toCanonical();
4768:                 pickedAnchor->revisionId = adapter->projectStore().query().head().id.toCanonical();
4769:             }
4770:         }
4771:         return frame;
4772:     };
4773:     // TCP 帧缝（设备名→JointDevice 末端帧——WorkCell 现查，非 owning）。
4774:     deps.resolveTcpFrame = [studio](const std::string& deviceName)
4775:         -> const rw::kinematics::Frame* {
4776:         if (studio == nullptr) {
4777:             return nullptr;
4778:         }
4779:         const rw::models::WorkCell::Ptr workcell = studio->getWorkCell();
4780:         if (workcell.isNull()) {
4781:             return nullptr;
4782:         }
4783:         const auto device =
4784:             workcell->findDevice<rw::models::JointDevice>(deviceName);
4785:         return device != nullptr ? device->getEnd() : nullptr;
4786:     };
4787:     // 会话态缝（宿主当前 State——只读借用，KIN-06 零修订）。

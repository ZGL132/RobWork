FILE: RobWork/RobWorkStudio/src/rwslibs/industrialrobot/evidence/test/TestMainReport.cpp evidence.TestMainReport.main
23: int main(int argc, char** argv)
24: {
25:     ::testing::InitGoogleTest(&argc, argv);
26:     // 监听器为静态存储期对象（gtest listeners 不接管所有权）；聚合报告
27:     // 在 OnTestProgramEnd 写盘（--ird_report=<path> 指定，缺省＝工作目录
28:     // 下 ird-test-report.json）；写盘失败只向 stderr 告警，不掩盖测试
29:     // 结果（RecordListener 契约——gtest 退出码仍真实反映用例成败）。
30:     sdurws::ird::testkit::installTestRecordListener(argc, argv);
31:     return RUN_ALL_TESTS();
32: }

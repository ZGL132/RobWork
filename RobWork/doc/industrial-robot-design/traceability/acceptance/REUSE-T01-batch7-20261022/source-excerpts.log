FILE: RobWork/RobWorkStudio/src/rwslibs/industrialrobot/evidence/src/Snapshot.cpp evidence.Snapshot.appendLengthString
130: void appendLengthString(std::vector<std::uint8_t>& out, const std::string& s)
131: {
132:     if (s.find('\0') != std::string::npos) {
133:         throw EvidenceError(EvidenceErrorCode::SnapshotIncomplete,
134:                             "字符串含 NUL（§5.2 编码安全）");
135:     }
136:     if (s.size() > 0xFFFFu) {
137:         throw EvidenceError(EvidenceErrorCode::SnapshotIncomplete,
138:                             "字符串超出 65535 字节编码上限（长度 "
139:                                 + std::to_string(s.size()) + "）");
140:     }
141:     appendU16(out, static_cast<std::uint16_t>(s.size()));
142:     appendRaw(out, reinterpret_cast<const std::uint8_t*>(s.data()), s.size());
143: }

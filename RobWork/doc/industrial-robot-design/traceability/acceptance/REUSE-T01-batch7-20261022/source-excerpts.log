FILE: RobWork/RobWorkStudio/src/rwslibs/industrialrobot/evidence/src/Evidence.cpp evidence.Evidence.appendU32
51: void appendU32(std::vector<std::uint8_t>& out, std::uint32_t v)
52: {
53:     out.push_back(static_cast<std::uint8_t>((v >> 24) & 0xFFu));
54:     out.push_back(static_cast<std::uint8_t>((v >> 16) & 0xFFu));
55:     out.push_back(static_cast<std::uint8_t>((v >> 8) & 0xFFu));
56:     out.push_back(static_cast<std::uint8_t>(v & 0xFFu));
57: }

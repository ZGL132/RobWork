118: /// JSON 取数（缺字段即失败后返回 0——同上）。
119: double jNum(const tk::JsonValue& o, const std::string& k)
120: {
121:     const tk::JsonValue* v = o.find(k);
122:     if (v == nullptr) {
123:         ADD_FAILURE() << "JSON 缺字段: " << k;
124:         return 0.0;
125:     }
126:     return v->number;
127: }


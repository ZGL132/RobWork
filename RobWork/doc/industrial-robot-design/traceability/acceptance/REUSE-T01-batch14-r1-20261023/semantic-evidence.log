773: /// 路径类字段（externalRefs[].absolutePath）的落值口径：非空、无控制字符
774: /// （C0/C1——转义注入的换行/NUL 破坏清单文件的行结构，且无合法路径含控制
775: /// 字符）、≤4096 字节（长路径预算；与 io SafePath 的最终校验分工——§5.7
776: /// 责任划分：解析/存在性/安全归 io，本层只挡结构级失控）。允许空格与
777: /// 非 ASCII（Windows 长路径/中文路径均为合法登记对象——UTF-8 经 \uXXXX
778: /// 转义承载，§4.8）。
779: std::string requirePathField(const JsonValue& obj, const char* key)
780: {
781:     const std::string s = requireStringField(obj, key);
782:     if (s.empty()) { corrupt(std::string("field '") + key + "' must not be empty"); }
783:     if (s.size() > 4096) {
784:         corrupt(std::string("field '") + key + "' exceeds 4096 bytes");
785:     }
786:     for (const char c : s) {
787:         const auto u = static_cast<unsigned char>(c);
788:         if (u < 0x20 || u == 0x7F) {
789:             corrupt(std::string("field '") + key
790:                     + "' must not contain control characters");
791:         }
792:     }
793:     return s;
794: }

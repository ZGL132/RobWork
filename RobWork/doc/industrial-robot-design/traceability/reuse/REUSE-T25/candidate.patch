@@ -840,6 +840,36 @@ TEST_F(TxEngineTest, HeadManifestDigest_MatchesDirectCoreDigester)
  * 预期：StoreError(WriteRejected)；HEAD 字节不变；无新修订目录；暂存区
  * 无残留事务目录（空壳已尽力清理）。
  */
+// NFR-REL-01／PRJ-TX-10／F-963：以 SDK 的真实错误身份验证生产映射，
+// 旧误用的 70/395 实际代表其他错误，必须落回原 WriteRejected 兜底。
+TEST_F(TxEngineTest, F963_SdkWriteErrors_StableCategoryAndUnchangedBytes)
+{
+    const std::pair<unsigned long, StoreErrorCode> cases[] = {
+        {ERROR_DISK_FULL, StoreErrorCode::DiskFull},
+        {ERROR_DISK_QUOTA_EXCEEDED, StoreErrorCode::DiskFull},
+        {ERROR_ACCESS_DENIED, StoreErrorCode::AccessDenied},
+        {ERROR_SHARING_PAUSED, StoreErrorCode::WriteRejected},
+        {ERROR_CLOUD_FILE_ACCESS_DENIED, StoreErrorCode::WriteRejected},
+        {ERROR_INVALID_NAME, StoreErrorCode::WriteRejected}
+    };
+    const auto before = snapshotCommitted();
+    for (const auto& item : cases) {
+        SCOPED_TRACE(item.first);
+        // 复用原文件接缝，在下一次准备动作注入；不实际耗尽磁盘或改变 ACL。
+        m_ops->failAt(fp::kCreateDirectories,
+                     m_ops->hits(fp::kCreateDirectories) + 1, item.first);
+        const auto plan = makePlan();
+        const auto err = expectStoreError(item.second, [&] {
+            m_engine->commit(plan, m_engine->readHead(), m_seed.m0, m_seed.m0Ref);
+        });
+        // 分类只适配稳定码，原生错误身份仍保留在 detail，供开发诊断定位。
+        EXPECT_NE(std::string(err.what()).find("osError=" + std::to_string(item.first)),
+                  std::string::npos);
+        EXPECT_EQ(snapshotCommitted(), before);
+        EXPECT_TRUE(m_bus->events.empty());
+    }
+}

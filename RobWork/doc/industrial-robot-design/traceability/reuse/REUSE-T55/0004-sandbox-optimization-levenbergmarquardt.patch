+﻿/*
+ * LevenbergMarquardtOptimizer.hpp
+ *
+ *  Created on: Oct 28, 2026
+ *
+ *  Levenberg-Marquardt 最小二乘优化器（SA-02 登记的最小上游扩展，授权见
+ *  industrial-robot-design/reuse/migration.md §13.5.6 第 2 条，登记于
+ *  industrialrobot/patches/PATCHES.md）。纯数值通用实现：残差 functor 由
+ *  调用方注入，不携带任何产品业务判定。
+ */
+
+#ifndef SRC_RWLIBS_OPTIMIZATION_LEVENBERGMARQUARDTOPTIMIZER_HPP_
+#define SRC_RWLIBS_OPTIMIZATION_LEVENBERGMARQUARDTOPTIMIZER_HPP_
+
+#include <cstddef>
+#include <rw/core/Ptr.hpp>
+#include <rw/core/macros.hpp>
+#include <vector>
+
+#include "FirstDifferences.hpp"
+#include "NumericalDerivative.hpp"
+#include "Optimizer.hpp"
+#include "Types.hpp"
+
+namespace rwlibs {
+namespace optimization {
+
+/** @addtogroup optimization */
+/*@{*/
+
+/**
+ * @brief Levenberg-Marquardt 最小二乘优化器。
+ *
+ * 最小化目标 F(x) = 0.5·Σ_i r_i(x)²，其中 r_i: VectorType -> double 为注入的
+ * 残差 functor（m 个 FunctionType::Ptr，顺序即雅可比行序，构造后固定不变）。
+ *
+ * 单步核心（固定算术序，详见 LevenbergMarquardtOptimizer.cpp 的 step()）：
+ *  - 残差向量 r 与数值雅可比 J（复用 NumericalDerivative/FirstDifferences 中心差分）；
+ *  - 正规方程 (JᵀJ + λ·diag(d))·δ = -Jᵀr，d_j = max(JᵀJ)_jj（Marquardt 缩放，
+ *    带 1e-12 下限防奇异），Eigen PartialPivLU 求解；
+ *  - 阻尼自适应：接受步 λ ← λ/factorDown，拒绝步 λ ← λ·factorUp，
+ *    并夹取到可配界 [λmin, λmax]（阻尼上限）；
+ *  - 停滞判据：连续 maxStagnationSteps 步无实质改进（拒绝步、代价改进或步长
+ *    低于容差）即冻结迭代。
+ *
+ * 确定性策略（NFR-COR-01/02 口径）：
+ *  - 无任何随机源（区别于 SimulatedAnnealingOptimizer）；
+ *  - 所有循环、累加与比较的算术序固定，同输入同平台必然逐位复现；
+ *  - 线性求解用 PartialPivLU，主元选择对同一矩阵确定；
+ *  - 基类循环的迭代上限经 StopCondition 配置（家族口径）。
+ *
+ * @note 误差语义：currentError 为本步雅可比计算点的 ‖Jᵀr‖₂（F 的梯度范数），
+ * 接受步时相对新点滞后一步；基类接口（只读，不在本补丁范围）无法从 step()
+ * 内部终止循环，停滞冻结后剩余迭代为 O(1) 空操作，由 StopCondition 收尾。
+ */
+class LevenbergMarquardtOptimizer: public Optimizer {
+public:
+	//! Smart pointer.
+	typedef rw::core::Ptr<LevenbergMarquardtOptimizer> Ptr;
+
+	//! Vector type used for internal calculations.
+	typedef Eigen::VectorXd vector;
+
+	//! Matrix type used for internal calculations.
+	typedef Eigen::MatrixXd matrix;
+
+	//! Numerical derivative method type（与 GradientOptimizer 同族；类内命名避免与其匿名命名空间 typedef 冲突）.
+	typedef rw::math::NumericalDerivative<ResultType, VectorType, GradientType> NumericalDerivativeMethod;
+
+	//! First differences (central difference) derivative method type.
+	typedef rw::math::FirstDifferences<ResultType, VectorType, GradientType> FirstDifferencesMethod;
+
+public:
+	/**
+	 * @brief Constructor.
+	 *
+	 * @param residuals [in] 残差 functor 列表（m ≥ 1，不得含空指针；构造后固定）
+	 * @param initialLambda [in] 初始阻尼因子 λ（> 0，默认 1e-3）
+	 * @param numericalDerivative [in] 数值导数方法（默认中心差分，步长 1e-6）
+	 */
+	LevenbergMarquardtOptimizer(const std::vector<FunctionType::Ptr>& residuals,
+			double initialLambda = 1e-3,
+			typename NumericalDerivativeMethod::Ptr numericalDerivative =
+					rw::core::ownedPtr(new FirstDifferencesMethod(1e-6)));
+
+	//! Destructor.
+	virtual ~LevenbergMarquardtOptimizer();
+
+	/**
+	 * @brief 阻尼因子夹取界（可配的阻尼上下限）。
+	 *
+	 * @param lambdaMin [in] 下界（> 0）
+	 * @param lambdaMax [in] 上界（≥ lambdaMin）；触界仍无改善即停滞
+	 */
+	void setLambdaBounds(double lambdaMin, double lambdaMax) {
+		if (lambdaMin <= 0.0 || lambdaMax < lambdaMin)
+			RW_THROW("LevenbergMarquardtOptimizer: require 0 < lambdaMin <= lambdaMax");
+		_lambdaMin = lambdaMin;
+		_lambdaMax = lambdaMax;
+	}
+
+	/**
+	 * @brief 阻尼缩放倍率（接受步除以 \b factorDown，拒绝步乘以 \b factorUp）。
+	 *
+	 * @param factorDown [in] 接受步缩放倍率（> 1）
+	 * @param factorUp [in] 拒绝步放大倍率（≥ factorDown）
+	 */
+	void setLambdaFactors(double factorDown, double factorUp) {
+		if (factorDown <= 1.0 || factorUp < factorDown)
+			RW_THROW("LevenbergMarquardtOptimizer: require 1 < factorDown <= factorUp");
+		_lambdaFactorDown = factorDown;
+		_lambdaFactorUp = factorUp;
+	}
+
+	/**
+	 * @brief 停滞步数上限：连续 \b steps 步无实质改进即冻结迭代（≥ 1）。
+	 */
+	void setMaxStagnationSteps(std::size_t steps) {
+		if (steps < 1)
+			RW_THROW("LevenbergMarquardtOptimizer: maxStagnationSteps must be >= 1");
+		_maxStagnationSteps = steps;
+	}
+
+	/**
+	 * @brief 停滞容差：代价改进 ≤ \b costTolerance·(1+|F|)（F 为改进起算点，
+	 * 即本步开始时的代价）或步长 ‖δ‖₂ ≤ \b stepTolerance 视为无实质改进。
+	 */
+	void setStagnationTolerances(double costTolerance, double stepTolerance) {
+		if (costTolerance < 0.0 || stepTolerance < 0.0)
+			RW_THROW("LevenbergMarquardtOptimizer: stagnation tolerances must be >= 0");
+		_costTolerance = costTolerance;
+		_stepTolerance = stepTolerance;
+	}
+
+	//! Get current damping factor.
+	double getLambda() const {
+		return _lambda;
+	}
+
+	//! Is the optimizer frozen by the stagnation criterion?
+	bool isStagnated() const {
+		return _stagnated;
+	}
+
+	//! Get the number of consecutive stagnant steps.
+	std::size_t getStagnationCount() const {
+		return _stagnationCount;
+	}
+
+protected:
+	//! @copydoc Optimizer::newOptimization
+	virtual void newOptimization(const VectorType& initialGuess,
+			ResultType& initialValue, double& initialError);
+
+	//! @copydoc Optimizer::step
+	virtual void step(VectorType& currentGuess, ResultType& currentValue,
+			double& currentError);
+
+private:
+	std::vector<FunctionType::Ptr> _residuals; //! 残差 functor（行序固定）
+	FunctionType::Ptr _cost; //! 残差平方和代价 F(x)=0.5·Σ r_i²（基类 currentValue 语义）
+	typename NumericalDerivativeMethod::Ptr _derivative; //! 数值雅可比方法
+
+	double _initialLambda; //! 每次 optimize() 重置的初始阻尼
+	double _lambda; //! 当前阻尼因子
+	double _lambdaMin; //! 阻尼下界
+	double _lambdaMax; //! 阻尼上界（停滞判据的一部分）
+	double _lambdaFactorDown; //! 接受步阻尼缩放倍率
+	double _lambdaFactorUp; //! 拒绝步阻尼放大倍率
+
+	std::size_t _maxStagnationSteps; //! 连续停滞步数上限
+	std::size_t _stagnationCount; //! 当前连续停滞计数
+	double _costTolerance; //! 代价改进停滞容差（相对形式）
+	double _stepTolerance; //! 步长范数停滞容差
+	bool _stagnated; //! 停滞冻结标志
+};
+
+/*@}*/
+
+} /* namespace optimization */
+} /* namespace rwlibs */
+
+#endif /* SRC_RWLIBS_OPTIMIZATION_LEVENBERGMARQUARDTOPTIMIZER_HPP_ */

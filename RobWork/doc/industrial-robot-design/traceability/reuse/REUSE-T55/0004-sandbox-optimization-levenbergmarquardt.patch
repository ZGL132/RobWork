+﻿/*
+ * LevenbergMarquardtOptimizer.cpp
+ *
+ *  Created on: Oct 28, 2026
+ *
+ *  Levenberg-Marquardt 最小二乘优化器实现（SA-02 登记的最小上游扩展）。
+ *  确定性优先（NFR-COR-01/02 口径）：全实现无随机源；遍历、累加、比较与
+ *  λ 更新的算术序固定并在各步骤注释中标明，同输入同平台必然逐位复现。
+ */
+
+#include "LevenbergMarquardtOptimizer.hpp"
+
+#include <Eigen/Dense>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace rwlibs {
+namespace optimization {
+
+namespace { /* anonymous namespace */
+
+/**
+ * @brief 残差平方和代价函数 F(x) = 0.5·Σ_i r_i(x)²。
+ *
+ * 供基类 Optimizer 的 currentValue/getFunction 语义使用；累加按残差下标
+ * 升序固定进行（与 step() 中试验点求值保持同一算术来源）。
+ */
+class SumOfSquaresCost: public FunctionType {
+public:
+	//! Constructor.
+	explicit SumOfSquaresCost(const std::vector<FunctionType::Ptr>& residuals) :
+			_residuals(residuals) {
+	}
+
+	//! Destructor.
+	virtual ~SumOfSquaresCost() {
+	}
+
+	//! @copydoc Function::f
+	virtual ResultType f(VectorType q) {
+		double sum = 0.0;
+		for (std::size_t i = 0; i < _residuals.size(); ++i) {
+			const double ri = _residuals[i]->f(q);
+			sum += ri * ri; // 固定顺序累加（残差下标升序）
+		}
+		return 0.5 * sum;
+	}
+
+private:
+	std::vector<FunctionType::Ptr> _residuals;
+};
+
+} /* anonymous namespace */
+
+LevenbergMarquardtOptimizer::LevenbergMarquardtOptimizer(
+		const std::vector<FunctionType::Ptr>& residuals, double initialLambda,
+		typename NumericalDerivativeMethod::Ptr numericalDerivative) :
+		Optimizer(rw::core::ownedPtr(new SumOfSquaresCost(residuals))), //
+		_residuals(residuals), _cost(getFunction()), _derivative(numericalDerivative), //
+		_initialLambda(initialLambda), _lambda(initialLambda), //
+		_lambdaMin(1e-12), _lambdaMax(1e12), //
+		_lambdaFactorDown(2.0), _lambdaFactorUp(10.0), //
+		_maxStagnationSteps(5), _stagnationCount(0), //
+		_costTolerance(1e-12), _stepTolerance(1e-12), _stagnated(false) {
+	// 构造即校验入参（fail-fast）：残差列表非空且不含空指针，阻尼初值为正。
+	if (residuals.empty())
+		RW_THROW("LevenbergMarquardtOptimizer: at least one residual function is required");
+	for (std::size_t i = 0; i < residuals.size(); ++i) {
+		if (!residuals[i])
+			RW_THROW("LevenbergMarquardtOptimizer: residual function at index " << i << " is null");
+	}
+	if (initialLambda <= 0.0)
+		RW_THROW("LevenbergMarquardtOptimizer: initialLambda must be > 0, got " << initialLambda);
+}
+
+LevenbergMarquardtOptimizer::~LevenbergMarquardtOptimizer() {
+}
+
+void LevenbergMarquardtOptimizer::newOptimization(const VectorType& initialGuess,
+		ResultType& initialValue, double& initialError) {
+	// 重置迭代状态：阻尼回到初值，停滞计数清零。
+	_lambda = _initialLambda;
+	_stagnationCount = 0;
+	_stagnated = false;
+
+	// 初始代价经同一 SumOfSquaresCost 求值；初始误差置最大（首步后由梯度范数给出）。
+	initialValue = _cost->f(initialGuess);
+	initialError = std::numeric_limits<double>::max();
+}
+
+void LevenbergMarquardtOptimizer::step(VectorType& currentGuess,
+		ResultType& currentValue, double& currentError) {
+	// 停滞冻结后不再改动任何状态：基类循环（接口只读，不在本补丁范围）无法从
+	// step() 内部终止，剩余迭代由 StopCondition 的迭代上限收尾，各步为 O(1) 空操作。
+	if (_stagnated) {
+		return;
+	}
+
+	const std::size_t m = _residuals.size();
+	const Eigen::Index n = static_cast<Eigen::Index>(currentGuess.size());
+
+	/*
+	 * 1) 残差向量与数值雅可比（复用 NumericalDerivative/FirstDifferences 中心差分）。
+	 *    遍历序固定：残差 i 外层升序、参数 j 内层升序；同输入必然产出同雅可比。
+	 */
+	vector r = vector::Zero(static_cast<Eigen::Index>(m));
+	matrix J = matrix::Zero(static_cast<Eigen::Index>(m), n);
+	for (std::size_t i = 0; i < m; ++i) {
+		r(static_cast<Eigen::Index>(i)) = _residuals[i]->f(currentGuess);
+
+		const GradientType row = _derivative->derivative(_residuals[i], currentGuess);
+		for (Eigen::Index j = 0; j < n; ++j) {
+			J(static_cast<Eigen::Index>(i), j) = row(j);
+		}
+	}
+
+	// 2) 正规方程：H = JᵀJ（半正定），g = Jᵀr（F 的梯度）。Eigen 密集乘积分块序固定。
+	const matrix H = J.transpose() * J;
+	const vector g = J.transpose() * r;
+
+	/*
+	 * 3) Marquardt 缩放对角：d_j = max(H_jj, 1e-12)。下限固定，防止零列导致
+	 *    JᵀJ + λ·diag(d) 奇异；d 按下标升序生成，先于 λ 参与后续算式。
+	 */
+	const double diagonalFloor = 1e-12;
+	vector d = vector::Zero(n);
+	for (Eigen::Index j = 0; j < n; ++j) {
+		d(j) = std::max(H(j, j), diagonalFloor);
+	}
+
+	// 4) 解 (JᵀJ + λ·diag(d))·δ = -g。PartialPivLU 主元选择对同一矩阵确定，无随机源。
+	//    λ·d 就地加到 H 的对角（A 的构造顺序固定：先复制 H，再对角逐位相加）。
+	matrix A = H;
+	for (Eigen::Index j = 0; j < n; ++j) {
+		A(j, j) += _lambda * d(j);
+	}
+	const Eigen::PartialPivLU<matrix> lu(A);
+	const vector delta = lu.solve(-g);
+
+	/*
+	 * 5) 预测下降量（标准二次模型，固定算式）：由正规方程 gᵀδ = -δᵀHδ - λ·Σ_j d_j·δ_j²
+	 *    代入 predRed = -(gᵀδ + 0.5·δᵀHδ + 0.5·λ·Σ_j d_j·δ_j²)，得
+	 *    predRed = 0.5·δᵀHδ + 0.5·λ·Σ_j d_j·δ_j² ≥ 0；两项分别按下标序/点积序计算。
+	 *    该值仅用于 >0 的符号判断（第 7 步），δ=0 时两项同为 0 ⇒ 拒绝。
+	 */
+	const double quadH = delta.dot(H * delta);
+	double dampTerm = 0.0;
+	for (Eigen::Index j = 0; j < n; ++j) {
+		dampTerm += d(j) * delta(j) * delta(j);
+	}
+	const double predictedReduction = 0.5 * quadH + 0.5 * _lambda * dampTerm;
+
+	// 6) 试验点评估：x⁺ = x + δ；代价固定经同一 SumOfSquaresCost 求值（累加序同上）。
+	const VectorType trialGuess = currentGuess + VectorType(delta);
+	const double trialValue = _cost->f(trialGuess);
+	const double improvement = currentValue - trialValue;
+
+	// 7) 接受/拒绝：预测与实际下降均为正才接受；λ 缩放倍率固定（可配，见头文件）。
+	const bool accepted = (predictedReduction > 0.0) && (improvement > 0.0);
+	// 停滞容差的相对尺度按改进起算点（本步开始时的代价 F）固定，先于状态更新取值，
+	// 使接受步与拒绝步的判据取值时点一致（避免误用更新后的 F⁺）。
+	const double costScale = 1.0 + std::fabs(currentValue);
+	if (accepted) {
+		currentGuess = trialGuess;
+		currentValue = trialValue;
+		_lambda /= _lambdaFactorDown;
+	} else {
+		_lambda *= _lambdaFactorUp;
+	}
+	// λ 夹取顺序固定：先下界后上界。λ 触及上界仍无改善 ⇒ 停滞计数必然累计。
+	if (_lambda < _lambdaMin) {
+		_lambda = _lambdaMin;
+	}
+	if (_lambda > _lambdaMax) {
+		_lambda = _lambdaMax;
+	}
+
+	/*
+	 * 8) 停滞判据（固定算术序）：拒绝步、代价改进 ≤ costTolerance·(1+|F|)
+	 *    （F 为改进起算点，即本步开始时的代价），或步长 ‖δ‖₂ ≤ stepTolerance，
+	 *    均计一次停滞；否则清零。连续 maxStagnationSteps 次即冻结迭代。
+	 */
+	const double stepNorm = delta.norm();
+	if (!accepted || improvement <= _costTolerance * costScale
+			|| stepNorm <= _stepTolerance) {
+		++_stagnationCount;
+	} else {
+		_stagnationCount = 0;
+	}
+	if (_stagnationCount >= _maxStagnationSteps) {
+		_stagnated = true;
+	}
+
+	/*
+	 * 9) 误差状态：本步雅可比计算点的 ‖Jᵀr‖₂（F 的梯度范数），供 StopCondition 的
+	 *    minTolerance 终止判断；接受步时相对新点滞后一步，下一迭代即在新点重算。
+	 */
+	currentError = g.norm();
+}
+
+} /* namespace optimization */
+} /* namespace rwlibs */

diff --git a/RobWork/RobWorkStudio/src/rwslibs/industrialrobot/core/src/Compare.cpp b/RobWork/RobWorkStudio/src/rwslibs/industrialrobot/core/src/Compare.cpp
index ae3833c40..912054c93 100644
--- a/RobWork/RobWorkStudio/src/rwslibs/industrialrobot/core/src/Compare.cpp
+++ b/RobWork/RobWorkStudio/src/rwslibs/industrialrobot/core/src/Compare.cpp
@@ -18,9 +18,7 @@ namespace sdurws::ird::core {
 bool closeWithin(double value, double reference, Tolerance t) noexcept
 {
     // 非有限输入 → false（不抛、不静默通过——NFR-COR-03；noexcept 契约）。
-    const bool inputsFinite = value == value && reference == reference
-                           && value - value == 0 && reference - reference == 0;
-    if (!inputsFinite) {
+    if (!std::isfinite(value) || !std::isfinite(reference)) {
         return false;
     }
     // C4 公式：|value−reference| ≤ relative·|reference| + absolute。
@@ -29,6 +27,18 @@ bool closeWithin(double value, double reference, Tolerance t) noexcept
     const double diff = value - reference;
     const double limit = t.relative * (reference < 0 ? -reference : reference)
                        + t.absolute;
+    // GAP-CORE-C4-01：只有两边同时溢出才失去原判据的排序信息。
+    // 有限 value/reference 的差至多为 2*DBL_MAX，因此共同除以二即可使
+    // 左边可表示。scalbn 是标准的二进制缩放，不放大容差、不改变 C4。
+    // 此时 value/reference 都远离次正规区；右边再溢出则必定覆盖左边。
+    // 正常路径及只有一边溢出的既有 IEEE 舍入行为保留，不承诺精确实数算术。
+    if (std::isinf(diff) && std::isinf(limit)) {
+        const double scaledDiff = std::fabs(std::scalbn(value, -1)
+                                         - std::scalbn(reference, -1));
+        const double scaledLimit = t.relative * std::scalbn(std::fabs(reference), -1)
+                                 + std::scalbn(t.absolute, -1);
+        return scaledDiff <= scaledLimit;
+    }
     return (diff <= limit) && (-diff <= limit);
 }
 

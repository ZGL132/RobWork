+/** 真实 rw::math::Q 必须消费同一修正，不允许下游另补极值判据。 */
+TEST(AllCloseWithinQ, FiniteOverflowBoundary_UT_UNIT)
+{
+    const double m = std::numeric_limits<double>::max();
+    EXPECT_FALSE(allCloseWithin(rw::math::Q(1, m), rw::math::Q(1, -m),
+                               Tolerance::make(1.5, 0.0)));
+    EXPECT_TRUE(allCloseWithin(rw::math::Q(1, m), rw::math::Q(1, -m),
+                              Tolerance::make(2.0, 0.0)));
+}

+/** GAP-CORE-C4-01：有限极值不能因两边同时溢出为 Inf 而静默通过。 */
+TEST(CompareFormula, FiniteOverflowBoundary_UT_UNIT)
+{
+    const double m = std::numeric_limits<double>::max();
+    const double belowTwo = std::nextafter(2.0, 0.0);
+    // 正反方向、阈值两侧和绝对项均保持原 C4，不引入新的 epsilon。
+    for (double sign : {-1.0, 1.0}) {
+        EXPECT_FALSE(closeWithin(sign * m, -sign * m, Tolerance::make(1.5, 0.0)));
+        EXPECT_FALSE(closeWithin(sign * m, -sign * m, Tolerance::make(belowTwo, 0.0)));
+        EXPECT_TRUE(closeWithin(sign * m, -sign * m, Tolerance::make(2.0, 0.0)));
+        EXPECT_FALSE(closeWithin(sign * m, -sign * m, Tolerance::make(0.5, m)));
+        EXPECT_TRUE(closeWithin(sign * m, -sign * m, Tolerance::make(1.0, m)));
+    }
+    // 单侧溢出及相等/零参考：只改变溢出判据，正常路径的边界不变。
+    EXPECT_FALSE(closeWithin(m, -m, Tolerance::make(0.0, m)));
+    EXPECT_TRUE(closeWithin(m, m, Tolerance::make(m, m)));
+    EXPECT_TRUE(closeWithin(m, 0.0, Tolerance::make(0.0, m)));
+    EXPECT_FALSE(allCloseWithin(std::vector<double>{m}, std::vector<double>{-m},
+                               Tolerance::make(1.5, 0.0)));
+}
+
+/** C4 原有次正规及零边界：本包不扩展为任意精度比较或改变正常舍入。 */
+TEST(CompareFormula, SubnormalAndSignedZeroRegression_UT_UNIT)
+{
+    const double tiny = std::numeric_limits<double>::denorm_min();
+    EXPECT_TRUE(closeWithin(-0.0, 0.0, Tolerance::make(0.0, 0.0)));
+    EXPECT_TRUE(closeWithin(tiny, 0.0, Tolerance::make(0.0, tiny)));
+    EXPECT_FALSE(closeWithin(tiny, -tiny, Tolerance::make(0.0, tiny)));
+    EXPECT_TRUE(closeWithin(tiny, -tiny, Tolerance::make(2.0, 0.0)));
+}
+
 /** 正负抵消反例：逐元素判定不被差值总和替代（C4 明文——UT 核心反例）。 */

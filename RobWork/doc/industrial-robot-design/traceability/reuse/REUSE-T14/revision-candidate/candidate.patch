 #include <cmath>
+#include <limits>
 #include <stdexcept>
 #include <string>
 
+// GAP-CORE-C4-01 修订候选 R2 的溢出分支辅助（提案 revision-candidate/candidate.patch）。
+// twoSum：Knuth/Dekker 错误免费变换；ulpBound：保守 ulp 上界；exactSign：精确符号。
+namespace {
+
+inline void irdTwoSum(double a, double b, double& s, double& e) noexcept
+{
+    s = a + b;
+    const double bb = s - a;
+    e = (a - (s - bb)) + (b - bb);
+}
+
+inline double irdUlpBound(double v) noexcept
+{
+    const int e = std::ilogb(v);
+    const double b = std::ldexp(1.0, e - 51);
+    return b > 0.0 ? b : std::numeric_limits<double>::denorm_min();
+}
+
+int irdExactSign(double* t, int n) noexcept
+{
+    for (int iter = 0; iter < 256; ++iter) {
+        int mi = 0;
+        for (int i = 1; i < n; ++i) {
+            if (std::fabs(t[i]) > std::fabs(t[mi])) {
+                mi = i;
+            }
+        }
+        if (t[mi] == 0.0) {
+            return 0;
+        }
+        double rest = 0.0;
+        for (int i = 0; i < n; ++i) {
+            if (i != mi) {
+                rest += std::fabs(t[i]);
+            }
+        }
+        if (rest == 0.0) {
+            return t[mi] > 0.0 ? 1 : -1;
+        }
+        const double bound = rest + 8.0 * irdUlpBound(rest)
+                           + irdUlpBound(std::fabs(t[mi]));
+        if (std::fabs(t[mi]) > bound) {
+            return t[mi] > 0.0 ? 1 : -1;
+        }
+        int mj = -1;
+        double best = 0.0;
+        for (int i = 0; i < n; ++i) {
+            if (i != mi) {
+                const double a = std::fabs(t[i]);
+                if (a > best) {
+                    best = a;
+                    mj = i;
+                }
+            }
+        }
+        double s = 0.0, e = 0.0;
+        irdTwoSum(t[mi], t[mj], s, e);
+        t[mi] = s;
+        t[mj] = e;
+    }
+    // 不可达：量子耗尽论证（见 GAP-CORE-C4-01 修订提案引理4）给出 ≤~60 轮上界，
+    // 256 轮上限含 4 倍余量；实验 29,072 组最大实测 5 轮。按 fail-fast 取 false，
+    // 若该不可达路径被触发将以可见的误拒暴露，而不是静默误绿。
+    return -1;
+}
+
+}  // namespace

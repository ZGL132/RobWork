target_compile_features(sdurws_ird_diagnostics_test PRIVATE cxx_std_17)
set_target_properties(sdurws_ird_diagnostics_test PROPERTIES
    CXX_STANDARD 17
    CXX_STANDARD_REQUIRED ON

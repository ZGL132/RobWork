{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "https://robwork.github.io/ird/schemas/analysis-snapshot.schema.json",
  "title": "AnalysisSnapshot",
  "description": "一次运行的不可变输入集合（SYM-EVI-003，CTR-EXE-002）。字段来源：architecture/public-interfaces.md §7、requirements.md §7.1。快照必须自足：所有输入对象修订、分析配置、评估器与 RobWork/RobWorkSim 版本、随机种子、依赖清单、完整已解析 EngineeringPolicySet 内容身份与 RuntimeNameMap 身份。运行时不得补默认值。",
  "type": "object",
  "properties": {
    "snapshotId": {
      "description": "快照稳定 ID。",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sourceRevision": {
      "description": "SourceRevisionRef：结果溯源到的项目修订，只用于展示与追溯，不参与缓存/当前性判定。",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "branchId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
        }
      },
      "required": ["projectId", "branchId", "revisionId"],
      "additionalProperties": false
    },
    "objectRevisions": {
      "description": "全部输入对象修订（模型、需求、策略、配置等）。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "objectRevision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["objectId", "objectRevision"],
        "additionalProperties": false
      }
    },
    "config": {
      "description": "AnalysisConfiguration（注意规范名不是 AnalysisConfig，SYM 命名裁决 #8）：持久化工程设置的身份引用；设置对象本身经 objectRevisions 纳入快照。",
      "type": "object",
      "properties": {
        "analysisConfigurationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "contentDigest": {
          "description": "配置规范化内容的 SHA-256。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["analysisConfigurationId", "contentDigest"],
      "additionalProperties": false
    },
    "evaluator": {
      "description": "评估器身份与版本。",
      "type": "object",
      "properties": {
        "evaluatorId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "evaluatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": ["evaluatorId", "evaluatorVersion"],
      "additionalProperties": false
    },
    "robWorkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "robWorkSimVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "randomSeed": {
      "description": "随机种子（非负整数）；固定种子保证并行复现。",
      "type": "integer",
      "minimum": 0
    },
    "threadCount": {
      "description": "线程数；进入缓存键。",
      "type": "integer",
      "minimum": 1
    },
    "manifest": {
      "description": "EvaluatorDependencyManifest（SYM-EVI-001）：缓存键必须覆盖全部声明依赖。",
      "type": "object",
      "properties": {
        "requiredFields": {
          "description": "依赖的领域字段路径。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\[[0-9]+\\])?(\\.[A-Za-z][A-Za-z0-9_]*(\\[[0-9]+\\])?)*$"
          }
        },
        "requiredResources": {
          "description": "网格、目录、物性等资源的内容 ID（SHA-256）。",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "requiredUpstreamArtifacts": {
          "description": "上游结果引用（ResultRef；如 TrajectoryPlan 引用 KinematicResult）。",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "attemptId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "evaluatorId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "payloadId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": ["runId", "attemptId", "evaluatorId", "payloadId"],
            "additionalProperties": false
          }
        },
        "optionalEvidence": {
          "description": "不影响判定但进入报告的证据项。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": ["requiredFields", "requiredResources", "requiredUpstreamArtifacts"],
      "additionalProperties": false
    },
    "resolvedPolicyContentId": {
      "description": "完整已解析 EngineeringPolicySet 的内容 ID；评估时不得叠加私有默认值。",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nameMapId": {
      "description": "RuntimeNameMap 稳定 ID（等于 runtime-name-map.objectId）。",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": ["snapshotId", "schemaVersion", "createdAt", "sourceRevision", "objectRevisions", "config", "evaluator", "robWorkVersion", "robWorkSimVersion", "randomSeed", "threadCount", "manifest", "resolvedPolicyContentId", "nameMapId"],
  "additionalProperties": false
}
